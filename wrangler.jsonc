{
  // Cloudflare Worker config. This project now ships real server code for
  // the Blog Admin Panel (previously this was a pure static-assets Worker —
  // see git history for that version if you ever need to revert).
  "name": "taqwa",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Generated by `@astrojs/cloudflare` when built with CLOUDFLARE_WORKERS=1
  // (see astro.config.mjs). If a future adapter version changes this output
  // path, `npx wrangler deploy` will fail with a clear "module not found"
  // error naming the path it expected — update this line to match.
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Blog Admin Panel database. Create it once with:
  //   npx wrangler d1 create taqwa-blog
  // then replace database_id below with the id that command prints, and
  // apply migrations/0001_init.sql (see ADMIN.md for exact commands).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taqwa-blog",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
  // Secrets (never listed here — set with `npx wrangler secret put <NAME>`):
  //   ADMIN_PASSWORD          the login password for /admin
  //   ADMIN_SESSION_SECRET    a long random string used to sign session cookies
  // See ADMIN.md for the exact setup commands.
}
