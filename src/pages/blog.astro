  if (loadMoreBtn && extraPosts) {
    loadMoreBtn.addEventListener('click', function(){
      var isShown = extraPosts.classList.toggle('show');
      loadMoreBtn.classList.toggle('expanded', isShown);
      if (loadMoreLabel) loadMoreLabel.textContent = isShown ? 'Show Less' : 'Load More Articles';
      if(!isShown){
        loadMoreBtn.scrollIntoView({behavior:'smooth', block:'center'});
      }
    });
  }
</script>
</Layout>
