---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Blog - Taqwa Automobile Service Center"
  description="Car care tips, LPG & CNG conversion advice, hybrid maintenance guides and news from Taqwa Automobile Service Center in Uttara, Dhaka."
  path="blog.html"
  current="blog"
>

<style>

/* ===== SCROLL-REVEAL MICRO-ANIMATIONS ===== */
  @keyframes fadeInUp{
    from{opacity:0; transform:translateY(28px);}
    to{opacity:1; transform:translateY(0);}
  }
  @keyframes floatBounce{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-6px);}
  }
  @keyframes shimmer{
    0%{background-position:100% 0;}
    100%{background-position:0 0;}
  }

/* ===== STICKY FLOATING WHATSAPP / CALL BUTTONS ===== */

@keyframes pulseRing{
    0%{box-shadow:0 0 0 0 rgba(22,163,74,0.45);}
    70%{box-shadow:0 0 0 14px rgba(22,163,74,0);}
    100%{box-shadow:0 0 0 0 rgba(22,163,74,0);}
  }

/* ===== PAGE BANNER ===== */
  .page-banner{
    position:relative;
    background:linear-gradient(150deg, var(--charcoal-2) 0%, var(--charcoal) 100%);
    overflow:hidden;
    padding:var(--space-8) var(--space-6) 58px;
    text-align:center;
  }
  .page-banner::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 70% 70% at 50% 40%, black, transparent);
    pointer-events:none;
  }
  .page-banner-inner{position:relative; max-width:1280px; margin:0 auto;}
  .page-banner .eyebrow{justify-content:center; display:flex;}
  .page-banner h1{
    font-size:var(--text-5xl); color:#fff; letter-spacing:0.4px; margin-bottom:16px;
  }
  .page-banner h1 .accent{color:var(--red);}
  .page-banner-inner > p{color:var(--off); font-size:var(--text-base); line-height:1.75; max-width:620px; margin:0 auto 20px;}
  .breadcrumb{
    display:flex; justify-content:center; align-items:center; gap:10px;
    font-size:16px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px;
    font-weight:700;
  }
  .breadcrumb a{color:var(--off);}
  .breadcrumb a:hover{color:var(--red);}
  .breadcrumb .sep{color:var(--red); font-size:16px;}
  .breadcrumb .current{color:var(--red);}

  @media (max-width:760px){
    .page-banner{padding:var(--space-7) var(--space-5) 40px;}
    .page-banner h1{font-size:var(--text-3xl);}
  }
  @media (max-width:420px){
    .page-banner{padding:36px 16px 32px;}
    .breadcrumb{font-size:16px;}
  }

  /* ===== BLOG PAGE ===== */
  .blog-section{background:var(--surface-1); padding:60px 32px;}
  .blog-layout{
    max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:2fr 1fr; gap:48px; align-items:start;
  }

  .blog-grid{display:grid; grid-template-columns:repeat(2, 1fr); gap:28px;}
  .extra-posts{display:none;}
  .extra-posts.show{display:contents;}

  .blog-card{
    background:#fff; border-radius:var(--radius-lg); overflow:hidden;
    box-shadow:var(--shadow-3);
    display:flex; flex-direction:column;
  }
  .blog-card-image{position:relative; aspect-ratio:16/10.5; overflow:hidden; flex-shrink:0;}
  .blog-card-image img{width:100%; height:100%; object-fit:cover; display:block;}
  .blog-card-cat{
    position:absolute; left:14px; top:14px; z-index:1;
    background:var(--red); color:#fff; font-size:16px; font-weight:800;
    text-transform:uppercase; letter-spacing:0.4px; padding:6px 12px; border-radius:var(--radius-sm);
  }
  .blog-card-body{padding:22px 22px 24px; display:flex; flex-direction:column; flex:1;}
  .blog-card-date{
    color:var(--muted); font-size:16px; font-weight:700; text-transform:uppercase;
    letter-spacing:0.3px; margin-bottom:10px; display:flex; align-items:center; gap:6px;
  }
  .blog-card-body h3{font-size:16px; color:var(--text-strong); line-height:1.35; margin-bottom:10px;}
  .blog-card-body p{color:var(--text-muted); font-size:16px; line-height:1.7; margin-bottom:16px; flex:1;}
  .blog-read-more{
    color:var(--red); font-size:16px; font-weight:800; letter-spacing:0.4px;
    text-transform:uppercase; display:inline-flex; align-items:center; gap:6px;
  }
  .blog-read-more:hover{color:var(--red-dark);}
  .blog-read-more svg{width:14px; height:14px; transition:transform .2s ease;}
  .blog-read-more:hover svg{transform:translateX(4px);}

  .blog-loadmore-wrap{text-align:center; margin-top:40px;}
  .load-more-btn{
    display:inline-flex; align-items:center; gap:10px;
    background:var(--charcoal); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.5px; text-transform:uppercase; padding:14px 30px; border-radius:var(--radius-sm);
  }
  .load-more-btn:hover{background:var(--red);}
  .load-more-btn .chev{transition:transform .2s ease;}
  .load-more-btn.expanded .chev{transform:rotate(180deg);}

  /* ---- sidebar ---- */
  .blog-sidebar{display:flex; flex-direction:column; gap:26px;}
  .sidebar-widget{
    background:#fff; border-radius:var(--radius-lg); padding:26px 24px;
    box-shadow:var(--shadow-3);
  }
  .sidebar-widget h4{
    font-size:16px; color:var(--text-strong); text-transform:uppercase; letter-spacing:0.4px;
    margin-bottom:18px; padding-bottom:14px; position:relative;
  }
  .sidebar-widget h4::after{
    content:""; position:absolute; left:0; bottom:0; width:36px; height:3px;
    background:var(--red); border-radius:var(--radius-sm);
  }

  .search-box{display:flex; border:1.5px solid var(--surface-border); border-radius:var(--radius-md); overflow:hidden;}
  .search-box input{
    flex:1; border:none; padding:12px 14px; font-size:16px; font-family:inherit; color:var(--text-strong);
  }
  .search-box input:focus{outline:none;}
  .search-box button{
    background:var(--red); color:#fff; padding:0 16px; display:flex;
    align-items:center; justify-content:center; flex-shrink:0;
  }
  .search-box button:hover{background:var(--red-dark);}

  .cat-list li{
    display:flex; justify-content:space-between; align-items:center;
    padding:11px 0; border-bottom:1px solid var(--surface-border); font-size:16px;
  }
  .cat-list li:last-child{border-bottom:none; padding-bottom:0;}
  .cat-list li a{color:#555;}
  .cat-list li a:hover{color:var(--red);}
  .cat-list li span{
    color:var(--red); font-weight:800; font-size:16px;
    background:var(--surface-2); padding:2px 9px; border-radius:20px;
  }

  .recent-post{display:flex; gap:12px; padding:12px 0; border-bottom:1px solid var(--surface-border);}
  .recent-post:first-child{padding-top:0;}
  .recent-post:last-child{border-bottom:none; padding-bottom:0;}
  .recent-post img{
    width:64px; height:64px; border-radius:var(--radius-md); object-fit:cover; flex-shrink:0;
  }
  .recent-post-info h5{font-size:16px; color:var(--text-strong); line-height:1.4; margin-bottom:6px; font-weight:700;}
  .recent-post-info span{font-size:16px; color:var(--muted);}

  .tag-list{display:flex; flex-wrap:wrap; gap:8px;}
  .tag-list a{
    background:var(--surface-2); color:#555; font-size:16px; font-weight:700;
    padding:8px 14px; border-radius:20px;
  }
  .tag-list a:hover{background:var(--red); color:#fff;}

  .sidebar-cta{
    background:linear-gradient(150deg, var(--red) 0%, var(--red-dark) 100%);
    border-radius:var(--radius-lg); padding:28px 22px; text-align:center; color:#fff;
  }
  .sidebar-cta h4{color:#fff; font-size:16px; margin-bottom:8px; border:none; padding:0;}
  .sidebar-cta h4::after{display:none;}
  .sidebar-cta p{font-size:16px; color:rgba(255,255,255,0.85); margin-bottom:18px; line-height:1.65;}
  .sidebar-cta a{
    background:#fff; color:var(--red); font-size:16px; font-weight:800;
    text-transform:uppercase; padding:12px; border-radius:var(--radius-sm); display:block; letter-spacing:0.4px;
  }
  .sidebar-cta a:hover{background:#F3EFE3;}

  @media (max-width:980px){
    .blog-layout{grid-template-columns:1fr;}
    .blog-sidebar{
      display:grid; grid-template-columns:repeat(2, 1fr); gap:22px;
    }
  }
  @media (max-width:760px){
    .blog-section{padding:44px 20px;}
    .blog-grid{grid-template-columns:1fr; gap:22px;}
  }
  @media (max-width:600px){
    .blog-sidebar{grid-template-columns:1fr;}
  }
</style>

<section class="page-banner">
  <div class="page-banner-inner">
    <div class="eyebrow reveal">TIPS &amp; UPDATES</div>
    <h1 class="display reveal">OUR <span class="accent">BLOG</span></h1>
    <p class="reveal">Practical advice on LPG &amp; CNG conversion, hybrid care, maintenance and more — written by the technicians who service your car.</p>
    <div class="breadcrumb reveal">
      <a href="index.html">Home</a>
      <span class="sep">»</span>
      <span class="current">Blog</span>
    </div>
  </div>
</section>

<section class="blog-section">
  <div class="blog-layout">

    <div class="blog-main">
      <div class="blog-grid" id="blogGrid">

        <div class="blog-card">
          <div class="blog-card-image">
            <span class="blog-card-cat">LPG &amp; CNG</span>
            <img src={base + "img/latest-1.jpg"} alt="LPG vs CNG: Which Conversion Is Right for Your Car?">
          </div>
          <div class="blog-card-body">
            <div class="blog-card-date">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
              August 15, 2026
            </div>
            <h3>LPG vs CNG: Which Conversion Is Right for Your Car?</h3>
            <p>Both fuels can cut your running costs, but they suit different driving habits and vehicle types. Here's how to decide which conversion makes sense for you.</p>
            <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="blog-card">
          <div class="blog-card-image">
            <span class="blog-card-cat">Maintenance</span>
            <img src={base + "img/latest-2.jpg"} alt="5 Signs Your Car Needs an Oil Change Now">
          </div>
          <div class="blog-card-body">
            <div class="blog-card-date">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
              August 8, 2026
            </div>
            <h3>5 Signs Your Car Needs an Oil Change Now</h3>
            <p>Skipping an oil change can quietly wear down your engine. Watch for these five warning signs before real damage sets in.</p>
            <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="blog-card">
          <div class="blog-card-image">
            <span class="blog-card-cat">Hybrid Tips</span>
            <img src={base + "img/latest-3.jpg"} alt="How to Extend the Life of Your Hybrid Battery">
          </div>
          <div class="blog-card-body">
            <div class="blog-card-date">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
              July 29, 2026
            </div>
            <h3>How to Extend the Life of Your Hybrid Battery</h3>
            <p>Hybrid batteries are built to last, but a few driving and charging habits can add years to their lifespan.</p>
            <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="blog-card">
          <div class="blog-card-image">
            <span class="blog-card-cat">Car Care</span>
            <img src={base + "img/evn-1.jpg"} alt="Why Regular AC Service Matters Before Summer">
          </div>
          <div class="blog-card-body">
            <div class="blog-card-date">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
              July 20, 2026
            </div>
            <h3>Why Regular AC Service Matters Before Summer</h3>
            <p>A weak or noisy AC usually signals a bigger issue underneath. Here's what a proper AC service checks and why timing matters.</p>
            <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="blog-card">
          <div class="blog-card-image">
            <span class="blog-card-cat">Hybrid Tips</span>
            <img src={base + "img/hybrid-car.jpg"} alt="Common Myths About Hybrid Cars Debunked">
          </div>
          <div class="blog-card-body">
            <div class="blog-card-date">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
              July 12, 2026
            </div>
            <h3>Common Myths About Hybrid Cars Debunked</h3>
            <p>From "the battery always needs replacing early" to "hybrids can't handle heavy traffic" &mdash; we separate fact from fiction.</p>
            <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="blog-card">
          <div class="blog-card-image">
            <span class="blog-card-cat">Car Care</span>
            <img src={base + "img/car-wash.jpg"} alt="The Right Way to Wash Your Car Without Damaging the Paint">
          </div>
          <div class="blog-card-body">
            <div class="blog-card-date">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
              July 3, 2026
            </div>
            <h3>The Right Way to Wash Your Car Without Damaging the Paint</h3>
            <p>Wrong soap, wrong cloth, wrong technique &mdash; small mistakes at the wash bay can dull your paint over time. Here's how to do it right.</p>
            <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="extra-posts" id="extraPosts">

          <div class="blog-card">
            <div class="blog-card-image">
              <span class="blog-card-cat">LPG &amp; CNG</span>
              <img src={base + "img/lpg.jpg"} alt="Is LPG Conversion Safe for Older Vehicles?">
            </div>
            <div class="blog-card-body">
              <div class="blog-card-date">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
                June 24, 2026
              </div>
              <h3>Is LPG Conversion Safe for Older Vehicles?</h3>
              <p>Age alone isn't the deciding factor &mdash; engine condition and kit quality matter more. Here's what we check before recommending conversion.</p>
              <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>

          <div class="blog-card">
            <div class="blog-card-image">
              <span class="blog-card-cat">Maintenance</span>
              <img src={base + "img/evn-2.jpg"} alt="Oil & Filter Change: How Often Is Too Often?">
            </div>
            <div class="blog-card-body">
              <div class="blog-card-date">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
                June 15, 2026
              </div>
              <h3>Oil &amp; Filter Change: How Often Is Too Often?</h3>
              <p>More frequent isn't always better. We break down the right interval based on oil type, driving conditions and mileage.</p>
              <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>

          <div class="blog-card">
            <div class="blog-card-image">
              <span class="blog-card-cat">News</span>
              <img src={base + "img/Expert-Technicians.jpg"} alt="Meet the Team Behind Taqwa Automobile's Service Quality">
            </div>
            <div class="blog-card-body">
              <div class="blog-card-date">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="#9A9AA0" stroke-width="1.6"/><line x1="3" y1="9" x2="21" y2="9" stroke="#9A9AA0" stroke-width="1.4"/><line x1="8" y1="3" x2="8" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="3" x2="16" y2="7" stroke="#9A9AA0" stroke-width="1.4" stroke-linecap="round"/></svg>
                June 5, 2026
              </div>
              <h3>Meet the Team Behind Taqwa Automobile's Service Quality</h3>
              <p>A closer look at the technicians, advisors and specialists who keep every job at our workshop up to standard.</p>
              <a class="blog-read-more" aria-disabled="true" tabindex="-1">Read More
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>

          <div class="blog-card">
            <div class="blog-card-image">
              <span class="blog-card-cat">LPG &amp; CNG</span>
              <img src={base + "img/lpg-and-cng.jpg"} alt="CNG vs Petrol: A Real Cost Comparison for Dhaka Drivers">
            </div>
