---
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, getRecentPosts, formatDisplayDate } from '../../lib/blog-data';
import { getPostBySlug } from '../../lib/blog-db';
import { ensureTranslation, otherLanguage, canTranslate } from '../../lib/translate';
import { readingLanguage, withLanguage } from '../../lib/reading-language';
import { blogText } from '../../lib/blog-ui-text';
import { listTranslationsForPosts } from '../../lib/blog-db';
import { postUrl } from '../../lib/post-url';
import { IS_CLOUDFLARE_BUILD } from '../../lib/runtime-flag';
import blogSnapshot from '../../lib/blog-snapshot.json';
import type { PublicPost } from '../../lib/blog-data';

export const prerender = false;

const base = import.meta.env.BASE_URL;
const runtimeDb = Astro.locals.runtime?.env.DB ?? null;
const { slug } = Astro.params;

// Prerender paths for static builds
export function getStaticPaths() {
  if (IS_CLOUDFLARE_BUILD) return [];
  return blogSnapshot.posts
    .filter((p) => p.status === 'published')
    .map((p) => ({ params: { slug: p.slug } }));
}

// Fetch only the post we need by slug (not all posts)
let post: PublicPost | null = null;

// Try D1 first if available
if (slug && runtimeDb) {
  try {
    const dbPost = await getPostBySlug(runtimeDb, slug);
    if (dbPost) {
      // Convert D1 post to PublicPost (inline fromD1 conversion)
      post = {
        id: dbPost.id,
        title: dbPost.title,
        slug: dbPost.slug,
        categoryName: dbPost.category_name,
        categorySlug: dbPost.category_slug,
        featuredImage: dbPost.featured_image,
        excerpt: dbPost.excerpt,
        content: dbPost.content,
        author: dbPost.author,
        tags: dbPost.tags ? dbPost.tags.split(',').map((t) => t.trim()).filter(Boolean) : [],
        original_language: dbPost.original_language,
        publishDate: dbPost.publish_date,
        seoTitle: dbPost.seo_title,
        seoDescription: dbPost.seo_description,
      };
    }
  } catch (err) {
    console.error('Failed to fetch post from D1:', err);
  }
}

// Fallback to snapshot if D1 fails or post not found
if (!post && slug) {
  const snapshotPosts = await getPublishedPosts(null);
  post = snapshotPosts.find(p => p.slug === slug) || null;
}

if (!post) {
  return Astro.redirect(`${base}blog.html`, 302);
}

// ===== Bilingual reading =====
// Every post is offered in both languages. The other language is translated
// once on the first request for it and stored (see src/lib/translate.ts), so
// this costs one API call per post, ever - and the admin can edit the result.
//
// The toggle used to be gated on `?lang=` already differing from the post's own
// language, which meant it could never appear on the post as written - a reader
// had no way to reach the translation at all. It is now offered in both
// directions, whenever a translation exists or can be made.
const otherLang = otherLanguage(post.original_language);
const translateEnv = Astro.locals.runtime?.env;
// An explicit ?lang= is remembered for the visit, so switching here carries to
// the next post the reader opens instead of dropping back to the original.
const readingLang = readingLanguage(Astro, post.original_language);
const wantsOtherLanguage = readingLang === otherLang;
/** Carries the reading language on the links out of this page. */
const withLang = (href: string) => withLanguage(href, readingLang);
// The blog's own wording, in the language being read (see blog-ui-text.ts).
const T = blogText(readingLang);

let displayPost = post;
let currentBlogLanguage = post.original_language;
let showLanguageToggle = false;

// Show language toggle if translation is possible (independent of post.id or runtimeDb)
if (canTranslate(translateEnv)) {
  showLanguageToggle = true;
}

// Parallelize translation check and related posts fetching
const translationCheckPromise = (async () => {
  if (post.id && runtimeDb) {
    try {
      if (wantsOtherLanguage) {
        // User requested other language via ?lang parameter
        const translated = await ensureTranslation(runtimeDb, translateEnv, post, otherLang);
        if (translated) {
          displayPost = translated;
          currentBlogLanguage = otherLang;
        }
      } else {
        // Reading the original: check if cached translation exists (with null env to avoid auto-translation)
        const stored = await ensureTranslation(runtimeDb, null, post, otherLang);
        // showLanguageToggle already set above based on canTranslate
      }
    } catch (err) {
      // A failed or unconfigured translation must never break the post - the
      // reader just gets it in the language it was written in.
      console.error('Translation failed:', err);
    }
  }
})();

const recentPostsPromise = runtimeDb ? getRecentPosts(runtimeDb, 5) : Promise.resolve([]);

// Wait for both in parallel
const [_, recentPostsList] = await Promise.all([translationCheckPromise, recentPostsPromise]);

// Both language versions live at the same path and differ only by ?lang=, so
// tell search engines they are alternates of each other rather than duplicates.
// `path` is relative here for the same reason the `path` prop is - Layout is
// the one place that knows the site's absolute URL.
const alternates = showLanguageToggle
  ? [
      { hreflang: post.original_language, path: `blog/${slug}` },
      { hreflang: otherLang, path: `blog/${slug}?lang=${otherLang}` },
    ]
  : [];

const related = recentPostsList
  .filter((p) => p.slug !== post.slug)
  .slice(0, 4);

// The cards below carried each post's own title regardless of the language
// being read, so a reader in Bangla got a row of half-translated cards. One
// query covers all four rather than one lookup per card.
const relatedIds = related
  .map((r) => r.id)
  .filter((id): id is number => typeof id === 'number');
const relatedTranslations = runtimeDb
  ? new Map(
      (await listTranslationsForPosts(runtimeDb, relatedIds))
        .filter((t) => t.language === readingLang)
        .map((t) => [t.post_id, t])
    )
  : new Map();
const relatedCards = related.map((r) => {
  if (r.original_language === readingLang || r.id === null) return r;
  const t = relatedTranslations.get(r.id);
  return t ? { ...r, title: t.title } : r;
});

const description = displayPost.seoDescription || displayPost.excerpt;
---

<Layout
  title={`${displayPost.seoTitle || displayPost.title} - Taqwa Automobile Service Center`}
  description={description}
  path={`blog/${slug}`}
  isBlog={true}
  ogImage={base + displayPost.featuredImage}
  current="blog"
  showBlogLanguageToggle={showLanguageToggle}
  currentBlogLanguage={currentBlogLanguage}
  alternates={alternates}
>

<style>
  .page-banner{
    position:relative;
    background:linear-gradient(150deg, var(--charcoal-2) 0%, var(--charcoal) 100%);
    overflow:hidden;
    padding:var(--space-8) var(--space-6) 58px;
    text-align:center;
  }
  .page-banner::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 70% 70% at 50% 40%, black, transparent);
    pointer-events:none;
  }
  .page-banner-inner{position:relative; max-width:900px; margin:0 auto;}
  .page-banner .post-cat{
    color:var(--red); font-size:16px; font-weight:800; letter-spacing:3px; text-transform:uppercase;
    margin-bottom:16px; display:block;
  }
  .page-banner h1{font-size:var(--text-5xl); color:#fff; letter-spacing:0.4px; margin-bottom:16px; line-height:1.25;}
  .post-meta{
    display:flex; justify-content:center; align-items:center; gap:18px; flex-wrap:wrap;
    color:var(--muted); font-size:16px; font-weight:700; text-transform:uppercase; letter-spacing:0.3px;
  }

  .article-section{background:var(--surface-1); padding:var(--space-8) var(--space-6);}
  .article-inner{max-width:820px; margin:0 auto;}
  .article-image{border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-4); margin-bottom:var(--space-6); aspect-ratio:16/9;}
  .article-image img{width:100%; height:100%; object-fit:cover; display:block;}
  .article-body{
    background:#fff; border-radius:var(--radius-lg); padding:40px 44px; box-shadow:var(--shadow-3);
    color:var(--text-strong); font-size:var(--text-base); line-height:1.85;
  }
  .article-body p{margin-bottom:1.1em;}
  .article-body h2{font-size:var(--text-3xl); margin:1.3em 0 .5em; color:var(--text-strong);}
  .article-body h3{font-size:var(--text-2xl); margin:1.1em 0 .5em; color:var(--text-strong);}
  .article-body ul, .article-body ol{margin:0 0 1.1em; padding-left:1.4em;}
  .article-body a{color:var(--red); text-decoration:underline;}

  .related-section{background:var(--surface-0); padding:var(--space-8) var(--space-6);}
  .related-inner{max-width:1000px; margin:0 auto;}
  .related-inner h2{font-size:var(--text-3xl); color:var(--text-strong); text-align:center; margin-bottom:32px;}
  .related-grid{display:grid; grid-template-columns:repeat(2, 1fr); gap:24px;}
  .related-card{background:#fff; border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-3); display:flex; flex-direction:column;}
  .related-card img{width:100%; aspect-ratio:16/10; object-fit:cover; display:block;}
  .related-card .rc-body{padding:18px 20px 20px;}
  .related-card h4{font-size:16px; color:var(--text-strong); line-height:1.35; margin-bottom:8px;}
  .related-card .rc-date{color:var(--text-muted); font-size:16px;}

  @media (max-width:760px){
    .page-banner h1{font-size:var(--text-3xl);}
    .article-body{padding:28px 24px;}
    .related-grid{grid-template-columns:1fr;}
  }
</style>

<section class="page-banner">
  <div class="page-banner-inner">
    <span class="post-cat">{displayPost.categoryName}</span>
    <h1 class="display">{displayPost.title}</h1>
    <div class="post-meta">
      <span>{formatDisplayDate(displayPost.publishDate, readingLang)}</span>
      <span>&middot;</span>
      <span>{T.byAuthor} {displayPost.author}</span>
    </div>
  </div>
</section>

<section class="article-section">
  <div class="article-inner">
    <div class="article-image">
      <img src={base + displayPost.featuredImage} alt={displayPost.title}>
    </div>
    <div class="article-body" set:html={displayPost.content} />
  </div>
</section>

{related.length > 0 && (
  <section class="related-section">
    <div class="related-inner">
      <h2 class="display">{T.relatedLead} <span style="color:var(--red);">{T.relatedAccent}</span></h2>
      <div class="related-grid">
        {relatedCards.map((r) => (
          <a class="related-card" href={withLang(base + postUrl(r.slug))}>
            <img src={base + r.featuredImage} alt={r.title} loading="lazy">
            <div class="rc-body">
              <h4>{r.title}</h4>
              <div class="rc-date">{formatDisplayDate(r.publishDate, readingLang)}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- The language button and its handler both live in Header.astro. -->

</Layout>
