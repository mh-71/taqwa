---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="LPG Conversion Service | Taqwa Automobile Service Center"
  description="Certified LPG conversion in Uttara, Dhaka. Safety-tested cylinder installation, genuine kits, ECU tuning and warranty at Taqwa Automobile Service Center."
  path="lpg-conversion.html"
  current="services"
>

<style define:vars={{ heroBg: `url(${base}img/hero-background.jpg)` }}>
  /* This page's own :root{...} token block was removed here: Astro scopes
     component <style> blocks to the elements that component's own template
     renders, and :root (<html>) is never one of them, so this redeclaration
     was already inert — global.css's :root (loaded on every page) was the
     only one ever actually applying. */
  body{
    font-family: 'Inter', "Segoe UI", Arial, sans-serif;
    background:var(--paper);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
  }
  .display{
    font-family: 'Poppins', "Arial Narrow", Arial, sans-serif;
    font-weight:800;
    letter-spacing:0.5px;
    text-transform:uppercase;
  }

button{font-family:inherit; cursor:pointer; border:none; background:none;}
  img{max-width:100%; display:block;}

  /* ===== HEADER (shared with site) ===== */
  header{
    background:var(--paper);
    border-bottom:1px solid #EAEDF2;
    position:sticky; top:0; z-index:50;
  }

nav.main-nav{display:flex; align-items:center; gap:30px;}
  nav.main-nav > ul{display:flex; align-items:center; gap:26px;}
  nav.main-nav a{
    font-size:16px; font-weight:700; letter-spacing:0.4px;
    color:var(--ink); text-transform:uppercase; position:relative; padding:6px 0;
    display:flex; align-items:center; gap:4px;
  }

.dropdown-menu{
    position:absolute; top:100%; left:-18px; margin-top:14px;
    background:#F8FAFC; min-width:220px; border-radius:4px;
    box-shadow:0 18px 40px -12px rgba(0,0,0,0.25); border:1px solid #EAEDF2;
    padding:8px; opacity:0; visibility:hidden; transform:translateY(6px);
    transition:opacity .15s ease, transform .15s ease, visibility .15s;
    z-index:60;
  }
  
  .dropdown-menu::before{
    content:""; position:absolute; top:-6px; left:28px;
    width:12px; height:12px; background:#F8FAFC; border-left:1px solid #EAEDF2; border-top:1px solid #EAEDF2;
    transform:rotate(45deg);
  }
  
  .dropdown-menu a{
    display:block; padding:10px 12px; font-size:16px; font-weight:700;
    text-transform:none; letter-spacing:0.2px; color:var(--ink);
    border-radius:3px; white-space:nowrap;
  }
  .dropdown-menu a:hover{background:#EEF1F6; color:var(--red);}
  .dropdown-menu li.current a{color:var(--red);}

  .call-btn{
    background:var(--red); color:#fff; font-size:16px; font-weight:700;
    letter-spacing:0.4px; padding:11px 22px; border-radius:3px;
    display:flex; align-items:center; gap:8px; text-transform:uppercase;
    white-space:nowrap;
  }

.hamburger span{
    width:24px; height:2px; background:var(--charcoal); display:block;
    transition:transform .2s ease, opacity .2s ease;
  }

/* ===== MOBILE NAV DRAWER ===== */
  .mobile-nav{display:none; background:#F8FAFC; border-top:1px solid #EAEDF2;}

.mobile-nav > ul > li > a{
    display:flex; align-items:center; padding:14px 2px;
    font-size:16px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase;
    color:var(--ink);
  }
  
  .mobile-sub-toggle{
    display:flex; align-items:center; justify-content:space-between; width:100%;
    background:none; text-align:left; padding:14px 2px;
    font-size:16px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase;
    color:var(--ink); font-family:inherit;
  }

.mobile-submenu li.current a{color:var(--red);}

@media (max-width:980px){
    nav.main-nav > ul{display:none;}
    .hamburger{display:flex;}
    .call-btn{display:none;}
  }

a:focus-visible, button:focus-visible{outline:2px solid var(--red); outline-offset:2px;}

  /* ===== BREADCRUMB ===== */
  .breadcrumb{background:#EFF2F6; border-bottom:1px solid #E2E7ED; padding:14px 32px;}
  .breadcrumb-inner{
    max-width:1280px; margin:0 auto; display:flex; align-items:center; gap:8px;
    font-size:16px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase; color:#5a5a5e;
  }
  .breadcrumb-inner a:hover{color:var(--red);}
  .breadcrumb-inner .sep{color:#9A9AA0;}
  .breadcrumb-inner .current{color:var(--red);}

  /* ===== SERVICE HERO ===== */
  .svc-hero{
    position:relative;
    background:
      linear-gradient(rgba(16,19,24,0.72), rgba(16,19,24,0.82)),
      var(--heroBg) center/cover no-repeat;
    overflow:hidden;
    padding:56px 32px 48px;
  }
  .svc-hero::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 70% 60% at 30% 40%, black, transparent);
    pointer-events:none;
  }
  .svc-hero-inner{
    position:relative; max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:1.15fr 0.85fr; gap:48px; align-items:start;
  }
  
  .svc-hero h1{font-size:46px; line-height:1.1; color:#fff; margin-bottom:16px;}
  .svc-hero h1 .accent{color:var(--red);}
  .svc-hero-sub{
    font-family:'Poppins', "Arial Narrow", Arial, sans-serif; font-weight:700;
    letter-spacing:1.5px; text-transform:uppercase; color:var(--off);
    font-size:16px; margin-bottom:18px;
  }
  .svc-hero p{color:var(--muted); font-size:16px; line-height:1.75; max-width:480px; margin-bottom:28px;}
  .svc-hero-actions{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:34px;}
  .btn{
    display:flex; align-items:center; gap:9px; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px 26px; border-radius:3px;
  }

.btn-outline{background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,0.5);}
  .btn-outline:hover{border-color:var(--red); color:var(--red);}

  .svc-feature-strip{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:22px 20px;
    padding-top:24px; border-top:1px solid rgba(255,255,255,0.08);
  }
  .svc-feature-strip .item{
    display:flex; align-items:center; gap:10px; font-size:16px; font-weight:700;
    color:var(--off); text-transform:uppercase; letter-spacing:0.3px;
  }
  .svc-feature-strip svg{flex-shrink:0;}

  /* ===== QUICK-FACTS CARD ===== */
  .specialist-card{
    background:var(--charcoal); border:1.5px solid var(--red); border-radius:4px;
    position:relative; box-shadow:0 30px 60px -20px rgba(0,0,0,0.7), 0 0 40px -10px rgba(249,115,22,0.15);
    padding:30px 28px 28px;
  }
  .specialist-title{
    text-align:center; font-size:18px; font-weight:800; letter-spacing:0.5px; color:#fff;
    margin-bottom:6px; display:flex; align-items:center; justify-content:center; gap:10px;
  }
  .specialist-sub{
    text-align:center; font-size:16px; font-weight:800; letter-spacing:0.6px;
    color:var(--red); text-transform:uppercase; margin-bottom:22px;
  }

.specialist-address{
    display:flex; align-items:flex-start; gap:10px; font-size:16px; color:var(--off);
    line-height:1.5; margin-bottom:0; padding-bottom:0;
  }

@media (max-width:980px){
    .svc-hero-inner{grid-template-columns:1fr;}
    .svc-hero h1{font-size:36px;}
    .svc-feature-strip{grid-template-columns:repeat(2, 1fr);}
  }
  @media (max-width:600px){
    .svc-hero{padding:36px 20px 32px;}
    .svc-hero h1{font-size:28px;}
    .svc-hero-actions .btn{padding:12px 18px; font-size:16px;}
    .svc-feature-strip{grid-template-columns:1fr; gap:14px;}
  }

  /* ===== SECTION HEADER (shared pattern) ===== */
  .section-header{text-align:center; margin-bottom:42px;}
  .section-header h2{font-size:30px; color:var(--ink); letter-spacing:0.4px;}
  .section-header h2 .accent{color:var(--red);}
  .section-header p{color:#5a5a5e; font-size:16px; max-width:560px; margin:14px auto 0; line-height:1.7;}

.section-divider .bar{width:70px; height:3px; background:var(--red); border-radius:2px;}

  /* ===== OVERVIEW ===== */
  .overview-section{padding:64px 32px; background:var(--paper);}
  .overview-inner{
    max-width:1280px; margin:0 auto; display:grid; grid-template-columns:1fr 0.9fr;
    gap:56px; align-items:center;
  }
  .overview-copy h2{font-size:28px; color:var(--ink); margin-bottom:18px; letter-spacing:0.3px;}
  .overview-copy h2 .accent{color:var(--red);}
  .overview-copy p{color:#5a5a5e; font-size:16px; line-height:1.8; margin-bottom:16px;}
  .overview-stats{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:18px; margin-top:28px;
  }
  .overview-stat{
    background:#fff; border:1px solid #EAEDF2; border-radius:6px; padding:20px 16px; text-align:center;
  }
  .overview-stat .num{font-size:26px; font-weight:800; color:var(--red); font-family:'Poppins', "Arial Narrow", Arial, sans-serif;}
  .overview-stat .label{font-size:16px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase; color:#5a5a5e; margin-top:4px;}
  .overview-visual{
    position:relative; border-radius:6px; overflow:hidden; aspect-ratio:4/3.4;
    box-shadow:0 24px 50px -20px rgba(0,0,0,0.3);
  }
  .overview-visual img{width:100%; height:100%; object-fit:cover;}
  .overview-badge{
    position:absolute; left:20px; bottom:20px; background:var(--charcoal); color:#fff;
    padding:14px 20px; border-radius:6px; display:flex; align-items:center; gap:12px;
    box-shadow:0 14px 30px -12px rgba(0,0,0,0.5);
  }
  .overview-badge .num{font-size:24px; font-weight:800; color:var(--red); font-family:'Poppins', "Arial Narrow", Arial, sans-serif;}
  .overview-badge .txt{font-size:16px; line-height:1.35; text-transform:uppercase; letter-spacing:0.3px; color:var(--off);}

  @media (max-width:980px){
    .overview-inner{grid-template-columns:1fr;}
    .overview-visual{order:-1;}
  }
  @media (max-width:600px){
    .overview-section{padding:48px 20px;}
    .overview-stats{grid-template-columns:1fr; gap:12px;}
  }

  /* ===== BENEFITS (reuses service-card visual language) ===== */
  .benefits-section{background:#F8FAFC; padding:64px 32px;}
  .benefits-inner{max-width:1280px; margin:0 auto;}
  .benefits-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:26px;}
  .benefit-card{
    background:var(--charcoal); border-radius:4px; overflow:hidden;
    display:flex; flex-direction:column;
    box-shadow:0 14px 34px -18px rgba(0,0,0,0.35);
  }
  .benefit-card .icon-panel{
    position:relative; overflow:hidden; flex-shrink:0;
    background:var(--red); padding:28px 20px; display:flex;
    align-items:center; justify-content:center;
  }
  .benefit-card .icon-panel svg{width:44px; height:44px;}
  .benefit-card .body{background:var(--charcoal); padding:22px 22px 26px; text-align:center;}
  .benefit-card h3{color:#fff; font-size:16px; letter-spacing:0.3px; margin-bottom:10px; text-transform:uppercase;}
  .benefit-card p{color:var(--muted); font-size:16px; line-height:1.7;}

  @media (max-width:1024px){
    .benefits-grid{grid-template-columns:repeat(2, 1fr);}
    .benefits-section{padding:48px 20px;}
  }
  @media (max-width:480px){
    .benefits-grid{grid-template-columns:1fr; gap:18px;}
  }

  /* ===== PROCESS (numbered — reflects a real, ordered installation sequence) ===== */
  .process-section{background:var(--charcoal); padding:68px 32px;}
  .process-inner{max-width:1000px; margin:0 auto;}
  .process-section .section-header h2{color:#fff;}
  .process-section .section-header p{color:var(--muted);}
  .process-list{position:relative;}
  .process-list::before{
    content:""; position:absolute; left:27px; top:8px; bottom:8px; width:2px;
    background:var(--line);
  }
  .process-item{position:relative; display:flex; gap:24px; padding-bottom:38px;}
  .process-item:last-child{padding-bottom:0;}
  .process-num{
    flex-shrink:0; width:56px; height:56px; border-radius:50%;
    background:var(--charcoal); border:2px solid var(--red); color:var(--red);
    display:flex; align-items:center; justify-content:center;
    font-family:'Poppins', "Arial Narrow", Arial, sans-serif; font-weight:800; font-size:20px;
    position:relative; z-index:1;
  }
  .process-copy h3{color:#fff; font-size:16.5px; letter-spacing:0.3px; margin-bottom:8px; text-transform:uppercase; padding-top:10px;}
  .process-copy p{color:var(--muted); font-size:16px; line-height:1.7; max-width:600px;}

  @media (max-width:600px){
    .process-section{padding:48px 20px;}
    .process-num{width:46px; height:46px; font-size:16px;}
    .process-list::before{left:22px;}
    .process-item{gap:16px;}
  }

  /* ===== FAQ (shared pattern) ===== */
  .faq-section{background:var(--paper); padding:64px 32px;}
  .faq-inner{max-width:1280px; margin:0 auto;}
  .faq-header{text-align:center; margin-bottom:42px;}
  .faq-header h2{font-size:28px; color:var(--ink); letter-spacing:0.4px;}
  .faq-header h2 .accent{color:var(--red);}
  .faq-grid{max-width:820px; margin:0 auto;}
  .faq-column{display:flex; flex-direction:column; gap:16px;}
  .faq-column + .faq-column{margin-top:16px;}
  .faq-item{border-radius:2px; overflow:hidden;}
  .faq-question{
    width:100%; display:flex; align-items:center; justify-content:space-between; gap:16px;
    background:var(--charcoal-2); color:#fff; padding:18px 22px; font-size:16px; font-weight:700;
    letter-spacing:0.2px; text-align:left;
  }
  .faq-question:hover{background:#354B6A;}
  .faq-question .faq-arrow{position:relative; flex-shrink:0; width:16px; height:16px; margin-left:16px;}
  .faq-question .faq-arrow::before, .faq-question .faq-arrow::after{
    content:""; position:absolute; top:50%; left:50%; background:#fff; border-radius:1px;
    transform:translate(-50%,-50%); transition:transform .25s ease, opacity .25s ease;
  }
  .faq-question .faq-arrow::before{width:14px; height:2px;}
  .faq-question .faq-arrow::after{width:2px; height:14px;}
  .faq-item.open .faq-question .faq-arrow::after{transform:translate(-50%,-50%) rotate(90deg) scale(0); opacity:0;}
  .faq-answer{max-height:0; overflow:hidden; background:#fff; transition:max-height .3s ease;}
  .faq-item.open .faq-answer{max-height:260px;}
  .faq-answer-inner{padding:22px 24px 26px; color:#5a5a5e; font-size:16px; line-height:1.75;}

  @media (max-width:600px){
    .faq-section{padding:44px 20px;}
    .faq-header h2{font-size:21px;}
    .faq-question{padding:16px 18px; font-size:16px;}
    .faq-answer-inner{padding:18px 18px 22px; font-size:16px;}
  }

  /* ===== CTA BANNER ===== */
  .cta-banner{
    position:relative; overflow:hidden;
    background:linear-gradient(135deg, #1A293F 0%, #0B121B 100%);
    padding:56px 32px;
  }
  .cta-banner::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size:40px 40px;
  }
  .cta-inner{
    position:relative; max-width:1000px; margin:0 auto; text-align:center;
  }
  .cta-inner .eyebrow{justify-content:center; display:flex;}
  .cta-inner h2{color:#fff; font-size:30px; margin-bottom:18px; letter-spacing:0.3px;}
  .cta-inner h2 .accent{color:var(--red);}
  .cta-actions{display:flex; gap:16px; justify-content:center; flex-wrap:wrap;}

  @media (max-width:600px){
    .cta-banner{padding:44px 20px;}
    .cta-inner h2{font-size:22px;}
  }

  /* ===== FOOTER (shared with site) ===== */

.footer-social a{
    width:32px; height:32px; border-radius:50%; background:var(--charcoal-2);
    display:flex; align-items:center; justify-content:center; border:1px solid var(--line);
  }

.fhead::after{content:""; position:absolute; left:0; bottom:0; width:100%; height:3px; background:var(--red); border-radius:2px;}

.flist li.current a{color:var(--red);}

.fcallnow{
    display:flex; align-items:center; justify-content:center; gap:9px;
    background:var(--red); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px; border-radius:3px; margin-top:22px;
  }
  
  .fwhatsapp{
    display:flex; align-items:center; justify-content:center; gap:9px;
    background:var(--green); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px; border-radius:3px; margin-top:14px;
  }

</style>

<div class="breadcrumb">
  <div class="breadcrumb-inner">
    <a href="index.html">Home</a>
    <span class="sep">/</span>
    <a href="index.html#services">Services</a>
    <span class="sep">/</span>
    <span class="current">LPG Conversion</span>
  </div>
</div>

<!-- ===== HERO ===== -->
<section class="svc-hero">
  <div class="svc-hero-inner">
    <div class="svc-hero-copy">
      <div class="eyebrow">AUTO GAS CONVERSION SPECIALISTS</div>
      <h1 class="display">LPG CONVERSION <span class="accent">SERVICE</span></h1>
      <div class="svc-hero-sub">SAFE &nbsp;•&nbsp; CERTIFIED &nbsp;•&nbsp; FUEL-SAVING</div>
      <p>Cut your fuel cost by up to 50% with a certified LPG conversion from Taqwa Automobile. Our trained technicians install genuine, government-approved kits, calibrate your engine for smooth performance, and back every job with a 2-year warranty.</p>

      <div class="svc-hero-actions">
        <a href="tel:+8801854226757" class="btn btn-red">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Call Now
        </a>
        <a href="contact.html" class="btn btn-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="#fff" stroke-width="1.8"/><path d="M8 2v4M16 2v4M3 10h18" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg>
          Book Appointment
        </a>
      </div>

      <div class="svc-feature-strip">
        <div class="item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4" stroke="#F97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.6"/></svg>
          Certified Kits
        </div>
        <div class="item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" stroke="#F97316" stroke-width="1.6"/></svg>
          2 Year Warranty
        </div>
        <div class="item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.6"/><path d="M12 7v5l3.5 2" stroke="#F97316" stroke-width="1.6" stroke-linecap="round"/></svg>
          Same Day Service
        </div>
      </div>
    </div>

    <div class="specialist-card">
      <div class="specialist-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.96 2.29a.75.75 0 0 0-1.07-.14 9.74 9.74 0 0 0-3.54 6.18 7.55 7.55 0 0 1-1.7-1.72.75.75 0 0 0-1.15-.08A9 9 0 1 0 15.68 4.53a7.46 7.46 0 0 1-2.72-2.24ZM15.75 14.25a3.75 3.75 0 1 1-7.31-1.17c.63.46 1.35.81 2.13 1a5.99 5.99 0 0 1 1.93-3.55 3.75 3.75 0 0 1 3.25 3.72Z"/></svg>&nbsp; LPG CONVERSION</div>
      <div class="specialist-sub">Quick Facts</div>
      <ul class="specialist-list">
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4" stroke="#F97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.6"/></svg>
          Save up to 50% on fuel cost
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4" stroke="#F97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.6"/></svg>
          Government-approved LPG kits
