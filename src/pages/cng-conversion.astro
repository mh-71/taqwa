---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="CNG Conversion - Taqwa Automobile Service Center"
  description="Certified CNG conversion in Uttara, Dhaka. Safety-tested cylinder installation, genuine kits, ECU tuning and 2 year warranty at Taqwa Automobile Service Center."
  path="cng-conversion.html"
  current="services"
>

<style define:vars={{ heroBg: `url(${base}img/hero-background.jpg)` }}>
  :root{
    --red:#F97316;
    --red-dark:#CE5805;
    --green:#16A34A;
    --ink:#101318;
    --charcoal:#162336;
    --charcoal-2:#1E304A;
    --line:#293C58;
    --paper:#F8FAFC;
    --muted:#9A9AA0;
    --off:#E9E9EC;

    /* ===== Surface tokens (matches homepage design system) ===== */
    --surface-0:#F8FAFC;
    --surface-1:#F1F3F7;
    --surface-2:#EEF1F6;
    --surface-3:#EBEEF3;
    --text-strong:#101318;
    --text-muted:#5a5a5e;
    --card-bg:#EFF2F6;
    --surface-border:#EAEDF2;

    /* ===== Typography scale (matches homepage design system) ===== */
    --font-display:'Poppins', "Arial Narrow", Arial, sans-serif;
    --font-body:'Inter', "Segoe UI", Arial, sans-serif;
    --text-xs:16px;
    --text-sm:16px;
    --text-base:16px;
    --text-md:16px;
    --text-lg:clamp(16px, 15.7px + 0.3vw, 18px);
    --text-xl:clamp(16px, 15.3px + 0.28vw, 18px);
    --text-2xl:clamp(18px, 16.5px + 0.6vw, 21px);
    --text-3xl:clamp(20px, 17.7px + 0.9vw, 24px);
    --text-4xl:clamp(24px, 20.2px + 1.5vw, 30px);
    --text-5xl:clamp(28px, 21.9px + 2.5vw, 40px);
    --text-6xl:clamp(32px, 23.4px + 3.4vw, 52px);

    /* ===== Spacing scale (matches homepage design system) ===== */
    --space-1:4px;
    --space-2:8px;
    --space-3:12px;
    --space-4:clamp(14px, 13.4px + 0.24vw, 16px);
    --space-5:clamp(18px, 16.5px + 0.6vw, 24px);
    --space-6:clamp(22px, 19.7px + 0.9vw, 32px);
    --space-7:clamp(32px, 28.1px + 1.5vw, 48px);
    --space-8:clamp(40px, 33.8px + 2.4vw, 64px);

    /* ===== Radius scale (matches homepage design system) ===== */
    --radius-sm:3px;
    --radius-md:4px;
    --radius-lg:6px;
    --radius-xl:10px;
    --radius-full:50%;

    /* ===== Elevation / shadow scale (matches homepage design system) ===== */
    --shadow-1:0 2px 6px rgba(0,0,0,0.08);
    --shadow-2:0 8px 20px -8px rgba(0,0,0,0.18);
    --shadow-3:0 14px 34px -18px rgba(0,0,0,0.3);
    --shadow-4:0 20px 50px -20px rgba(0,0,0,0.25);
    --shadow-5:0 30px 60px -20px rgba(0,0,0,0.6);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family: 'Inter', "Segoe UI", Arial, sans-serif;
    background:var(--charcoal);
    color:var(--off);
    -webkit-font-smoothing:antialiased;
  }
  .display{
    font-family: 'Poppins', "Arial Narrow", Arial, sans-serif;
    font-weight:800;
    letter-spacing:0.5px;
    text-transform:uppercase;
  }
  a{color:inherit; text-decoration:none;}
  ul{list-style:none;}
  button{font-family:inherit; cursor:pointer; border:none;}

  /* ===== HEADER ===== */
  header{
    background:var(--paper);
    border-bottom:1px solid #EAEDF2;
    position:sticky; top:0; z-index:50;
  }
  .header-inner{
    max-width:1280px; margin:0 auto;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 32px;
  }
  .logo{display:flex; align-items:center;}
  .logo-img{height:46px; width:auto; display:block;}
  nav.main-nav{display:flex; align-items:center; gap:30px;}
  nav.main-nav > ul{display:flex; align-items:center; gap:26px;}
  nav.main-nav a{
    font-size:16px; font-weight:700; letter-spacing:0.4px;
    color:var(--ink); text-transform:uppercase; position:relative; padding:6px 0;
    display:flex; align-items:center; gap:4px;
  }
  nav.main-nav li.active > a{color:var(--red);}
  nav.main-nav a.accent{color:var(--red);}
  nav.main-nav a:hover{color:var(--red);}
  .caret{width:11px; height:11px; flex-shrink:0; margin-top:1px; transition:transform .2s ease;}

  /* dropdown */
  .has-dropdown{position:relative;}
  .has-dropdown:hover > a .caret{transform:rotate(180deg);}
  .dropdown-menu{
    position:absolute; top:100%; left:-18px; margin-top:14px;
    background:#F8FAFC; min-width:220px; border-radius:4px;
    box-shadow:0 18px 40px -12px rgba(0,0,0,0.25); border:1px solid #EAEDF2;
    padding:8px; opacity:0; visibility:hidden; transform:translateY(6px);
    transition:opacity .15s ease, transform .15s ease, visibility .15s;
    z-index:60;
  }
  .has-dropdown:hover .dropdown-menu{
    opacity:1; visibility:visible; transform:translateY(0);
  }
  .dropdown-menu::before{
    content:""; position:absolute; top:-6px; left:28px;
    width:12px; height:12px; background:#F8FAFC; border-left:1px solid #EAEDF2; border-top:1px solid #EAEDF2;
    transform:rotate(45deg);
  }
  .dropdown-menu li{width:100%;}
  .dropdown-menu a{
    display:block; padding:10px 12px; font-size:16px; font-weight:700;
    text-transform:none; letter-spacing:0.2px; color:var(--ink);
    border-radius:3px; white-space:nowrap;
  }
  .dropdown-menu a:hover{background:#EEF1F6; color:var(--red);}
  .call-btn{
    background:var(--red); color:#fff; font-size:16px; font-weight:700;
    letter-spacing:0.4px; padding:11px 22px; border-radius:3px;
    display:flex; align-items:center; gap:8px; text-transform:uppercase;
    white-space:nowrap;
  }
  .call-btn:hover{background:var(--red-dark);}
  .hamburger{
    display:none; flex-direction:column; justify-content:center; gap:5px;
    background:none; width:32px; height:32px; flex-shrink:0;
  }
  .hamburger span{
    width:24px; height:2px; background:var(--charcoal); display:block;
    transition:transform .2s ease, opacity .2s ease;
  }
  .hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .hamburger.open span:nth-child(2){opacity:0;}
  .hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

  /* ===== MOBILE NAV DRAWER ===== */
  .mobile-nav{
    display:none; background:#F8FAFC; border-top:1px solid #EAEDF2;
  }
  .mobile-nav.open{display:block;}
  .mobile-nav > ul{padding:6px 20px 18px;}
  .mobile-nav > ul > li{border-bottom:1px solid #EEF1F5;}
  .mobile-nav > ul > li:last-child{border-bottom:none;}
  .mobile-nav > ul > li > a{
    display:flex; align-items:center; padding:14px 2px;
    font-size:16px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase;
    color:var(--ink);
  }
  .mobile-nav li.active > a{color:var(--red);}
  .mobile-sub-toggle{
    display:flex; align-items:center; justify-content:space-between; width:100%;
    background:none; text-align:left; padding:14px 2px;
    font-size:16px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase;
    color:var(--ink); font-family:inherit;
  }
  .mobile-has-sub .caret{transition:transform .2s ease;}
  .mobile-has-sub.open .caret{transform:rotate(180deg);}
  .mobile-submenu{
    display:none; padding-left:10px; padding-bottom:6px;
  }
  .mobile-has-sub.open .mobile-submenu{display:block;}
  .mobile-submenu a{
    display:block; padding:11px 2px; font-size:16px; font-weight:600;
    text-transform:none; color:#555;
  }
  .mobile-submenu a:hover{color:var(--red);}

  /* ===== HERO ===== */
  .hero{
  position:relative;
  background:
    linear-gradient(rgba(16,19,24,0.65), rgba(16,19,24,0.75)),
    var(--heroBg) center/cover no-repeat;
  overflow:hidden;
  padding:64px 32px 48px;
}


  .hero::before{
    content:"";
    position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 70% 60% at 30% 40%, black, transparent);
    pointer-events:none;
  }
  .hero-engine{
    position:absolute; right:-60px; top:50%; transform:translateY(-50%);
    width:640px; height:640px; opacity:0.9; pointer-events:none;
  }
  .hero-inner{
    position:relative; max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:1.15fr 0.85fr; gap:48px; align-items:start;
  }

  .eyebrow{
    color:var(--red); font-size:16px; font-weight:800; letter-spacing:3px;
    margin-bottom:16px;
  }
  .hero-copy h1{
    font-size:52px; line-height:1.06; color:#fff; margin-bottom:18px;
  }
  .hero-copy h1 .accent{color:var(--red);}
  .hero-sub{
    font-family:'Poppins', "Arial Narrow", Arial, sans-serif; font-weight:700;
    letter-spacing:1.5px; text-transform:uppercase; color:var(--off);
    font-size:16px; margin-bottom:18px;
  }
  .hero-copy p{
    color:var(--muted); font-size:16px; line-height:1.7; max-width:480px; margin-bottom:28px;
  }
  .hero-actions{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:34px;}
  .btn{
    display:flex; align-items:center; gap:9px; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px 26px; border-radius:3px;
  }
  .btn-red{background:var(--red); color:#fff;}
  .btn-red:hover{background:var(--red-dark);}
  .btn-green{background:var(--green); color:#fff;}
  .btn-green:hover{background:#117F3A;}

  .feature-strip{
    display:grid; grid-template-columns:repeat(4, 1fr); gap:22px 20px;
    padding-top:24px; border-top:1px solid rgba(255,255,255,0.08);
  }
  .feature-strip .item{
    display:flex; align-items:center; gap:10px; font-size:16px; font-weight:700;
    color:var(--off); text-transform:uppercase; letter-spacing:0.3px;
  }
  .feature-strip svg{flex-shrink:0;}

  /* ===== SPECIALIST INFO CARD ===== */
  .specialist-card{
    background:var(--charcoal);
    border:1.5px solid var(--red);
    border-radius:4px;
    position:relative;
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.7), 0 0 40px -10px rgba(249,115,22,0.15);
    padding:30px 28px 28px;
  }
  .specialist-title{
    text-align:center; font-size:19px; font-weight:800; letter-spacing:0.5px;
    color:#fff; margin-bottom:6px;
    display:flex; align-items:center; justify-content:center; gap:10px;
  }
  .specialist-sub{
    text-align:center; font-size:16.5px; font-weight:800; letter-spacing:0.6px;
    color:var(--red); text-transform:uppercase; margin-bottom:22px;
  }
  .specialist-list{margin-bottom:22px;}
  .specialist-list li{
    display:flex; align-items:flex-start; gap:10px; font-size:16px; color:var(--off);
    margin-bottom:13px; line-height:1.4;
  }
  .specialist-list li svg{flex-shrink:0; margin-top:1px;}
  .specialist-actions{display:flex; gap:12px; margin-bottom:22px;}
  .specialist-actions .btn{flex:1; justify-content:center; padding:13px 10px; font-size:16px;}
  .specialist-address{
    display:flex; align-items:flex-start; gap:10px; font-size:16px; color:var(--off);
    line-height:1.5; margin-bottom:20px; padding-bottom:20px;
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  .specialist-address svg{flex-shrink:0; margin-top:2px;}
  .get-direction{
    width:100%; background:#F8FAFC; color:var(--ink); font-size:16px; font-weight:800;
    letter-spacing:0.6px; text-transform:uppercase; padding:15px; border-radius:3px;
    display:flex; align-items:center; justify-content:center; gap:8px;
  }
  .get-direction:hover{background:#E2E7ED;}

  /* ===== RESPONSIVE ===== */
  @media (max-width:980px){
    .hero-inner{grid-template-columns:1fr;}
    .hero-engine{display:none;}
    .hero-copy h1{font-size:40px;}
    nav.main-nav > ul{display:none;}
    .hamburger{display:flex;}
    .call-btn{display:none;}
    .feature-strip{grid-template-columns:repeat(2, 1fr);}
  }
  @media (max-width:760px){
    .header-inner{padding:12px 20px;}
    .logo-img{height:38px;}
    .call-btn span.txt{display:none;}
    .call-btn{padding:11px 14px;}
    .hero{padding:40px 20px 36px;}
    .hero-copy h1{font-size:32px;}
    .hero-actions{gap:10px;}
    .btn{padding:12px 18px; font-size:16px;}
    .specialist-card{padding:24px 20px 22px;}
    .specialist-actions{flex-direction:column;}
  }
  @media (max-width:420px){
    .header-inner{padding:10px 16px;}
    .logo-img{height:32px;}
    .hero{padding:32px 16px 28px;}
    .hero-copy h1{font-size:27px;}
    .hero-sub{font-size:16px;}
    .eyebrow{font-size:16px; letter-spacing:2px;}
    .feature-strip{grid-template-columns:1fr; gap:16px;}
    .specialist-title{font-size:16px;}
    .specialist-sub{font-size:16px;}
    .mobile-nav ul{padding:6px 16px 16px;}
  }

  /* Reduced motion / focus */
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible{
    outline:2px solid var(--red); outline-offset:2px;
  }

  /* ===== FOOTER ===== */
  footer{
    background:#172539;
    border-top:1px solid var(--line);
    padding:64px 32px 0;
  }
  .footer-inner{
    max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:1.3fr 1fr 1fr 1.2fr 1fr; gap:40px;
    padding-bottom:44px;
  }
  .footer-col .flogo{display:flex; align-items:center; margin-bottom:18px;}
  .footer-logo-img{height:38px; width:auto; display:block;}
  .footer-col p.about{color:var(--muted); font-size:16px; line-height:1.75; margin-bottom:20px; max-width:250px;}
  .footer-social{display:flex; gap:10px;}
  .footer-social a{
    width:32px; height:32px; border-radius:50%; background:var(--charcoal-2);
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--line);
  }
  .footer-social a:hover{background:var(--red); border-color:var(--red);}

  .fhead{
    font-size:16px; font-weight:800; letter-spacing:0.6px; text-transform:uppercase;
    color:#fff; margin-bottom:8px; position:relative; padding-bottom:12px;
  }
  .fhead::after{
    content:""; position:absolute; left:0; bottom:0; width:100%; height:3px;
    background:var(--red); border-radius:2px;
  }
  .flist{margin-top:20px;}
  .flist li{margin-bottom:12px;}
  .flist a{
    font-size:16px; color:var(--muted); display:flex; align-items:center; gap:8px;
    transition:color .15s;
  }
  .flist a:hover{color:#fff;}
  .flist a .arrow{color:var(--red); font-size:16px; font-weight:800;}

  .fcontact{margin-top:20px;}
  .fcontact li{
    display:flex; align-items:flex-start; gap:11px; font-size:16px; color:var(--muted);
    margin-bottom:16px; line-height:1.55;
  }
  .fcontact li svg{flex-shrink:0; margin-top:2px;}
  .fcontact li a{color:var(--muted);}
  .fcontact li a:hover{color:#fff;}

  .fcallnow{
    display:flex; align-items:center; justify-content:center; gap:9px;
    background:var(--red); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px; border-radius:3px;
    margin-top:22px;
  }
  .fcallnow:hover{background:var(--red-dark);}
  .fwhatsapp{
    display:flex; align-items:center; justify-content:center; gap:9px;
    background:var(--green); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px; border-radius:3px;
    margin-top:14px;
  }
  .fwhatsapp:hover{background:#117F3A;}

  .footer-bottom{
    border-top:1px solid var(--line);
    padding:22px 0;
    text-align:center;
  }
  .footer-bottom p{font-size:16px; color:var(--muted); letter-spacing:0.3px;}

  @media (max-width:980px){
    .footer-inner{grid-template-columns:1fr 1fr; gap:36px;}
  }
  @media (max-width:600px){
    .footer-inner{grid-template-columns:1fr; gap:32px;}
    footer{padding:48px 20px 0;}
  }
  @media (max-width:420px){
    footer{padding:40px 16px 0;}
    .footer-logo-img{height:32px;}
    .fhead{font-size:16px;}
  }

  /* ===== CAR WASH & DETAILING ===== */
  .carwash-section{
    background:#F1F3F7;
    padding:56px 32px;
  }
  .carwash-inner{
    max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:1.5fr 1.15fr 0.65fr;
    border-radius:6px; overflow:hidden;
    box-shadow:0 20px 50px -20px rgba(0,0,0,0.25);
  }

  /* left image / illustration panel */
  .carwash-visual{
    position:relative;
    background:
      radial-gradient(ellipse 500px 400px at 70% 30%, rgba(255,255,255,0.06), transparent 60%),
      linear-gradient(135deg, #2A3E5A 0%, #121C2A 100%);
    aspect-ratio:420 / 260;
    min-height:220px;
    overflow:hidden;
  }
  .carwash-visual::before{
    content:"";
    position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size:36px 36px;
  }
  .carwash-visual svg{
    position:absolute; left:50%; top:52%; transform:translate(-50%,-50%);
    width:88%; height:auto;
  }

  /* middle content panel */
  .carwash-content{
    background:#F8FAFC;
    padding:40px 40px;
    display:flex; flex-direction:column; justify-content:center;
  }
  .carwash-content h2{
    font-size:26px; color:var(--ink); margin-bottom:14px; letter-spacing:0.3px;
  }
  .carwash-content h2 .accent{color:var(--red);}
  .carwash-content > p{
    font-size:16px; line-height:1.75; color:#5a5a5e; max-width:420px; margin-bottom:26px;
  }
  .carwash-features{
    display:grid; grid-template-columns:1fr 1fr; gap:16px 28px;
  }
  .carwash-features .cf-item{
    display:flex; align-items:center; gap:10px;
    font-size:16px; font-weight:700; color:var(--ink);
  }
  .carwash-features svg{flex-shrink:0;}

  /* right CTA panel */
  .carwash-cta{
    position:relative;
    background:linear-gradient(160deg, #1A293F 0%, #0B121B 100%);
    padding:32px 20px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    overflow:hidden;
  }
  .carwash-cta .sparkle{
    position:absolute; color:var(--red); opacity:0.7; font-size:16px;
  }
  .carwash-cta .car-icon{margin-bottom:16px;}
  .carwash-cta .cta-lead{
    color:var(--red); font-size:16px; font-weight:800; letter-spacing:1px;
    text-transform:uppercase; margin-bottom:6px;
  }
  .carwash-cta h3{
    color:#fff; font-size:19px; line-height:1.3; margin-bottom:20px;
  }
  .carwash-book-btn{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--red); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:12px 18px; border-radius:3px;
    white-space:nowrap;
  }
  .carwash-book-btn:hover{background:var(--red-dark);}

  @media (max-width:980px){
    .carwash-inner{grid-template-columns:1fr;}
  }
  @media (max-width:600px){
    .carwash-section{padding:40px 20px;}
    .carwash-content{padding:32px 24px;}
    .carwash-features{grid-template-columns:1fr;}
  }
  @media (max-width:420px){
    .carwash-section{padding:32px 16px;}
    .carwash-content{padding:26px 20px;}
    .carwash-content h2{font-size:22px;}
    .carwash-cta{padding:28px 18px;}
  }

  /* ===== OUR SERVICES ===== */
  .services-section{
    background:#F8FAFC;
    padding:64px 32px;
  }
  .services-inner{max-width:1280px; margin:0 auto;}
  .services-header{text-align:center; margin-bottom:42px;}
  .services-header h2{
    font-size:30px; color:var(--ink); letter-spacing:0.4px;
  }
  .services-header h2 .accent{color:var(--red);}
  .section-divider{
    display:flex; align-items:center; justify-content:center; gap:6px; margin-top:14px;
  }
  .section-divider .dash{
    width:26px; height:2px;
    background-image:repeating-linear-gradient(90deg, var(--red) 0 4px, transparent 4px 8px);
  }
  .section-divider .bar{width:70px; height:3px; background:var(--red); border-radius:2px;}

  .services-grid{
    display:grid; grid-template-columns:repeat(4, 1fr); gap:26px;
  }
  .service-card{
    background:var(--charcoal); border-radius:4px; overflow:hidden;
    display:flex; flex-direction:column;
    box-shadow:0 14px 34px -18px rgba(0,0,0,0.35);
  }
  .service-card .icon-panel{
    position:relative; overflow:hidden; flex-shrink:0;
