---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAllPosts, listCategories } from '../../lib/blog-db';
import { getAllTestimonials } from '../../lib/testimonial-db';

export const prerender = false;

const runtime = Astro.locals.runtime;

let stats = {
  totalPosts: 0,
  publishedPosts: 0,
  draftPosts: 0,
  totalCategories: 0,
  totalReviews: 0,
  pendingReviews: 0,
  approvedReviews: 0,
};

if (runtime) {
  const db = runtime.env.DB;
  const [posts, categories, testimonials] = await Promise.all([
    listAllPosts(db),
    listCategories(db),
    getAllTestimonials(db),
  ]);

  stats.totalPosts = posts.length;
  stats.publishedPosts = posts.filter(p => p.status === 'published').length;
  stats.draftPosts = posts.filter(p => p.status === 'draft').length;
  stats.totalCategories = categories.length;
  stats.totalReviews = testimonials.length;
  stats.pendingReviews = testimonials.filter(t => t.status === 'pending').length;
  stats.approvedReviews = testimonials.filter(t => t.status === 'approved').length;
}
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="page-head">
    <div>
      <h1>Dashboard</h1>
      <p>Overview of your Taqwa Admin Panel</p>
    </div>
  </div>

  <div class="dashboard-grid">
    <!-- Blog Posts Stats -->
    <a href="/admin/posts" class="stat-card">
      <div class="stat-value">{stats.totalPosts}</div>
      <div class="stat-label">Total Blog Posts</div>
      <div class="stat-sub">{stats.publishedPosts} published, {stats.draftPosts} draft</div>
    </a>

    <!-- Published Posts -->
    <a href="/admin/posts?status=published" class="stat-card">
      <div class="stat-value">{stats.publishedPosts}</div>
      <div class="stat-label">Published Posts</div>
      <div class="stat-sub">Live on the website</div>
    </a>

    <!-- Draft Posts -->
    <a href="/admin/posts?status=draft" class="stat-card">
      <div class="stat-value">{stats.draftPosts}</div>
      <div class="stat-label">Draft Posts</div>
      <div class="stat-sub">Not yet published</div>
    </a>

    <!-- Categories -->
    <a href="/admin/categories" class="stat-card">
      <div class="stat-value">{stats.totalCategories}</div>
      <div class="stat-label">Categories</div>
      <div class="stat-sub">Blog post categories</div>
    </a>

    <!-- Reviews Stats -->
    <a href="/admin/reviews" class="stat-card">
      <div class="stat-value">{stats.totalReviews}</div>
      <div class="stat-label">Customer Reviews</div>
      <div class="stat-sub">{stats.pendingReviews} pending, {stats.approvedReviews} approved</div>
    </a>

    <!-- Pending Reviews -->
    <a href="/admin/reviews?status=pending" class="stat-card pending">
      <div class="stat-value">{stats.pendingReviews}</div>
      <div class="stat-label">Pending Reviews</div>
      <div class="stat-sub">Waiting for moderation</div>
    </a>
  </div>

  <div class="dashboard-actions">
    <h2>Quick Actions</h2>
    <div class="action-buttons">
      <a href="/admin/posts/new" class="btn btn-primary">📝 Create New Post</a>
      <a href="/admin/posts" class="btn btn-ghost">📋 View All Posts</a>
      <a href="/admin/reviews" class="btn btn-ghost">⭐ Moderate Reviews</a>
      <a href="/admin/categories" class="btn btn-ghost">🏷️ Manage Categories</a>
    </div>
  </div>
</AdminLayout>

<style>
  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .stat-card {
    display: block;
    padding: 20px;
    border-radius: 8px;
    background: white;
    border: 1px solid #E5E7EB;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    cursor: pointer;
  }

  .stat-card:hover {
    border-color: #F97316;
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.1);
  }

  .stat-card.pending {
    border-left: 4px solid #F97316;
  }

  .stat-value {
    font-size: 32px;
    font-weight: 700;
    color: #F97316;
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 14px;
    font-weight: 600;
    color: #162336;
    margin-bottom: 4px;
  }

  .stat-sub {
    font-size: 13px;
    color: #64748B;
  }

  .dashboard-actions {
    margin-top: 40px;
  }

  .dashboard-actions h2 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 16px;
    color: #162336;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .action-buttons .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
    }

    .stat-card {
      padding: 16px;
    }

    .stat-value {
      font-size: 24px;
    }

    .action-buttons {
      flex-direction: column;
    }

    .action-buttons .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
