---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { IS_CLOUDFLARE_BUILD } from '../../lib/runtime-flag';
import { listAllPosts, listCategories } from '../../lib/blog-db';

export const prerender = !IS_CLOUDFLARE_BUILD;

const runtime = Astro.locals.runtime;
const q = Astro.url.searchParams.get('q') ?? '';
const categorySlug = Astro.url.searchParams.get('category') ?? '';
const status = Astro.url.searchParams.get('status') ?? '';

let posts: Awaited<ReturnType<typeof listAllPosts>> = [];
let categories: Awaited<ReturnType<typeof listCategories>> = [];
if (runtime) {
  const db = runtime.env.DB;
  [posts, categories] = await Promise.all([
    listAllPosts(db, {
      search: q || undefined,
      categorySlug: categorySlug || undefined,
      status: (status === 'published' || status === 'draft') ? status : undefined,
    }),
    listCategories(db),
  ]);
}

const flash: Record<string, string> = {
  created: 'Post created.',
  updated: 'Post updated.',
  deleted: 'Post deleted.',
  published: 'Post published — it will now appear on the public site.',
  unpublished: 'Post moved back to draft.',
};
let flashMessage = '';
for (const key of Object.keys(flash)) {
  if (Astro.url.searchParams.has(key)) { flashMessage = flash[key]; break; }
}
const errorMessage = Astro.url.searchParams.get('error');
const base = import.meta.env.BASE_URL;
---
<AdminLayout title="Dashboard" active="dashboard">
  <div class="page-head">
    <div>
      <h1>Blog Posts</h1>
      <p>{posts.length} post{posts.length === 1 ? '' : 's'} total</p>
    </div>
    <a href="/admin/posts/new" class="btn btn-primary">+ Add New Post</a>
  </div>

  {flashMessage && <div class="alert alert-success">{flashMessage}</div>}
  {errorMessage && <div class="alert alert-error">{errorMessage}</div>}

  <form method="get" class="filter-bar">
    <input type="text" name="q" placeholder="Search by title..." value={q}>
    <select name="category">
      <option value="">All categories</option>
      {categories.map((c) => (
        <option value={c.slug} selected={c.slug === categorySlug}>{c.name}</option>
      ))}
    </select>
    <select name="status">
      <option value="">All statuses</option>
      <option value="published" selected={status === 'published'}>Published</option>
      <option value="draft" selected={status === 'draft'}>Draft</option>
    </select>
    <button type="submit" class="btn btn-ghost">Filter</button>
    {(q || categorySlug || status) && <a href="/admin" class="btn btn-ghost">Clear</a>}
  </form>

  <div class="table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th></th>
          <th>Title</th>
          <th>Category</th>
          <th>Publish Date</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {posts.length === 0 && (
          <tr class="empty-row"><td colspan="6">No posts match these filters yet.</td></tr>
        )}
        {posts.map((post) => (
          <tr>
            <td><img class="thumb" src={base + post.featured_image} alt="" loading="lazy"></td>
            <td><strong>{post.title}</strong></td>
            <td>{post.category_name}</td>
            <td>{post.publish_date}</td>
            <td>
              <span class={`badge ${post.status === 'published' ? 'badge-published' : 'badge-draft'}`}>
                {post.status}
              </span>
            </td>
            <td>
              <div class="row-actions">
                <a class="btn btn-ghost btn-sm" href={`/admin/posts/${post.id}/edit`}>Edit</a>
                <form method="post" action={`/api/admin/posts/${post.id}?_action=${post.status === 'published' ? 'unpublish' : 'publish'}`}>
                  <button type="submit" class="btn btn-ghost btn-sm">
                    {post.status === 'published' ? 'Unpublish' : 'Publish'}
                  </button>
                </form>
                <form method="post" action={`/api/admin/posts/${post.id}?_action=delete`} onsubmit="return confirm('Delete this post permanently?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
