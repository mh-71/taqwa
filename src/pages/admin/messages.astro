---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const base = import.meta.env.BASE_URL;
const statusFilter = Astro.url.searchParams.get('status') ?? '';

// DEMO DATA: Sample contact messages (placeholder data only)
const demoMessages = [
  {
    id: 1,
    name: 'রহিম আহমেদ',
    phone_number: '01234567890',
    email: 'rahim@example.com',
    service_interest: 'lpg-conversion',
    message: 'আমার গাড়ি হিউন্ডাই ইলানট্রা। এলপিজি রূপান্তরণে আগ্রহী। খরচ এবং সময় কতদিন লাগবে?',
    status: 'new',
    created_at: '2026-10-03T10:30:00Z',
    updated_at: '2026-10-03T10:30:00Z',
  },
  {
    id: 2,
    name: 'ফাতেমা বেগম',
    phone_number: '01645323210',
    email: 'fatema@example.com',
    service_interest: 'engine-repair',
    message: 'গত সপ্তাহ থেকে ইঞ্জিনে একটি অস্বাভাবিক শব্দ হচ্ছে। দেখতে পারবেন?',
    status: 'new',
    created_at: '2026-10-02T14:15:00Z',
    updated_at: '2026-10-02T14:15:00Z',
  },
  {
    id: 3,
    name: 'হাসান করিম',
    phone_number: '01712945611',
    email: 'hasan@example.com',
    service_interest: 'car-ac',
    message: 'এয়ার কন্ডিশনার সেবা নিতে চাই। দাম কত?',
    status: 'responded',
    created_at: '2026-10-01T09:00:00Z',
    updated_at: '2026-10-01T11:30:00Z',
  },
  {
    id: 4,
    name: 'নাজমা আক্তার',
    phone_number: '01856234567',
    email: 'nazma@example.com',
    service_interest: 'car-wash',
    message: 'কার ওয়াশ এবং ডিটেইলিং সার্ভিস কত?',
    status: 'responded',
    created_at: '2026-09-30T15:45:00Z',
    updated_at: '2026-10-01T10:00:00Z',
  },
  {
    id: 5,
    name: 'করিম শেখ',
    phone_number: '01987654321',
    email: 'karim@example.com',
    service_interest: 'hybrid',
    message: 'হাইব্রিড গাড়ি সার্ভিসে আগ্রহী। বিস্তারিত বলুন।',
    status: 'spam',
    created_at: '2026-09-28T08:20:00Z',
    updated_at: '2026-09-28T08:20:00Z',
  },
];

// Filter messages by status
let messages = demoMessages;
if (statusFilter) {
  messages = demoMessages.filter(m => m.status === statusFilter);
}

// Calculate stats
const stats = {
  total: demoMessages.length,
  new: demoMessages.filter(m => m.status === 'new').length,
  responded: demoMessages.filter(m => m.status === 'responded').length,
  spam: demoMessages.filter(m => m.status === 'spam').length,
};

const statusCounts = {
  new: stats.new || 0,
  responded: stats.responded || 0,
  spam: stats.spam || 0,
};

// Format date
const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('bn-BD');
};
---

<AdminLayout title="Contact Messages" active="messages">
  <div class="page-head">
    <div>
      <h1>Contact Messages</h1>
      <p>{messages.length} message{messages.length === 1 ? '' : 's'}</p>
    </div>
  </div>

  <!-- Summary Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 28px;">
    <div class="card" style="text-align: center;">
      <div style="font-size: 32px; margin-bottom: 8px;">💬</div>
      <div style="font-size: 12px; color: #64748B; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Total Messages</div>
      <div style="font-size: 28px; font-weight: 700; color: #162336;">{stats.total}</div>
    </div>

    <div class="card" style="text-align: center;">
      <div style="font-size: 32px; margin-bottom: 8px;">🆕</div>
      <div style="font-size: 12px; color: #64748B; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">New Messages</div>
      <div style="font-size: 28px; font-weight: 700; color: #162336;">{stats.new}</div>
    </div>

    <div class="card" style="text-align: center;">
      <div style="font-size: 32px; margin-bottom: 8px;">✓</div>
      <div style="font-size: 12px; color: #64748B; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Replied</div>
      <div style="font-size: 28px; font-weight: 700; color: #162336;">{stats.responded}</div>
    </div>

    <div class="card" style="text-align: center;">
      <div style="font-size: 32px; margin-bottom: 8px;">🚫</div>
      <div style="font-size: 12px; color: #64748B; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Spam</div>
      <div style="font-size: 28px; font-weight: 700; color: #162336;">{stats.spam}</div>
    </div>
  </div>

  <!-- Status Tabs -->
  <div class="status-tabs">
    <a href="/admin/messages" class:list={['btn', 'btn-ghost', statusFilter === '' && 'active']}>
      All ({stats.total})
    </a>
    <a href="/admin/messages?status=new" class:list={['btn', 'btn-ghost', statusFilter === 'new' && 'active']}>
      New ({statusCounts.new})
    </a>
    <a href="/admin/messages?status=responded" class:list={['btn', 'btn-ghost', statusFilter === 'responded' && 'active']}>
      Replied ({statusCounts.responded})
    </a>
    <a href="/admin/messages?status=spam" class:list={['btn', 'btn-ghost', statusFilter === 'spam' && 'active']}>
      Spam ({statusCounts.spam})
    </a>
  </div>

  <!-- Search/Filter Bar -->
  <div class="filter-bar">
    <input type="text" id="searchInput" placeholder="Search by name or phone..." style="flex: 1; min-width: 200px;" />
    <button class="btn btn-primary" id="searchBtn">Search</button>
  </div>

  <!-- Messages Table -->
  {messages.length === 0 ? (
    <div class="empty-state">
      <p>No messages found{statusFilter ? ` with status "${statusFilter}"` : ''}.</p>
      <p class="text-muted">Contact messages will appear here once submitted.</p>
    </div>
  ) : (
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Service</th>
            <th>Date</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {messages.map((message) => (
            <tr>
              <td class="name">{message.name}</td>
              <td class="phone"><a href={`tel:${message.phone_number}`}>{message.phone_number}</a></td>
              <td class="email"><a href={`mailto:${message.email}`}>{message.email}</a></td>
              <td class="service">{message.service_interest}</td>
              <td class="date">{formatDate(message.created_at)}</td>
              <td>
                <span class={`badge badge-${message.status}`}>
                  {message.status === 'new' && 'New'}
                  {message.status === 'responded' && 'Replied'}
                  {message.status === 'spam' && 'Spam'}
                </span>
              </td>
              <td class="actions">
                <button class="btn-view" data-action="view" data-id={message.id} title="View message">
                  View
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <!-- Message Details Modal -->
  <div id="messageModal" class="booking-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="modal-header">
        <div class="header-left">
          <span class="header-icon">💬</span>
          <div class="header-text">
            <h2 id="modalTitle">Message Details</h2>
            <p id="modalSubtitle">Full message from customer</p>
          </div>
        </div>
        <div class="header-right">
          <div class="booking-meta">
            <div id="statusBadgeContainer" class="status-badge-container"></div>
            <div id="messageNumberContainer" class="booking-number-container"></div>
          </div>
          <button class="modal-close" data-action="close-modal" aria-label="Close modal">×</button>
        </div>
      </div>
      <div id="modalBody" class="modal-body">
        <!-- Content loaded by JavaScript -->
      </div>
    </div>
  </div>

</AdminLayout>

<style>
  .text-muted {
    color: #64748B;
    font-size: 13px;
  }

  .email {
    color: #F97316;
    text-decoration: none;
  }

  .service {
    font-size: 13px;
    color: #64748B;
  }

  /* Badge status colors */
  .badge-new {
    background: #F0F9FF;
    color: #0EA5E9;
  }

  .badge-responded {
    background: #ECFDF5;
    color: #16A34A;
  }

  .badge-spam {
    background: #FEE2E2;
    color: #DC2626;
  }

  /* Modal body content styling */
  .info-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  .info-card {
    background: white;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    overflow: hidden;
  }

  .info-card-header {
    padding: 16px;
    border-bottom: 1px solid #E2E8F0;
    font-weight: 600;
    font-size: 14px;
    background: #F8FAFC;
  }

  .info-card-content {
    padding: 16px;
  }

  .info-row {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 14px;
  }

  .info-row:last-child {
    margin-bottom: 0;
  }

  .info-label {
    font-weight: 600;
    color: #162336;
    min-width: 100px;
  }

  .info-value {
    color: #64748B;
    word-break: break-word;
  }

  .info-value a {
    color: #F97316;
    text-decoration: none;
  }

  .info-value a:hover {
    text-decoration: underline;
  }

  .message-content {
    background: #F8FAFC;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 16px;
    line-height: 1.6;
    color: #162336;
    font-size: 14px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  @media (max-width: 1024px) {
    .info-section {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ demoMessages }}>
  document.addEventListener('DOMContentLoaded', function() {
    // View message button
    document.querySelectorAll('[data-action="view"]').forEach(button => {
      button.addEventListener('click', function() {
        const messageId = parseInt(this.getAttribute('data-id'));
        viewMessage(messageId);
      });
    });

    // Close modal
    document.querySelectorAll('[data-action="close-modal"]').forEach(button => {
      button.addEventListener('click', closeModal);
    });

    // Modal backdrop click to close
    const modal = document.getElementById('messageModal');
    if (modal) {
      const backdrop = modal.querySelector('.modal-backdrop');
      if (backdrop) {
        backdrop.addEventListener('click', closeModal);
      }
    }

    // Escape key to close modal
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeModal();
      }
    });

    // Search functionality (demo only)
    const searchBtn = document.getElementById('searchBtn');
    if (searchBtn) {
      searchBtn.addEventListener('click', function() {
        const searchInput = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('table tbody tr');

        rows.forEach(row => {
          const name = row.querySelector('.name').textContent.toLowerCase();
          const phone = row.querySelector('.phone').textContent.toLowerCase();

          if (name.includes(searchInput) || phone.includes(searchInput)) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    }
  });

  function viewMessage(messageId) {
    const message = demoMessages.find(m => m.id === messageId);
    if (!message) return;

    const modal = document.getElementById('messageModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalSubtitle = document.getElementById('modalSubtitle');
    const statusBadgeContainer = document.getElementById('statusBadgeContainer');
    const messageNumberContainer = document.getElementById('messageNumberContainer');
    const modalBody = document.getElementById('modalBody');

    // Update header
    modalTitle.textContent = 'Message Details';
    modalSubtitle.textContent = `From ${message.name}`;

    // Status badge
    let badgeClass = 'badge-new';
    let statusText = 'New';
    if (message.status === 'responded') {
      badgeClass = 'badge-responded';
      statusText = 'Replied';
    } else if (message.status === 'spam') {
      badgeClass = 'badge-spam';
      statusText = 'Spam';
    }

    statusBadgeContainer.innerHTML = `<span class="badge ${badgeClass}">${statusText}</span>`;
    messageNumberContainer.innerHTML = `
      <div class="booking-number">
        <div class="booking-title">Message #${message.id}</div>
        <div class="booking-id">ID: MSG-${String(message.id).padStart(4, '0')}</div>
      </div>
    `;

    // Body content
    const createdDate = new Date(message.created_at);
    const formattedDate = createdDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });

    modalBody.innerHTML = `
      <div class="info-section">
        <div class="info-card">
          <div class="info-card-header">👤 Customer Info</div>
          <div class="info-card-content">
            <div class="info-row">
              <span class="info-label">Name:</span>
              <span class="info-value">${message.name}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Phone:</span>
              <span class="info-value"><a href="tel:${message.phone_number}">${message.phone_number}</a></span>
            </div>
            <div class="info-row">
              <span class="info-label">Email:</span>
              <span class="info-value"><a href="mailto:${message.email}">${message.email}</a></span>
            </div>
          </div>
        </div>

        <div class="info-card">
          <div class="info-card-header">🏷️ Service</div>
          <div class="info-card-content">
            <div class="info-row">
              <span class="info-label">Service:</span>
              <span class="info-value">${message.service_interest}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Date:</span>
              <span class="info-value">${formattedDate}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Status:</span>
              <span class="info-value"><span class="badge ${badgeClass}">${statusText}</span></span>
            </div>
          </div>
        </div>
      </div>

      <h3 style="margin: 24px 0 12px 0; font-size: 16px; color: #162336;">Message Content</h3>
      <div class="message-content">${message.message}</div>

      <div style="display: flex; gap: 12px; margin-top: 24px; justify-content: flex-end;">
        <button class="btn btn-ghost" onclick="closeModal()">Close</button>
        <button class="btn btn-primary" onclick="alert('Reply feature coming soon')">Reply</button>
      </div>
    `;

    modal.classList.add('open');
  }

  function closeModal() {
    const modal = document.getElementById('messageModal');
    if (modal) {
      modal.classList.remove('open');
    }
  }
</script>
