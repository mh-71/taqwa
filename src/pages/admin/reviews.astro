---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllTestimonials } from '../../lib/testimonial-db';

export const prerender = false;

const base = import.meta.env.BASE_URL;
const runtime = Astro.locals.runtime;
const statusFilter = Astro.url.searchParams.get('status') ?? '';

let testimonials: Awaited<ReturnType<typeof getAllTestimonials>> = [];

if (runtime) {
  const db = runtime.env.DB;
  testimonials = await getAllTestimonials(db, {
    status: statusFilter || undefined
  });
}

const statusCounts = {
  pending: testimonials.filter(t => t.status === 'pending').length,
  approved: testimonials.filter(t => t.status === 'approved').length,
  rejected: testimonials.filter(t => t.status === 'rejected').length,
};
---

<AdminLayout title="Reviews" active="reviews">
  <div class="page-head">
    <div>
      <h1>Customer Reviews</h1>
      <p>{testimonials.length} review{testimonials.length === 1 ? '' : 's'} total</p>
    </div>
  </div>

  <div class="status-tabs">
    <a href="/admin/reviews" class:list={['btn', 'btn-ghost', statusFilter === '' && 'active']}>
      All ({statusCounts.pending + statusCounts.approved + statusCounts.rejected})
    </a>
    <a href="/admin/reviews?status=pending" class:list={['btn', 'btn-ghost', statusFilter === 'pending' && 'active']}>
      Pending ({statusCounts.pending})
    </a>
    <a href="/admin/reviews?status=approved" class:list={['btn', 'btn-ghost', statusFilter === 'approved' && 'active']}>
      Approved ({statusCounts.approved})
    </a>
    <a href="/admin/reviews?status=rejected" class:list={['btn', 'btn-ghost', statusFilter === 'rejected' && 'active']}>
      Rejected ({statusCounts.rejected})
    </a>
  </div>

  {testimonials.length === 0 ? (
    <div class="empty-state">
      <p>No reviews found{statusFilter ? ` with status "${statusFilter}"` : ''}.</p>
      <p class="text-muted">Customer reviews will appear here once submitted.</p>
    </div>
  ) : (
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Rating</th>
            <th>Review</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {testimonials.map((review) => (
            <tr>
              <td class="name">{review.name}</td>
              <td class="location">{review.location || '-'}</td>
              <td class="rating">
                <div class="stars">
                  {[1, 2, 3, 4, 5].map(i => (
                    <span class={i <= review.rating ? 'star filled' : 'star'}>★</span>
                  ))}
                </div>
              </td>
              <td class="review-text">{review.review.substring(0, 100)}{review.review.length > 100 ? '...' : ''}</td>
              <td>
                <span class={`badge badge-${review.status}`}>{review.status}</span>
              </td>
              <td class="date">{new Date(review.created_at).toLocaleDateString()}</td>
              <td class="actions">
                <button
                  class="btn-view"
                  onclick={`viewReview(${review.id})`}
                  title="View this review"
                >
                  View
                </button>
                <button
                  class="btn-edit"
                  onclick={`editReview(${review.id})`}
                  title="Edit this review"
                >
                  Edit
                </button>
                {review.status === 'pending' && (
                  <>
                    <button
                      class="btn-approve"
                      onclick={`approveReview(${review.id})`}
                      title="Approve this review"
                    >
                      Approve
                    </button>
                    <button
                      class="btn-reject"
                      onclick={`rejectReview(${review.id})`}
                      title="Reject this review"
                    >
                      Reject
                    </button>
                  </>
                )}
                {review.status === 'rejected' && (
                  <button
                    class="btn-approve"
                    onclick={`approveReview(${review.id})`}
                    title="Approve this review"
                  >
                    Approve
                  </button>
                )}
                <button
                  class="btn-delete"
                  onclick={`deleteReview(${review.id})`}
                  title="Delete this review"
                >
                  Delete
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <!-- View Review Modal -->
  <div id="viewModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>View Review</h2>
        <button class="modal-close" onclick="closeViewModal()">×</button>
      </div>
      <div id="viewContent"></div>
    </div>
  </div>

  <!-- Edit Review Modal -->
  <div id="editModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Edit Review</h2>
        <button class="modal-close" onclick="closeEditModal()">×</button>
      </div>
      <div id="editError" class="modal-error" style="display: none;"></div>
      <div id="editSuccess" class="modal-success" style="display: none;"></div>
      <form id="editForm" onsubmit="saveReview(event)">
        <div class="form-group">
          <label for="editName">Name *</label>
          <input type="text" id="editName" name="name" required />
        </div>
        <div class="form-group">
          <label for="editLocation">Location</label>
          <input type="text" id="editLocation" name="location" />
        </div>
        <div class="form-group">
          <label for="editRating">Rating (1-5) *</label>
          <select id="editRating" name="rating" required>
            <option value="">Select rating...</option>
            <option value="1">1 Star</option>
            <option value="2">2 Stars</option>
            <option value="3">3 Stars</option>
            <option value="4">4 Stars</option>
            <option value="5">5 Stars</option>
          </select>
        </div>
        <div class="form-group">
          <label for="editReview">Review Text *</label>
          <textarea id="editReview" name="review" required></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-save">Save Changes</button>
          <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<style>
  .page-head {
    margin-bottom: var(--space-6);
  }

  .status-tabs {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .status-tabs .btn {
    &.active {
      background: var(--red);
      color: var(--admin-text-strong);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    background: var(--surface-2);
    border-radius: var(--radius-md);
    color: var(--text-muted);

    p {
      margin: 0;

      &:first-child {
        font-weight: 500;
        color: var(--text-strong);
        margin-bottom: var(--space-2);
      }
    }

    .text-muted {
      font-size: var(--text-sm);
    }
  }

  .table-wrap {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;

    th {
      padding: var(--space-3);
      text-align: left;
      font-weight: 600;
      font-size: var(--text-sm);
      background: var(--surface-3);
      border-bottom: 2px solid var(--surface-border);
    }

    td {
      padding: var(--space-3);
      border-bottom: 1px solid var(--surface-border);
      font-size: var(--text-sm);
    }

    tr:hover {
      background: var(--surface-2);
    }
  }

  .name {
    font-weight: 500;
    min-width: 120px;
  }

  .location {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .rating {
    min-width: 120px;
  }

  .stars {
    display: flex;
    gap: 2px;
    color: var(--red);
    font-size: 14px;
  }

  .star.filled {
    color: var(--red);
  }

  .star {
    color: var(--muted);
  }

  .review-text {
    max-width: 300px;
    color: var(--text-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 500;

    &.badge-pending {
      background: #fef3c7;
      color: #92400e;
    }

    &.badge-approved {
      background: #d1fae5;
      color: #065f46;
    }

    &.badge-rejected {
      background: #fee2e2;
      color: #991b1b;
    }
  }

  .date {
    font-size: var(--text-xs);
    color: var(--text-muted);
    min-width: 100px;
  }

  .actions {
    display: flex;
    gap: var(--space-2);
    min-width: 200px;

    button {
      padding: 4px 8px;
      border: none;
      border-radius: var(--radius-sm);
      font-size: var(--text-xs);
      cursor: pointer;
      font-weight: 500;
      transition: opacity 0.2s;

      &:hover {
        opacity: 0.8;
      }

      &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
    }

    .btn-view {
      background: #e0f2fe;
      color: #0369a1;
    }

    .btn-edit {
      background: #f3e8ff;
      color: #6b21a8;
    }

    .btn-approve {
      background: #d1fae5;
      color: #065f46;
    }

    .btn-reject {
      background: #fef3c7;
      color: #92400e;
    }

    .btn-delete {
      background: #fee2e2;
      color: #991b1b;
    }
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
  }

  .modal.open {
    display: flex;
  }

  .modal-content {
    background: white;
    border-radius: 12px;
    padding: 0;
    max-width: 600px;
    width: 100%;
    max-height: 90vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 32px 32px 24px 32px;
    border-bottom: 1px solid #e5e7eb;
  }

  .modal-header h2 {
    margin: 0 0 4px 0;
    font-size: 24px;
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.5px;
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #9ca3af;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .modal-close:hover {
    color: #374151;
  }

  .view-field {
    margin-bottom: var(--space-4);
  }

  .view-field-label {
    font-weight: 600;
    color: var(--text-strong);
    margin-bottom: 4px;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .view-field-value {
    color: var(--text-strong);
    font-size: var(--text-base);
  }

  .stars-display {
    display: flex;
    gap: 2px;
    color: var(--red);
    font-size: 18px;
  }

  .modal-content > form {
    padding: 32px;
    overflow-y: auto;
    flex: 1;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group:last-of-type {
    margin-bottom: 0;
  }

  .form-group label {
    display: block;
    font-weight: 500;
    margin-bottom: 8px;
    color: var(--text-strong);
    font-size: 14px;
    letter-spacing: -0.2px;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
    color: var(--text-strong);
    background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-group input:hover,
  .form-group textarea:hover,
  .form-group select:hover {
    border-color: #9ca3af;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.1);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    border-top: 1px solid #e5e7eb;
    padding-top: 20px;
  }

  .btn-save {
    background: var(--admin-accent);
    color: white;
    border: none;
    padding: 11px 24px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    flex: 1;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .btn-save::after {
    content: '→';
    position: absolute;
    right: -20px;
    transition: right 0.2s ease;
    margin-left: 8px;
  }

  .btn-save:hover {
    background: var(--admin-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
    padding-right: 40px;
  }

  .btn-save:hover::after {
    right: 10px;
  }

  .btn-cancel {
    background: var(--admin-accent);
    color: white !important;
    border: none;
    padding: 11px 24px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    flex: 1;
    transition: all 0.2s ease;
  }

  .btn-cancel:hover {
    background: var(--admin-accent-hover);
    color: white !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
  }

  .btn-cancel:active {
    color: white !important;
    transform: translateY(0);
  }

  .btn-cancel:hover {
    background: var(--admin-bg);
    border-color: var(--text-muted);
  }

  .modal-error {
    background: #fef2f2;
    color: #b91c1c;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 16px;
    font-size: 14px;
    border-left: 4px solid #dc2626;
    animation: slideDown 0.3s ease;
  }

  .modal-success {
    background: #f0fdf4;
    color: #166534;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 16px;
    font-size: 14px;
    border-left: 4px solid #16a34a;
    animation: slideDown 0.3s ease;
    font-size: var(--text-sm);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const base = import.meta.env.BASE_URL;

  window.approveReview = async function(id: number) {
    if (!confirm('Approve this review?')) return;

    try {
      const response = await fetch(`${base}api/admin/reviews/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'approved' }),
        credentials: 'include'
      });

      if (response.ok) {
        location.reload();
      } else {
        alert('Failed to approve review');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error approving review');
    }
  }

  window.rejectReview = async function(id: number) {
    if (!confirm('Reject this review?')) return;

    try {
      const response = await fetch(`${base}api/admin/reviews/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'rejected' }),
        credentials: 'include'
      });

      if (response.ok) {
        location.reload();
      } else {
        alert('Failed to reject review');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error rejecting review');
    }
  }

  window.deleteReview = async function(id: number) {
    if (!confirm('Delete this review? This cannot be undone.')) return;

    try {
      const response = await fetch(`${base}api/admin/reviews/${id}`, {
        method: 'DELETE',
        credentials: 'include'
      });

      if (response.ok) {
        location.reload();
      } else {
        alert('Failed to delete review');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error deleting review');
    }
  }

  let currentReviewId = null;

  window.viewReview = async function(id: number) {
    try {
      const response = await fetch(`${base}api/admin/reviews`, {
        method: 'GET',
        credentials: 'include'
      });

      if (!response.ok) {
        alert('Failed to load review');
        return;
      }

      const reviews = await response.json();
      const review = reviews.find((r: any) => r.id === id);

      if (!review) {
        alert('Review not found');
        return;
      }

      const stars = '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating);
      const html = `
        <div class="view-field">
          <div class="view-field-label">Customer Name</div>
          <div class="view-field-value">${escapeHtml(review.name)}</div>
        </div>
        <div class="view-field">
          <div class="view-field-label">Location</div>
          <div class="view-field-value">${review.location ? escapeHtml(review.location) : '-'}</div>
        </div>
        <div class="view-field">
          <div class="view-field-label">Rating</div>
          <div class="stars-display">${stars}</div>
        </div>
        <div class="view-field">
          <div class="view-field-label">Status</div>
          <div class="view-field-value"><strong>${review.status}</strong></div>
        </div>
        <div class="view-field">
          <div class="view-field-label">Date</div>
          <div class="view-field-value">${new Date(review.created_at).toLocaleDateString()}</div>
        </div>
        <div class="view-field">
          <div class="view-field-label">Review</div>
          <div class="view-field-value" style="white-space: pre-wrap; line-height: 1.6;">${escapeHtml(review.review)}</div>
        </div>
      `;

      document.getElementById('viewContent').innerHTML = html;
      document.getElementById('viewModal').classList.add('open');
    } catch (error) {
      console.error('Error:', error);
      alert('Error loading review');
    }
  }

  window.closeViewModal = function() {
    document.getElementById('viewModal').classList.remove('open');
  }

  window.editReview = async function(id: number) {
    try {
      const response = await fetch(`${base}api/admin/reviews`, {
        method: 'GET',
        credentials: 'include'
      });

      if (!response.ok) {
        alert('Failed to load review');
        return;
      }

      const reviews = await response.json();
      const review = reviews.find((r: any) => r.id === id);

      if (!review) {
        alert('Review not found');
        return;
      }

      currentReviewId = id;
      document.getElementById('editName').value = review.name;
      document.getElementById('editLocation').value = review.location || '';
      document.getElementById('editRating').value = String(review.rating);
      document.getElementById('editReview').value = review.review;
      document.getElementById('editError').style.display = 'none';
      document.getElementById('editSuccess').style.display = 'none';
      document.getElementById('editModal').classList.add('open');
    } catch (error) {
      console.error('Error:', error);
      alert('Error loading review');
    }
  }

  window.closeEditModal = function() {
    document.getElementById('editModal').classList.remove('open');
    currentReviewId = null;
  }

  window.saveReview = async function(e: Event) {
    e.preventDefault();

    if (!currentReviewId) {
      alert('Error: No review selected');
      return;
    }

    const name = document.getElementById('editName').value.trim();
    const location = document.getElementById('editLocation').value.trim();
    const rating = document.getElementById('editRating').value;
    const review = document.getElementById('editReview').value.trim();

    if (!name) {
      showEditError('Name is required');
      return;
    }

    if (!rating) {
      showEditError('Rating is required');
      return;
    }

    if (!review) {
      showEditError('Review text is required');
      return;
    }

    try {
      const response = await fetch(`${base}api/admin/reviews/${currentReviewId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          location: location || undefined,
          rating: Number(rating),
          review
        }),
        credentials: 'include'
      });

      if (!response.ok) {
        const data = await response.json();
        showEditError(data.error || 'Failed to save review');
        return;
      }

      showEditSuccess('Review saved successfully!');
      setTimeout(() => {
        window.closeEditModal();
        // Reload page to refresh the table with updated data
        setTimeout(() => {
          location.reload();
        }, 300);
      }, 800);
    } catch (error) {
      console.error('Error:', error);
      showEditError('Error saving review');
    }
  }

  function showEditError(message: string) {
    const errorEl = document.getElementById('editError');
    errorEl.textContent = message;
    errorEl.style.display = 'block';
    document.getElementById('editSuccess').style.display = 'none';
  }

  function showEditSuccess(message: string) {
    const successEl = document.getElementById('editSuccess');
    successEl.textContent = message;
    successEl.style.display = 'block';
    document.getElementById('editError').style.display = 'none';
  }

  function escapeHtml(text: string): string {
    const map: Record<string, string> = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return text.replace(/[&<>"']/g, (m) => map[m]);
  }
</script>
