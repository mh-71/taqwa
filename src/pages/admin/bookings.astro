---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllBookings, getBookingStats } from '../../lib/booking-db';

export const prerender = false;

const base = import.meta.env.BASE_URL;
const runtime = Astro.locals.runtime;
const statusFilter = Astro.url.searchParams.get('status') ?? '';

let bookings: Awaited<ReturnType<typeof getAllBookings>> = [];
let stats: Awaited<ReturnType<typeof getBookingStats>> = {
  total: 0,
  pending: 0,
  confirmed: 0,
  completed: 0,
  cancelled: 0,
};

if (runtime) {
  try {
    const db = runtime.env.DB;
    bookings = await getAllBookings(db, {
      status: statusFilter || undefined
    });
    stats = await getBookingStats(db);
  } catch (error) {
    console.error('Error loading bookings:', error);
    // Fallback to empty state
    bookings = [];
    stats = {
      total: 0,
      pending: 0,
      confirmed: 0,
      completed: 0,
      cancelled: 0,
    };
  }
}

const statusCounts = {
  pending: stats.pending || 0,
  confirmed: stats.confirmed || 0,
  completed: stats.completed || 0,
  cancelled: stats.cancelled || 0,
};
---

<AdminLayout title="Bookings" active="bookings">
  <div class="page-head">
    <div>
      <h1>Bookings</h1>
      <p>{bookings.length} booking{bookings.length === 1 ? '' : 's'}</p>
    </div>
  </div>

  <div class="status-tabs">
    <a href="/admin/bookings" class:list={['btn', 'btn-ghost', statusFilter === '' && 'active']}>
      All ({stats.total})
    </a>
    <a href="/admin/bookings?status=pending" class:list={['btn', 'btn-ghost', statusFilter === 'pending' && 'active']}>
      Pending ({statusCounts.pending})
    </a>
    <a href="/admin/bookings?status=confirmed" class:list={['btn', 'btn-ghost', statusFilter === 'confirmed' && 'active']}>
      Confirmed ({statusCounts.confirmed})
    </a>
    <a href="/admin/bookings?status=completed" class:list={['btn', 'btn-ghost', statusFilter === 'completed' && 'active']}>
      Completed ({statusCounts.completed})
    </a>
    <a href="/admin/bookings?status=cancelled" class:list={['btn', 'btn-ghost', statusFilter === 'cancelled' && 'active']}>
      Cancelled ({statusCounts.cancelled})
    </a>
  </div>

  {bookings.length === 0 ? (
    <div class="empty-state">
      <p>No bookings found{statusFilter ? ` with status "${statusFilter}"` : ''}.</p>
      <p class="text-muted">Booking requests will appear here.</p>
    </div>
  ) : (
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Vehicle</th>
            <th>Service</th>
            <th>Date</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {bookings.map((booking) => (
            <tr>
              <td class="id">#{booking.id}</td>
              <td class="name">{booking.name}</td>
              <td class="phone">{booking.phone_number}</td>
              <td class="vehicle">{booking.vehicle_make} {booking.vehicle_model}</td>
              <td class="service">{booking.service_type}</td>
              <td class="date">{new Date(booking.preferred_date).toLocaleDateString()}</td>
              <td>
                <span class={`badge badge-${booking.status}`}>{booking.status}</span>
              </td>
              <td class="actions">
                <button class="btn-view" data-action="view" data-id={booking.id} title="View booking">
                  View
                </button>
                {booking.status !== 'completed' && booking.status !== 'cancelled' && (
                  <button class="btn-approve" data-action="confirm" data-id={booking.id} title="Confirm booking">
                    Confirm
                  </button>
                )}
                {booking.status === 'confirmed' && (
                  <button class="btn-approve" data-action="complete" data-id={booking.id} title="Mark completed">
                    Complete
                  </button>
                )}
                {booking.status !== 'cancelled' && booking.status !== 'completed' && (
                  <button class="btn-reject" data-action="cancel" data-id={booking.id} title="Cancel booking">
                    Cancel
                  </button>
                )}
                <button class="btn-delete" data-action="delete" data-id={booking.id} title="Delete booking">
                  Delete
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <!-- Booking Details Modal -->
  <div id="bookingModal" class="booking-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="modal-header">
        <div class="header-left">
          <span class="header-icon">📅</span>
          <div class="header-text">
            <h2 id="modalTitle">Booking Details</h2>
            <p>Complete information about this booking request</p>
          </div>
        </div>
        <div class="header-right">
          <div class="booking-meta">
            <div id="statusBadgeContainer" class="status-badge-container"></div>
            <div id="bookingNumberContainer" class="booking-number-container"></div>
          </div>
          <button class="modal-close" data-action="close-modal" aria-label="Close modal">×</button>
        </div>
      </div>
      <div id="modalBody" class="modal-body">
        <!-- Content loaded by JavaScript -->
      </div>
    </div>
  </div>

</AdminLayout>

<script define:vars={{ bookings }}>
  document.addEventListener('DOMContentLoaded', function() {
    // Attach event listeners to action buttons
    document.querySelectorAll('[data-action]').forEach(button => {
      button.addEventListener('click', function(e) {
        e.stopPropagation();
        const action = this.getAttribute('data-action');
        const id = this.getAttribute('data-id') ? parseInt(this.getAttribute('data-id')) : null;

        if (action === 'view') {
          viewBooking(id);
        } else if (action === 'confirm') {
          updateStatus(id, 'confirmed');
        } else if (action === 'complete') {
          updateStatus(id, 'completed');
        } else if (action === 'cancel') {
          updateStatus(id, 'cancelled');
        } else if (action === 'delete') {
          deleteBooking(id);
        } else if (action === 'close-modal') {
          closeBookingModal();
        }
      });
    });

    // Modal backdrop click to close
    const modal = document.getElementById('bookingModal');
    if (modal) {
      const backdrop = modal.querySelector('.modal-backdrop');
      if (backdrop) {
        backdrop.addEventListener('click', closeBookingModal);
      }
    }

    // Escape key to close modal
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeBookingModal();
      }
    });
  });

  function viewBooking(id) {
    const booking = bookings.find(b => b.id === id);
    if (!booking) {
      alert('Booking not found');
      return;
    }

    // Update header with booking info
    const statusBadgeContainer = document.getElementById('statusBadgeContainer');
    const bookingNumberContainer = document.getElementById('bookingNumberContainer');

    if (statusBadgeContainer && bookingNumberContainer) {
      statusBadgeContainer.innerHTML = `<span class="badge badge-${booking.status}">${booking.status.toUpperCase()}</span>`;
      bookingNumberContainer.innerHTML = `
        <div class="booking-number">
          <div class="booking-title">Booking #${booking.id}</div>
          <div class="booking-id">ID: BK-${String(booking.id).padStart(4, '0')}</div>
        </div>
      `;
    }

    const modalBody = document.getElementById('modalBody');
    if (!modalBody) return;

    const formatDate = (dateStr) => new Date(dateStr).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      weekday: 'long'
    });

    const formatDateTime = (dateStr) => new Date(dateStr).toLocaleString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });

    modalBody.innerHTML = `
      <div class="booking-details-grid">
        <!-- Row 1: Customer & Vehicle -->
        <div class="detail-card">
          <div class="card-header customer-info">
            <span class="card-icon">👤</span>
            <h3>Customer Information</h3>
          </div>
          <div class="card-content">
            <div class="info-row">
              <span class="info-label">Name:</span>
              <span class="info-value">${booking.name}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Phone:</span>
              <span class="info-value"><a href="tel:${booking.phone_number}">${booking.phone_number}</a></span>
            </div>
            <div class="info-row">
              <span class="info-label">Email:</span>
              <span class="info-value">${booking.email ? `<a href="mailto:${booking.email}">${booking.email}</a>` : 'N/A'}</span>
            </div>
          </div>
        </div>

        <div class="detail-card">
          <div class="card-header vehicle-info">
            <span class="card-icon">🚗</span>
            <h3>Vehicle Information</h3>
          </div>
          <div class="card-content">
            <div class="info-row">
              <span class="info-label">Make:</span>
              <span class="info-value">${booking.vehicle_make}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Model:</span>
              <span class="info-value">${booking.vehicle_model}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Registration:</span>
              <span class="info-value">${booking.registration_no || 'N/A'}</span>
            </div>
          </div>
        </div>

        <!-- Row 2: Service & Additional -->
        <div class="detail-card">
          <div class="card-header service-details">
            <span class="card-icon">🔧</span>
            <h3>Service Details</h3>
          </div>
          <div class="card-content">
            <div class="info-row">
              <span class="info-label">Service Type:</span>
              <span class="info-value">${booking.service_type}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Preferred Date:</span>
              <span class="info-value">
                <span class="date-icon">📅</span>
                ${formatDate(booking.preferred_date)}
              </span>
            </div>
            <div class="info-row">
              <span class="info-label">Preferred Time:</span>
              <span class="info-value">
                <span class="time-icon">⏰</span>
                ${booking.preferred_time}
              </span>
            </div>
          </div>
        </div>

        <div class="detail-card">
          <div class="card-header additional-info">
            <span class="card-icon">💬</span>
            <h3>Additional Information</h3>
          </div>
          <div class="card-content">
            ${booking.message ? `
              <div class="message-box">
                ${booking.message}
              </div>
            ` : '<div class="no-message">No message provided</div>'}
          </div>
        </div>

        <!-- Row 3: Status & Timestamps -->
        <div class="detail-card">
          <div class="card-header booking-status">
            <span class="card-icon">📋</span>
            <h3>Booking Status</h3>
          </div>
          <div class="card-content">
            <div class="status-timeline">
              <div class="status-step ${booking.status === 'pending' || booking.status === 'confirmed' || booking.status === 'completed' ? 'active' : ''}">
                <div class="status-marker">●</div>
                <div class="status-label">Pending</div>
                <div class="status-desc">Booking request received</div>
              </div>
              <div class="status-step ${booking.status === 'confirmed' || booking.status === 'completed' ? 'active' : ''}">
                <div class="status-marker">●</div>
                <div class="status-label">Confirmed</div>
                <div class="status-desc">Appointment confirmed</div>
              </div>
              <div class="status-step ${booking.status === 'completed' ? 'active' : ''}">
                <div class="status-marker">●</div>
                <div class="status-label">Completed</div>
                <div class="status-desc">Service completed</div>
              </div>
              ${booking.status === 'cancelled' ? `
                <div class="status-step cancelled">
                  <div class="status-marker">✕</div>
                  <div class="status-label">Cancelled</div>
                  <div class="status-desc">Booking cancelled</div>
                </div>
              ` : ''}
            </div>
          </div>
        </div>

        <div class="detail-card">
          <div class="card-header timestamps">
            <span class="card-icon">🕐</span>
            <h3>Timestamps</h3>
          </div>
          <div class="card-content">
            <div class="info-row">
              <span class="info-label">Created:</span>
              <span class="info-value">${formatDateTime(booking.created_at)}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Last Updated:</span>
              <span class="info-value">${formatDateTime(booking.updated_at)}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Actions -->
      <div class="modal-footer">
        <div class="modal-footer-left">
          <button class="btn-action btn-close" data-action="close-modal">
            ✕ Close
          </button>
        </div>
        <div class="modal-footer-right">
          <button class="btn-action btn-update" data-action="update-status" data-id="${booking.id}">
            ✎ Update Status
          </button>
          <button class="btn-action btn-print" data-action="print-details" data-id="${booking.id}">
            🖨 Print Details
          </button>
        </div>
      </div>
    `;

    // Attach event listeners to new buttons
    const updateStatusBtn = modalBody.querySelector('[data-action="update-status"]');
    if (updateStatusBtn) {
      updateStatusBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const bookingId = parseInt(updateStatusBtn.getAttribute('data-id'));
        const newStatus = prompt('New status (pending, confirmed, completed, cancelled):', booking.status);
        if (newStatus && ['pending', 'confirmed', 'completed', 'cancelled'].includes(newStatus)) {
          updateStatus(bookingId, newStatus);
        }
      });
    }

    const printBtn = modalBody.querySelector('[data-action="print-details"]');
    if (printBtn) {
      printBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        window.print();
      });
    }

    openBookingModal();
  }

  function openBookingModal() {
    const modal = document.getElementById('bookingModal');
    if (!modal) return;

    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeBookingModal() {
    const modal = document.getElementById('bookingModal');
    if (!modal) return;

    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  async function updateStatus(id, newStatus) {
    if (!confirm(`Change status to ${newStatus}?`)) return;

    try {
      const response = await fetch(`/api/admin/bookings/${id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Cookie': document.cookie },
        body: JSON.stringify({ status: newStatus })
      });

      if (response.ok) {
        location.reload();
      } else {
        alert('Failed to update status');
      }
    } catch (error) {
      alert('Error updating status');
    }
  }

  async function deleteBooking(id) {
    if (!confirm('Delete this booking? This cannot be undone.')) return;

    try {
      const response = await fetch(`/api/admin/bookings/${id}/delete`, {
        method: 'DELETE',
        headers: { 'Cookie': document.cookie }
      });

      if (response.ok) {
        location.reload();
      } else {
        alert('Failed to delete booking');
      }
    } catch (error) {
      alert('Error deleting booking');
    }
  }
</script>

<style>
  .status-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .empty-state {
    text-align: center;
    padding: 48px 24px;
    color: var(--text-muted);
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--surface-border);
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface-1);
  }

  .admin-table thead {
    background: var(--surface-2);
    border-bottom: 1px solid var(--surface-border);
  }

  .admin-table th {
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    font-size: 13px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .admin-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--surface-border);
    font-size: 14px;
  }

  .admin-table tbody tr:hover {
    background: var(--surface-2);
  }

  .badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .badge-pending {
    background: #FEF3C7;
    color: #92400E;
  }

  .badge-confirmed {
    background: #DBEAFE;
    color: #0C4A6E;
  }

  .badge-completed {
    background: #DCFCE7;
    color: #15803D;
  }

  .badge-cancelled {
    background: #FEE2E2;
    color: #991B1B;
  }

  .actions {
    display: flex;
    gap: 6px;
  }

  .actions button {
    padding: 4px 8px;
    font-size: 11px;
    white-space: nowrap;
  }
</style>
