---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PostForm from '../../../../components/admin/PostForm.astro';
import { listCategories, getPostById, getPostTranslations } from '../../../../lib/blog-db';
import type { PostTranslation } from '../../../../lib/blog-db';
import { AVAILABLE_IMAGES } from '../../../../lib/available-images';

export const prerender = false;

// For static builds that can't prerender, return no paths to skip this dynamic route
export function getStaticPaths() {
  return [];
}

const runtime = Astro.locals.runtime;
const id = Number(Astro.params.id);
let categories: Awaited<ReturnType<typeof listCategories>> = [];
let post = null;
let translations: PostTranslation[] = [];

if (runtime && Number.isFinite(id)) {
  const db = runtime.env.DB;
  [categories, post] = await Promise.all([listCategories(db), getPostById(db, id)]);
  if (post) {
    translations = await getPostTranslations(db, id);
  }
}

// Find existing translation if any (language different from original)
const existingTranslation = post && translations.find(t => t.language !== post.original_language);
const errorMessage = Astro.url.searchParams.get('error');
---

<AdminLayout title="Edit Post">
  <div class="page-head">
    <div><h1>Edit Post</h1></div>
  </div>
  {runtime && !post ? (
    <div class="alert alert-error">Post not found. It may have already been deleted.</div>
  ) : (
    <div class="card">
      <PostForm
        categories={categories}
        availableImages={AVAILABLE_IMAGES}
        formAction={`/api/admin/posts/${id}?_action=update`}
        submitLabel={post?.original_language === 'bn' ? 'পরিবর্তন সংরক্ষণ করুন' : 'Save Changes'}
        errorMessage={errorMessage}
        post={post}
        originalLanguage={post?.original_language ?? 'en'}
        translation={existingTranslation}
      />
    </div>
  )}
</AdminLayout>
