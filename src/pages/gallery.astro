---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Gallery - Taqwa Automobile Service Center"
  description="See real photos from Taqwa Automobile's workshop in Uttara, Dhaka — LPG & CNG conversion, hybrid diagnostics, engine repair and premium car detailing in action."
  path="gallery.html"
  current="gallery"
>

<style>

/* ===== SCROLL-REVEAL MICRO-ANIMATIONS ===== */
  @keyframes fadeInUp{
    from{opacity:0; transform:translateY(28px);}
    to{opacity:1; transform:translateY(0);}
  }
  @keyframes floatBounce{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-6px);}
  }
  @keyframes shimmer{
    0%{background-position:100% 0;}
    100%{background-position:0 0;}
  }

/* ===== STICKY FLOATING WHATSAPP / CALL BUTTONS ===== */

@keyframes pulseRing{
    0%{box-shadow:0 0 0 0 rgba(22,163,74,0.45);}
    70%{box-shadow:0 0 0 14px rgba(22,163,74,0);}
    100%{box-shadow:0 0 0 0 rgba(22,163,74,0);}
  }

/* Reduced motion / focus */
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [tabindex]:focus-visible{
    outline:2px solid var(--red); outline-offset:2px;
  }

/* ===== PAGE BANNER ===== */
  .page-banner{
    position:relative;
    background:linear-gradient(150deg, var(--charcoal-2) 0%, var(--charcoal) 100%);
    overflow:hidden;
    padding:var(--space-8) var(--space-6) 58px;
    text-align:center;
  }
  .page-banner::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 70% 70% at 50% 40%, black, transparent);
    pointer-events:none;
  }
  .page-banner-inner{position:relative; max-width:1280px; margin:0 auto;}
  .page-banner .eyebrow{justify-content:center; display:flex;}
  .page-banner h1{
    font-size:var(--text-5xl); color:#fff; letter-spacing:0.4px; margin-bottom:16px;
  }
  .page-banner h1 .accent{color:var(--red);}
  .page-banner-inner > p{color:var(--off); font-size:var(--text-base); line-height:1.75; max-width:620px; margin:0 auto 20px;}
  .breadcrumb{
    display:flex; justify-content:center; align-items:center; gap:10px;
    font-size:16px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px;
    font-weight:700;
  }
  .breadcrumb a{color:var(--off);}
  .breadcrumb a:hover{color:var(--red);}
  .breadcrumb .sep{color:var(--red); font-size:16px;}
  .breadcrumb .current{color:var(--red);}

  @media (max-width:760px){
    .page-banner{padding:var(--space-7) var(--space-5) 40px;}
    .page-banner h1{font-size:var(--text-3xl);}
  }
  @media (max-width:420px){
    .page-banner{padding:36px 16px 32px;}
    .breadcrumb{font-size:16px;}
  }

  /* ===== ABOUT PAGE: CTA ===== */
  .about-cta-section{
    position:relative; overflow:hidden;
    background:linear-gradient(135deg, var(--charcoal-2) 0%, var(--charcoal) 100%);
    padding:var(--space-8) var(--space-6); text-align:center;
  }
  .about-cta-section::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:40px 40px;
    mask-image:radial-gradient(ellipse 70% 80% at 50% 40%, black, transparent);
  }
  .about-cta-inner{position:relative; max-width:760px; margin:0 auto;}
  .about-cta-inner h2{color:#fff; font-size:var(--text-3xl); margin-bottom:14px; letter-spacing:0.3px;}
  .about-cta-inner p{color:var(--muted); font-size:16px; margin-bottom:16px; line-height:1.75;}
  .about-cta-address{
    display:flex; align-items:center; justify-content:center; gap:8px;
    color:var(--off); font-size:16px; margin-bottom:28px; line-height:1.5; flex-wrap:wrap;
  }
  .about-cta-actions{display:flex; gap:14px; flex-wrap:wrap; justify-content:center;}

  @media (max-width:600px){
    .about-cta-section{padding:var(--space-7) var(--space-5);}
    .about-cta-inner h2{font-size:var(--text-2xl);}
  }

  /* ===== GALLERY PAGE ===== */
  .gallery-section{background:var(--surface-1); padding:60px 32px;}
  .gallery-inner{max-width:1280px; margin:0 auto;}

  .gallery-filter{
    display:flex; flex-wrap:wrap; justify-content:center; gap:12px;
    margin-bottom:42px;
  }
  .filter-btn{
    background:#fff; color:var(--text-strong); font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:12px 22px;
    border-radius:30px; border:1.5px solid var(--surface-border);
    transition:background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .filter-btn:hover{border-color:var(--red); color:var(--red);}
  .filter-btn.active{background:var(--red); color:#fff; border-color:var(--red);}

  .gallery-grid{
    display:grid; grid-template-columns:repeat(4, 1fr); gap:22px;
  }
  .gallery-item{
    position:relative; border-radius:var(--radius-lg); overflow:hidden; cursor:pointer;
    aspect-ratio:4/3.4;
    box-shadow:var(--shadow-3);
    transition:transform .2s ease;
  }
  .gallery-item:hover{transform:translateY(-4px);}
  .gallery-item img{
    width:100%; height:100%; object-fit:cover; display:block;
    transition:transform .35s ease;
  }
  .gallery-item:hover img{transform:scale(1.06);}
  .gallery-item.hidden{display:none;}

  .gallery-overlay{
    position:absolute; inset:0; z-index:1;
    background:linear-gradient(to top, rgba(10,20,15,0.88) 0%, rgba(10,20,15,0.15) 55%, transparent 100%);
    display:flex; flex-direction:column; justify-content:flex-end;
    padding:18px 18px 16px;
  }
  .gallery-cat{
    color:var(--red); font-size:16px; font-weight:800; text-transform:uppercase;
    letter-spacing:0.5px; margin-bottom:5px;
  }
  .gallery-title{
    color:#fff; font-size:16px; font-weight:700; letter-spacing:0.2px; line-height:1.3;
  }
  .gallery-zoom{
    position:absolute; top:14px; right:14px; z-index:2;
    width:34px; height:34px; border-radius:var(--radius-full);
    background:rgba(255,255,255,0.18); backdrop-filter:blur(2px);
    display:flex; align-items:center; justify-content:center;
    opacity:0; transition:opacity .2s ease;
  }
  .gallery-item:hover .gallery-zoom{opacity:1;}

  @media (max-width:1024px){
    .gallery-grid{grid-template-columns:repeat(3, 1fr);}
  }
  @media (max-width:760px){
    .gallery-section{padding:44px 20px;}
    .gallery-grid{grid-template-columns:repeat(2, 1fr); gap:14px;}
    .filter-btn{padding:10px 16px; font-size:16px;}
  }
  @media (max-width:460px){
    .gallery-grid{grid-template-columns:1fr;}
  }

  /* ===== LIGHTBOX ===== */
  .gallery-lightbox{
    position:fixed; inset:0; z-index:300; padding:24px;
    background:rgba(8,16,12,0.94);
    display:none; align-items:center; justify-content:center;
  }
  .gallery-lightbox.open{display:flex;}
  .gallery-lightbox-inner{position:relative; max-width:880px; width:100%;}
  .gallery-lightbox-inner img{
    width:100%; max-height:76vh; object-fit:contain; border-radius:var(--radius-lg); display:block;
    box-shadow:0 30px 70px -20px rgba(0,0,0,0.6);
  }
  .gallery-lightbox-caption{
    text-align:center; margin-top:16px;
  }
  .gallery-lightbox-caption .gallery-cat{margin-bottom:6px;}
  .gallery-lightbox-caption .gallery-title{color:#fff; font-size:16px;}
  .gallery-lightbox-close{
    position:absolute; top:-46px; right:0; width:38px; height:38px; border-radius:var(--radius-full);
    background:rgba(255,255,255,0.14); display:flex; align-items:center; justify-content:center;
  }
  .gallery-lightbox-close:hover{background:var(--red);}
  .gallery-lightbox-nav{
    position:absolute; top:50%; transform:translateY(-50%);
    width:44px; height:44px; border-radius:var(--radius-full);
    background:rgba(255,255,255,0.14); display:flex; align-items:center; justify-content:center;
  }
  .gallery-lightbox-nav:hover{background:var(--red);}
  .gallery-lightbox-prev{left:-56px;}
  .gallery-lightbox-next{right:-56px;}

  @media (max-width:900px){
    .gallery-lightbox-prev{left:6px;}
    .gallery-lightbox-next{right:6px;}
    .gallery-lightbox-close{top:6px; right:6px;}
  }
</style>

<section class="page-banner">
