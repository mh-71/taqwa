---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Contact Us - Taqwa Automobile Service Center"
  description="Contact Taqwa Automobile Service Center in Diabari, Uttara, Dhaka. Call, WhatsApp, or send a message to book LPG & CNG conversion, hybrid service, or any car repair."
  path="contact.html"
  current="contact"
>

<style>

/* ===== SCROLL-REVEAL MICRO-ANIMATIONS ===== */
  @keyframes fadeInUp{
    from{opacity:0; transform:translateY(28px);}
    to{opacity:1; transform:translateY(0);}
  }
  @keyframes floatBounce{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-6px);}
  }
  @keyframes shimmer{
    0%{background-position:100% 0;}
    100%{background-position:0 0;}
  }

/* ===== STICKY FLOATING WHATSAPP / CALL BUTTONS ===== */

@keyframes pulseRing{
    0%{box-shadow:0 0 0 0 rgba(22,163,74,0.45);}
    70%{box-shadow:0 0 0 14px rgba(22,163,74,0);}
    100%{box-shadow:0 0 0 0 rgba(22,163,74,0);}
  }

/* ===== PAGE BANNER ===== */
  .page-banner{
    position:relative;
    background:linear-gradient(150deg, var(--charcoal-2) 0%, var(--charcoal) 100%);
    overflow:hidden;
    padding:var(--space-8) var(--space-6) 58px;
    text-align:center;
  }
  .page-banner::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 70% 70% at 50% 40%, black, transparent);
    pointer-events:none;
  }
  .page-banner-inner{position:relative; max-width:1280px; margin:0 auto;}
  .page-banner .eyebrow{justify-content:center; display:flex;}
  .page-banner h1{
    font-size:var(--text-5xl); color:#fff; letter-spacing:0.4px; margin-bottom:16px;
  }
  .page-banner h1 .accent{color:var(--red);}
  .page-banner-inner > p{color:var(--off); font-size:var(--text-base); line-height:1.75; max-width:620px; margin:0 auto 20px;}
  .breadcrumb{
    display:flex; justify-content:center; align-items:center; gap:10px;
    font-size:16px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px;
    font-weight:700;
  }
  .breadcrumb a{color:var(--off);}
  .breadcrumb a:hover{color:var(--red);}
  .breadcrumb .sep{color:var(--red); font-size:16px;}
  .breadcrumb .current{color:var(--red);}

  @media (max-width:760px){
    .page-banner{padding:var(--space-7) var(--space-5) 40px;}
    .page-banner h1{font-size:var(--text-3xl);}
  }
  @media (max-width:420px){
    .page-banner{padding:36px 16px 32px;}
    .breadcrumb{font-size:16px;}
  }

  /* ===== CONTACT PAGE ===== */
  .contact-info-section{background:var(--surface-1); padding:60px 32px 0;}
  .contact-info-grid{
    max-width:1280px; margin:0 auto 60px;
    display:grid; grid-template-columns:repeat(4, 1fr); gap:24px;
  }
  .contact-info-card{
    background:#fff; border-radius:var(--radius-lg); padding:32px 22px; text-align:center;
    box-shadow:var(--shadow-3);
  }
  .contact-info-icon{
    width:58px; height:58px; border-radius:var(--radius-full); margin:0 auto 18px;
    background:linear-gradient(150deg, var(--red) 0%, var(--red-dark) 100%);
    display:flex; align-items:center; justify-content:center;
  }
  .contact-info-card h3{
    font-size:var(--text-base); color:var(--text-strong); text-transform:uppercase; letter-spacing:0.4px; margin-bottom:10px;
  }
  .contact-info-card p{color:var(--text-muted); font-size:16px; line-height:1.7;}
  .contact-info-card a{color:var(--text-muted);}
  .contact-info-card a:hover{color:var(--red);}

  .contact-main-section{background:var(--surface-1); padding:0 32px 64px;}
  .contact-main-layout{
    max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:1.15fr 0.85fr; gap:48px; align-items:start;
  }

  .contact-form-card{
    background:#fff; border-radius:var(--radius-lg); padding:38px 34px;
    box-shadow:var(--shadow-3);
  }
  .contact-form-card h2{font-size:var(--text-3xl); color:var(--text-strong); margin-bottom:8px; letter-spacing:0.2px;}
  .contact-form-card > p{color:var(--text-muted); font-size:16px; margin-bottom:26px;}

  .form-row{display:grid; grid-template-columns:1fr 1fr; gap:18px;}
  .form-group{display:flex; flex-direction:column; gap:8px; margin-bottom:18px;}
  .form-group label{
    font-size:16px; font-weight:700; color:var(--text-strong); text-transform:uppercase; letter-spacing:0.3px;
  }
  .form-group input, .form-group select, .form-group textarea{
    border:1.5px solid var(--surface-border); border-radius:var(--radius-md); padding:12px 14px;
    font-family:inherit; font-size:16px; color:var(--text-strong); background:#fff;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus{
    outline:none; border-color:var(--red);
  }
  .form-group textarea{resize:vertical; min-height:120px;}

  .form-submit-btn{
    background:var(--red); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.5px; text-transform:uppercase; padding:14px 30px; border-radius:var(--radius-md);
    display:inline-flex; align-items:center; gap:10px;
  }
  .form-submit-btn:hover{background:var(--red-dark);}
  .form-submit-btn:disabled{opacity:0.6; cursor:not-allowed;}

  .form-success{
    display:none; align-items:center; gap:10px;
    background:#EAF6EE; border:1.5px solid var(--green); border-radius:var(--radius-md);
    padding:14px 18px; color:#1c7a41; font-size:16px; margin-top:18px;
  }
  .form-success.show{display:flex;}

  .contact-side{display:flex; flex-direction:column; gap:26px;}

  .map-card{border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-3); line-height:0; position:relative;}
  .map-card iframe{width:100%; height:300px; border:none; display:block;}
  .map-directions-link{
    position:absolute; inset:0; z-index:2; display:flex; align-items:flex-end;
    text-decoration:none;
  }
  .map-directions-bar{
    width:100%; background:var(--red); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.5px; text-transform:uppercase; padding:14px;
    display:flex; align-items:center; justify-content:center; gap:8px;
    transition:background-color .2s ease;
  }
  .map-directions-link:hover .map-directions-bar{background:var(--red-dark);}

  .hours-card{
    background:#fff; border-radius:var(--radius-lg); padding:28px 26px;
    box-shadow:var(--shadow-3);
  }
  .hours-card h3{
    font-size:16px; color:var(--text-strong); text-transform:uppercase; letter-spacing:0.4px;
    margin-bottom:18px; padding-bottom:14px; position:relative;
  }
  .hours-card h3::after{
    content:""; position:absolute; left:0; bottom:0; width:36px; height:3px;
    background:var(--red); border-radius:var(--radius-sm);
  }
  .hours-row{
    display:flex; justify-content:space-between; padding:10px 0;
    border-bottom:1px solid var(--surface-border); font-size:16px;
  }
  .hours-row:last-child{border-bottom:none; padding-bottom:0;}
  .hours-row .day{color:var(--text-strong); font-weight:700;}
  .hours-row .time{color:var(--text-muted);}
  .hours-row.closed .time{color:var(--red); font-weight:700;}

  .social-card{
    background:linear-gradient(150deg, var(--charcoal-2) 0%, var(--charcoal) 100%);
    border-radius:var(--radius-lg); padding:28px 26px; text-align:center; position:relative; overflow:hidden;
  }
  .social-card::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size:36px 36px;
    mask-image:radial-gradient(ellipse 70% 80% at 50% 40%, black, transparent);
  }
  .social-card h3{
    position:relative; color:#fff; font-size:16px; text-transform:uppercase;
    letter-spacing:0.4px; margin-bottom:18px;
  }
  .social-card .footer-social{position:relative; justify-content:center;}

  @media (max-width:1024px){
    .contact-info-grid{grid-template-columns:repeat(2, 1fr);}
  }
  @media (max-width:980px){
    .contact-main-layout{grid-template-columns:1fr;}
  }
  @media (max-width:760px){
    .contact-info-section{padding:44px 20px 0;}
    .contact-main-section{padding:0 20px 44px;}
    .contact-form-card{padding:28px 22px;}
    .form-row{grid-template-columns:1fr;}
  }
  @media (max-width:460px){
    .contact-info-grid{grid-template-columns:1fr;}
  }
</style>

<section class="page-banner">
  <div class="page-banner-inner">
    <div class="eyebrow reveal">GET IN TOUCH</div>
    <h1 class="display reveal">CONTACT <span class="accent">US</span></h1>
    <p class="reveal">Questions about LPG &amp; CNG conversion, hybrid service, or booking a repair? Call, WhatsApp, or send us a message — we typically reply within 24 hours.</p>
    <div class="breadcrumb reveal">
      <a href="index.html">Home</a>
      <span class="sep">»</span>
      <span class="current">Contact Us</span>
    </div>
  </div>
</section>

<section class="contact-info-section">
  <div class="contact-info-grid">

    <div class="contact-info-card reveal">
      <div class="contact-info-icon">
        <svg class="icon" width="24" height="24" style="color:#fff"><use href="#icon-location"/></svg>
      </div>
      <h3>Our Location</h3>
      <p>Sector # 15, Block # C, Road # 3/A,<br>Plot # 40, Diabari, Uttara, Dhaka.</p>
    </div>

    <div class="contact-info-card reveal">
      <div class="contact-info-icon">
        <svg class="icon" width="22" height="22" style="color:#fff"><use href="#icon-phone"/></svg>
      </div>
      <h3>Call Us</h3>
      <p><a href="tel:+8801854226757">01854226757</a><br>Sat &ndash; Thu, 9AM &ndash; 8PM</p>
    </div>

    <div class="contact-info-card reveal">
      <div class="contact-info-icon">
        <svg class="icon" width="24" height="24" style="color:#fff"><use href="#icon-email"/></svg>
      </div>
      <h3>Email Us</h3>
      <p><a href="mailto:mosharrafhossen090@gmail.com">mosharrafhossen090@gmail.com</a><br>We reply within 24 hours</p>
    </div>

    <div class="contact-info-card reveal">
      <div class="contact-info-icon">
        <svg class="icon" width="24" height="24" style="color:#fff"><use href="#icon-clock"/></svg>
      </div>
      <h3>Working Hours</h3>
      <p>Saturday &ndash; Thursday<br>9:00 AM &ndash; 8:00 PM</p>
    </div>

  </div>
</section>

<section class="contact-main-section">
  <div class="contact-main-layout">

    <div class="contact-form-card reveal">
      <h2>Send Us a <span style="color:var(--red);">Message</span></h2>
      <p>Have a question about a service or want to book an appointment? Fill out the form below and our team will get back to you.</p>

      <form id="contactForm">
        <div class="form-row">
          <div class="form-group">
            <label for="fullName">Full Name</label>
            <input type="text" id="fullName" name="fullName" placeholder="Your name" required>
          </div>
          <div class="form-group">
            <label for="phoneNumber">Phone Number</label>
            <input type="tel" id="phoneNumber" name="phoneNumber" placeholder="01XXX-XXXXXX" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="emailAddress">Email Address</label>
            <input type="email" id="emailAddress" name="emailAddress" placeholder="you@example.com" required>
          </div>
          <div class="form-group">
            <label for="serviceInterest">Service Interested In</label>
            <select id="serviceInterest" name="serviceInterest">
              <option value="">Select a service</option>
              <option value="lpg-cng">LPG &amp; CNG Conversion</option>
              <option value="engine">Engine Repair &amp; Service</option>
              <option value="ac">Car AC Service</option>
              <option value="hybrid">Hybrid Vehicle Service</option>
              <option value="carwash">Car Wash &amp; Detailing</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="Tell us about your vehicle and what you need..." required></textarea>
        </div>

        <button type="submit" class="form-submit-btn" id="formSubmitBtn">
          <span id="formSubmitBtnText">Send Message</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M22 2L11 13" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 2l-7 20-4-9-9-4 20-7z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="form-success" id="formSuccess">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#22A24D" stroke-width="1.8"/><path d="M8 12.5l2.5 2.5L16 9" stroke="#22A24D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Thank you! Your message has been received. We'll get back to you shortly.</span>
        </div>
        <div class="form-success" id="formError" style="background:#FDECEC; border-color:#F5B4B4;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#D14343" stroke-width="1.8"/><path d="M12 7v6M12 16.5v.01" stroke="#D14343" stroke-width="2" stroke-linecap="round"/></svg>
          <span>Sorry, something went wrong sending your message. Please call us directly at <a href="tel:+8801854226757" style="color:#D14343; font-weight:700;">01854226757</a> or try again.</span>
        </div>
      </form>
    </div>

    <div class="contact-side">

      <div class="map-card reveal">
        <a href="https://www.google.com/maps/dir/?api=1&destination=23.8657374,90.3658627" target="_blank" rel="noopener" class="map-directions-link" aria-label="Get directions to Taqwa Automobile Service Center">
          <div class="map-directions-bar">
            <svg class="icon" width="15" height="15"><use href="#icon-directions"/></svg>
            Get Directions
          </div>
        </a>
        <iframe src="https://www.google.com/maps?q=23.8657374,90.3658627&z=17&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Taqwa Automobile Service Center Location"></iframe>
      </div>

      <div class="hours-card reveal">
        <h3>Business Hours</h3>
        <div class="hours-row"><span class="day">Saturday</span><span class="time">9:00 AM &ndash; 8:00 PM</span></div>
        <div class="hours-row"><span class="day">Sunday</span><span class="time">9:00 AM &ndash; 8:00 PM</span></div>
        <div class="hours-row"><span class="day">Monday</span><span class="time">9:00 AM &ndash; 8:00 PM</span></div>
        <div class="hours-row"><span class="day">Tuesday</span><span class="time">9:00 AM &ndash; 8:00 PM</span></div>
        <div class="hours-row"><span class="day">Wednesday</span><span class="time">9:00 AM &ndash; 8:00 PM</span></div>
        <div class="hours-row"><span class="day">Thursday</span><span class="time">9:00 AM &ndash; 8:00 PM</span></div>
        <div class="hours-row closed"><span class="day">Friday</span><span class="time">Closed</span></div>
      </div>

      <div class="social-card reveal">
        <h3>Follow Us</h3>
        <div class="footer-social">
          <a href="#" aria-label="Facebook"><svg class="icon" width="15" height="15"><use href="#icon-facebook"/></svg></a>
          <a href="#" aria-label="YouTube"><svg class="icon" width="16" height="16"><use href="#icon-youtube"/></svg></a>
          <a href="#" aria-label="Instagram"><svg class="icon" width="15" height="15"><use href="#icon-instagram"/></svg></a>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // ===== CONTACT FORM (submits via FormSubmit.co - no server needed) =====
  // NOTE: the first real submission sends a one-time confirmation email to
  // mosharrafhossen090@gmail.com — that link must be clicked once to activate delivery.
  var contactForm = document.getElementById('contactForm');
  var formSuccess = document.getElementById('formSuccess');
  var formError = document.getElementById('formError');
  var submitBtn = document.getElementById('formSubmitBtn');
  var submitBtnText = document.getElementById('formSubmitBtnText');
  var FORM_ENDPOINT = 'https://formsubmit.co/ajax/mosharrafhossen090@gmail.com';

  if (contactForm) {
    contactForm.addEventListener('submit', function(e){
      e.preventDefault();
      if(!contactForm.checkValidity()){
        contactForm.reportValidity();
        return;
      }

      formSuccess.classList.remove('show');
      formError.classList.remove('show');
      submitBtn.disabled = true;
      submitBtnText.textContent = 'Sending...';

      var formData = new FormData(contactForm);
      var payload = {
        _subject: 'New enquiry from taqwaautomobile.com contact form',
        Name: formData.get('fullName'),
        Phone: formData.get('phoneNumber'),
        Email: formData.get('emailAddress'),
        'Service Interested In': formData.get('serviceInterest') || 'Not specified',
        Message: formData.get('message')
      };

      fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function(res){ if(!res.ok){ throw new Error('Form submission failed'); } return res.json(); })
        .then(function(){
          formSuccess.classList.add('show');
          contactForm.reset();
          formSuccess.scrollIntoView({behavior:'smooth', block:'center'});
        })
        .catch(function(){
          formError.classList.add('show');
          formError.scrollIntoView({behavior:'smooth', block:'center'});
        })
        .finally(function(){
          submitBtn.disabled = false;
          submitBtnText.textContent = 'Send Message';
        });
    });
  }
</script>
</Layout>
