/* ================================
   SERVICES GRID
================================ */

.services-grid{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:20px;
}


/* ================================
   SERVICE CARD
================================ */

.service-card{
  overflow:hidden;
}


/* ================================
   HIDDEN SERVICE CARDS
   5th + 6th cards
================================ */

.services-grid .service-card:nth-child(n + 5){
  opacity:0;
  visibility:hidden;

  max-height:0;

  overflow:hidden;

  transform:translateY(-20px);

  margin-top:0;
  margin-bottom:0;

  pointer-events:none;

  transition:
    opacity .65s ease,
    transform .65s ease,
    max-height .75s ease,
    visibility 0s linear .75s;
}


/* ================================
   SHOW ALL SERVICES
================================ */

.services-grid.show-all .service-card:nth-child(n + 5){
  opacity:1;
  visibility:visible;

  max-height:700px;

  transform:translateY(0);

  pointer-events:auto;

  transition:
    opacity .65s ease,
    transform .65s ease,
    max-height .75s ease,
    visibility 0s linear 0s;
}


/* ================================
   BUTTON AREA
================================ */

.services-recap-cta{
  text-align:center;
  margin-top:40px;
}

.services-recap-cta .btn-learn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  cursor:pointer;

  border:none;
  font:inherit;
}


/* ================================
   BUTTON ARROW
================================ */

.services-recap-cta .btn-learn .btn-arrow{
  flex-shrink:0;

  transition:
    transform .45s ease;
}


/* ================================
   ARROW HOVER
================================ */

.services-recap-cta .btn-learn:hover .btn-arrow{
  transform:translateX(4px);
}


/* ================================
   SHOW ALL ARROW
================================ */

.services-grid.show-all
~ .services-recap-cta
.btn-arrow{
  transform:rotate(180deg);
}


