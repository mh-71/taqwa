<script>
  const servicesGrid = document.querySelector('.services-grid');
  const servicesToggle = document.getElementById('view-all-services');

  if (servicesGrid && servicesToggle) {
    const buttonText = servicesToggle.querySelector('.btn-text');
    const buttonIcon = servicesToggle.querySelector('.btn-arrow');

    servicesToggle.addEventListener('click', () => {
      const isOpen = servicesGrid.classList.toggle('show-all');

      if (buttonText) {
        buttonText.textContent = isOpen
          ? 'View Less Services'
          : 'View All Services';
      }

      if (buttonIcon) {
        buttonIcon.style.transform = isOpen
          ? 'rotate(180deg)'
          : 'rotate(0deg)';
      }
    });
  }
</script>

