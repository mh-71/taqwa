---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="About Us - Taqwa Automobile Service Center"
  description="Learn about Taqwa Automobile Service Center — our story, expert technicians, and commitment to quality car care in Uttara, Dhaka."
  path="about.html"
  current="about"
>

<style>

/* ===== SCROLL-REVEAL MICRO-ANIMATIONS ===== */
  @keyframes fadeInUp{
    from{opacity:0; transform:translateY(28px);}
    to{opacity:1; transform:translateY(0);}
  }
  @keyframes floatBounce{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-6px);}
  }
  @keyframes shimmer{
    0%{background-position:100% 0;}
    100%{background-position:0 0;}
  }
  @keyframes spinSlow{
    from{transform:rotate(0deg);}
    to{transform:rotate(360deg);}
  }

/* ===== STICKY FLOATING WHATSAPP / CALL BUTTONS ===== */

@keyframes pulseRing{
    0%{box-shadow:0 0 0 0 rgba(22,163,74,0.45);}
    70%{box-shadow:0 0 0 14px rgba(22,163,74,0);}
    100%{box-shadow:0 0 0 0 rgba(22,163,74,0);}
  }

/* right CTA panel */

.carwash-cta .car-icon{margin-bottom:16px;}

/* ===== OUR SERVICES ===== */

.service-card .body{
    position:relative; overflow:hidden;
    background:var(--charcoal); padding:24px 22px 26px; text-align:center;
    flex:1 1 auto; display:flex; flex-direction:column; justify-content:center;
  }

/* ===== HYBRID FEATURES STRIP (nested inside the commit-strip section) =====
   Was declared twice here (once as a 6-col grid, once as a flex row); the
   flex/space-evenly version wasn't wrapping cleanly on narrow screens, so
   this is now the same fluid grid pattern used for this class everywhere
   else on the site (global.css, hybrid-services.astro, ServiceDetail.astro). */
  .hybrid-features-strip{
    background:var(--surface-3); border-radius:var(--radius-lg); margin-top:18px;
    padding:22px 28px;
    display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:18px;
  }
  .hf-item{display:flex; align-items:center; gap:11px;}
  .hf-item svg{flex-shrink:0;}
  .hf-item span{font-size:16px; font-weight:700; color:var(--text-strong); line-height:1.35;}

/* ===== ABOUT PAGE: PAGE BANNER ===== */
  .page-banner{
    position:relative;
    background:linear-gradient(150deg, var(--charcoal-2) 0%, var(--charcoal) 100%);
    overflow:hidden;
    padding:var(--space-8) var(--space-6) 58px;
    text-align:center;
  }
  .page-banner::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 70% 70% at 50% 40%, black, transparent);
    pointer-events:none;
  }
  .page-banner-inner{position:relative; max-width:1280px; margin:0 auto;}
  .page-banner .eyebrow{justify-content:center; display:flex;}
  .page-banner h1{
    font-size:var(--text-5xl); color:#fff; letter-spacing:0.4px; margin-bottom:16px;
  }
  .page-banner h1 .accent{color:var(--red);}
  .breadcrumb{
    display:flex; justify-content:center; align-items:center; gap:10px;
    font-size:16px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px;
    font-weight:700;
  }
  .breadcrumb a{color:var(--off);}
  .breadcrumb a:hover{color:var(--red);}
  .breadcrumb .sep{color:var(--red); font-size:16px;}
  .breadcrumb .current{color:var(--red);}

  @media (max-width:760px){
    .page-banner{padding:var(--space-7) var(--space-5) 40px;}
    .page-banner h1{font-size:var(--text-3xl);}
  }
  @media (max-width:420px){
    .page-banner{padding:32px 16px 32px;}
    .page-banner h1{font-size:25px;}
    .breadcrumb{font-size:16px;}
  }

  /* ===== ABOUT PAGE: OUR STORY ===== */
  .story-section{background:var(--surface-0); padding:var(--space-8) var(--space-6) 0;}
  .story-inner{
    max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:1fr 0.95fr; gap:56px; align-items:center;
    padding-bottom:var(--space-8);
  }
  .story-content h2{
    font-size:var(--text-4xl); color:var(--text-strong); letter-spacing:0.3px; margin-bottom:18px; line-height:1.28;
  }
  .story-content h2 .accent{color:var(--red);}
  .story-content p{color:var(--text-muted); font-size:var(--text-base); line-height:1.85; margin-bottom:16px;}
  .story-image{
    position:relative; border-radius:var(--radius-lg); overflow:hidden; aspect-ratio:4/3.1;
    box-shadow:var(--shadow-4);
  }
  .story-image img{width:100%; height:100%; object-fit:cover; display:block;}

  .commit-strip{max-width:1280px; margin:0 auto; padding-bottom:var(--space-8);}

  @media (max-width:980px){
    .story-inner{grid-template-columns:1fr; gap:32px;}
    .story-image{order:-1;}
  }
  @media (max-width:600px){
    .story-section{padding:44px 20px 0;}
    .story-inner{padding-bottom:40px;}
    .commit-strip{padding-bottom:40px;}
    .story-content h2{font-size:24px;}
  }

  /* ===== ABOUT PAGE: STATS ===== */
  .stats-section{background:var(--charcoal);}
  .stats-inner{
    max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:repeat(4, 1fr);
  }
  .stat-card{
    padding:46px 20px; text-align:center;
    border-right:1px solid rgba(255,255,255,0.08);
  }
  .stat-card:last-child{border-right:none;}
  .stat-number{
    font-family:var(--font-display); font-weight:800;
    font-size:var(--text-5xl); color:var(--red); letter-spacing:0.4px; margin-bottom:8px;
  }
  .stat-label{
    color:var(--off); font-size:16px; text-transform:uppercase;
    letter-spacing:0.4px; font-weight:700;
  }
  @media (max-width:760px){
    .stats-inner{grid-template-columns:repeat(2, 1fr);}
    .stat-card{border-bottom:1px solid rgba(255,255,255,0.08);}
    .stat-card:nth-child(2n){border-right:none;}
  }
  @media (max-width:420px){
    .stats-inner{grid-template-columns:1fr;}
    .stat-card{border-right:none;}
  }

  /* ===== ABOUT PAGE: OUR JOURNEY ===== */
  .journey-section{background:var(--surface-1); padding:var(--space-8) var(--space-6);}
  .journey-inner{max-width:1280px; margin:0 auto;}
  .journey-header{text-align:center; margin-bottom:42px;}
  .journey-header h2{font-size:var(--text-4xl); color:var(--text-strong); letter-spacing:0.4px;}
  .journey-header h2 .accent{color:var(--red);}
  .journey-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:26px;}
  .journey-item{
    background:var(--surface-0); border-radius:var(--radius-lg); padding:30px 22px 26px; text-align:center;
    box-shadow:var(--shadow-2); border:1px solid var(--surface-border);
  }
  .journey-badge{
    width:44px; height:44px; border-radius:var(--radius-full); margin:0 auto 16px;
    background:linear-gradient(150deg, var(--red) 0%, var(--red-dark) 100%);
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-weight:800; font-size:16px; letter-spacing:0.3px;
  }
  .journey-item h3{font-size:16px; color:var(--text-strong); margin-bottom:8px; letter-spacing:0.2px; line-height:1.3;}
  .journey-item p{color:var(--text-muted); font-size:var(--text-xs); line-height:1.65;}

  @media (max-width:600px){
    .journey-section{padding:var(--space-7) var(--space-5);}
    .journey-header h2{font-size:var(--text-3xl);}
  }

  /* ===== ABOUT PAGE: LPG/CNG SPECIALTY HIGHLIGHT ===== */
  .gasconv-highlight-section{background:var(--surface-2); padding:var(--space-8) var(--space-6);}
  .gasconv-highlight-inner{max-width:1280px; margin:0 auto;}
  .gasconv-highlight-panel{
    background:linear-gradient(150deg, var(--charcoal) 0%, var(--charcoal) 100%);
    border:1.5px solid var(--red);
    border-radius:var(--radius-lg);
    padding:44px 44px;
    display:flex; align-items:center; justify-content:space-between; gap:32px;
    position:relative; overflow:hidden;
    box-shadow:var(--shadow-5);
  }
  .gasconv-highlight-panel::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:42px 42px;
    mask-image:radial-gradient(ellipse 65% 75% at 25% 50%, black, transparent);
    pointer-events:none;
  }
  .gasconv-highlight-text{position:relative; max-width:620px;}
  .gasconv-highlight-eyebrow{
    color:var(--green); font-size:16px; font-weight:800; letter-spacing:3px; margin-bottom:10px;
  }
  .gasconv-highlight-text h2{font-size:var(--text-3xl); color:#fff; margin-bottom:12px; letter-spacing:0.3px; line-height:1.3;}
  .gasconv-highlight-text h2 .accent{color:var(--red);}
  .gasconv-highlight-text p{color:var(--off); font-size:16px; line-height:1.75;}
  .gasconv-highlight-actions{
    position:relative; flex-shrink:0; display:flex; flex-direction:column; gap:12px;
  }
  .gasconv-highlight-actions .btn{justify-content:center; white-space:nowrap;}

  @media (max-width:900px){
    .gasconv-highlight-panel{flex-direction:column; text-align:center;}
    .gasconv-highlight-text{max-width:none;}
    .gasconv-highlight-actions{width:100%;}
  }
  @media (max-width:600px){
    .gasconv-highlight-section{padding:var(--space-7) var(--space-5);}
    .gasconv-highlight-panel{padding:32px 24px;}
    .gasconv-highlight-text h2{font-size:var(--text-2xl);}
  }

  /* ===== ABOUT PAGE: SERVICES RECAP (reuses .services-grid / .service-card) =====
     .services-recap-section/.inner/.header/.services-grid/.service-card were
     previously declared twice in this file for the one "What We Do" grid
     below — the simpler first copy and this fuller one always resolved to
     the same section, so they're merged into a single declaration here. */
  .services-recap-section{background:var(--surface-1); padding:var(--space-8) var(--space-6);}
  .services-recap-inner{max-width:1280px; margin:0 auto;}
  .services-recap-header{text-align:center; margin-bottom:42px;}
  .services-recap-header h2{font-size:var(--text-4xl); color:var(--text-strong); letter-spacing:0.4px;}
  .services-recap-header h2 .accent{color:var(--red);}

/* ================================
   SERVICES GRID
================================ */

.services-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));
  gap:20px;
}

/* ================================
   SERVICE CARD
================================ */

.service-card{
  overflow:hidden;
}

/* ================================
   HIDDEN SERVICE CARDS
   5th + 6th cards
================================ */

.services-grid .service-card:nth-child(n + 5){
  opacity:0;
  visibility:hidden;

  max-height:0;

  overflow:hidden;

  transform:translateY(-20px);

  margin-top:0;
  margin-bottom:0;

  pointer-events:none;

  transition:
    opacity .65s ease,
    transform .65s ease,
    max-height .75s ease,
    visibility 0s linear .75s;
}

/* ================================
   SHOW ALL SERVICES
================================ */

.services-grid.show-all .service-card:nth-child(n + 5){
  opacity:1;
  visibility:visible;

  max-height:700px;

  transform:translateY(0);

  pointer-events:auto;

  transition:
    opacity .65s ease,
    transform .65s ease,
    max-height .75s ease,
    visibility 0s linear 0s;
}

/* ================================
   BUTTON AREA
================================ */

.services-recap-cta{
  text-align:center;
  margin-top:40px;
}

.services-recap-cta .btn-learn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  cursor:pointer;

  border:none;
  font:inherit;
}

/* ================================
   BUTTON ARROW
================================ */

.services-recap-cta .btn-learn .btn-arrow{
  flex-shrink:0;

  transition:
    transform .45s ease;
}

/* ================================
   ARROW HOVER
================================ */

.services-recap-cta .btn-learn:hover .btn-arrow{
  transform:translateX(4px);
}

/* ================================
   SHOW ALL ARROW
================================ */

.services-grid.show-all
~ .services-recap-cta
.btn-arrow{
  transform:rotate(180deg);
}

/* ================================
   RESPONSIVE
================================ */

@media (max-width:600px){
  .services-grid{gap:18px;}
  .services-recap-header{margin-bottom:30px;}
  .services-recap-cta{margin-top:30px;}
  .services-recap-section{padding:var(--space-7) var(--space-5);}
  .services-recap-header h2{font-size:var(--text-3xl);}
}

  /* ===== ABOUT PAGE: TEAM ===== */
  .team-section{background:var(--surface-0); padding:var(--space-8) var(--space-6);}
  .team-inner{max-width:1280px; margin:0 auto;}
  .team-header{text-align:center; margin-bottom:42px;}
  .team-header h2{font-size:var(--text-4xl); color:var(--text-strong); letter-spacing:0.4px;}
  .team-header h2 .accent{color:var(--red);}
  .team-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); gap:26px;}
  .team-card{
    background:var(--surface-1); border-radius:var(--radius-lg); overflow:hidden; text-align:center;
    padding:38px 20px 32px; box-shadow:var(--shadow-2); border:1px solid var(--surface-border);
  }
  .team-avatar{
    width:84px; height:84px; border-radius:var(--radius-full); margin:0 auto 18px;
    background:linear-gradient(150deg, var(--red) 0%, var(--red-dark) 100%);
    display:flex; align-items:center; justify-content:center;
  }
  .team-card h3{font-size:16px; color:var(--text-strong); margin-bottom:6px; letter-spacing:0.2px;}
  .team-card p{color:var(--red); font-size:16px; font-weight:800; text-transform:uppercase; letter-spacing:0.4px;}
  .team-card p.team-bio{
    color:var(--text-muted); font-size:var(--text-xs); font-weight:400;
    text-transform:none; letter-spacing:0;
    line-height:1.6; margin-top:10px;
  }
  .team-exp{
    display:inline-block; margin-top:12px; background:var(--surface-3); color:var(--text-strong);
    font-size:16px; font-weight:700; padding:5px 12px; border-radius:var(--radius-full);
    letter-spacing:0.2px;
  }

  @media (max-width:600px){
    .team-section{padding:var(--space-7) var(--space-5);}
    .team-header h2{font-size:var(--text-3xl);}
  }

  /* ===== ABOUT PAGE: CTA ===== */
  .about-cta-section{
    position:relative; overflow:hidden;
    background:linear-gradient(135deg, var(--charcoal-2) 0%, var(--charcoal) 100%);
    padding:var(--space-8) var(--space-6); text-align:center;
  }
  .about-cta-section::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:40px 40px;
    mask-image:radial-gradient(ellipse 70% 80% at 50% 40%, black, transparent);
  }
  .about-cta-inner{position:relative; max-width:760px; margin:0 auto;}
  .about-cta-inner h2{color:#fff; font-size:var(--text-3xl); margin-bottom:14px; letter-spacing:0.3px;}
  .about-cta-inner p{color:var(--muted); font-size:16px; margin-bottom:16px; line-height:1.75;}
  .about-cta-address{
    display:flex; align-items:center; justify-content:center; gap:8px;
    color:var(--off); font-size:16px; margin-bottom:28px; line-height:1.5; flex-wrap:wrap;
  }
  .about-cta-actions{display:flex; gap:14px; flex-wrap:wrap; justify-content:center;}

  @media (max-width:600px){
    .about-cta-section{padding:var(--space-7) var(--space-5);}
    .about-cta-inner h2{font-size:var(--text-2xl);}
  }
</style>

<section class="page-banner">
  <div class="page-banner-inner">
    <div class="eyebrow reveal">GET TO KNOW US</div>
    <h1 class="display reveal">ABOUT <span class="accent">TAQWA AUTOMOBILE</span></h1>
    <div class="breadcrumb reveal">
      <a href="index.html">Home</a>
      <span class="sep">»</span>
      <span class="current">About Us</span>
    </div>
  </div>
</section>

<section class="story-section">
  <div class="story-inner">
    <div class="story-content reveal">
      <div class="eyebrow">WHO WE ARE</div>
      <h2 class="display" style="letter-spacing:0.3px; text-transform:none;">Trusted <span class="accent">Automobile Care</span> in the Heart of Uttara</h2>
      <p>Taqwa Automobile Service Center was built on a simple idea: every car owner deserves honest advice, careful workmanship and fair pricing. From LPG &amp; CNG conversion to full engine diagnostics, our workshop in Diabari, Uttara has become a trusted stop for drivers across Dhaka.</p>
      <p>Our technicians are trained on the latest conversion kits and diagnostic equipment, and every job — big or small — is carried out with the same attention to safety and detail. We don't just fix cars; we build long-term relationships with the people who drive them.</p>
      <p>Whether you need a routine service, an emergency roadside rescue, or a complete gas conversion, our team treats your vehicle like it's our own.</p>
    </div>
    <div class="story-image reveal">
      <img loading="lazy" decoding="async" class="lazy-fade" onload="this.classList.add('is-loaded')" src={base + "img/about-1.jpg"} alt="Inside Taqwa Automobile's workshop">
    </div>
  </div>

  <div class="commit-strip">
    <div class="hybrid-features-strip">
      <div class="hf-item reveal">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.5"/><path d="M8 12.5l2.5 2.5L16 9" stroke="#F97316" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Certified &amp; Trained Technicians</span>
      </div>
      <div class="hf-item reveal">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.5"/><path d="M8 12.5l2.5 2.5L16 9" stroke="#F97316" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>100% Genuine Parts Guarantee</span>
      </div>
      <div class="hf-item reveal">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.5"/><path d="M8 12.5l2.5 2.5L16 9" stroke="#F97316" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>No Hidden Charges</span>
      </div>
      <div class="hf-item reveal">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.5"/><path d="M8 12.5l2.5 2.5L16 9" stroke="#F97316" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>24/7 Emergency Roadside Support</span>
      </div>
    </div>
  </div>
  
</section>

<section class="journey-section">
  <div class="journey-inner">
    <div class="journey-header reveal">
      <h2 class="display" style="letter-spacing:0.4px;">OUR <span class="accent">JOURNEY</span></h2>
    </div>

    <div class="journey-grid">
      <div class="journey-item">
        <div class="journey-badge">01</div>
        <h3>Humble Beginnings</h3>
        <p>Taqwa Automobile started as a small workshop in Uttara with one goal: honest, reliable car care for the local community.</p>
      </div>

      <div class="journey-item">
        <div class="journey-badge">02</div>
        <h3>Growing Our Expertise</h3>
        <p>As demand grew, we expanded into full engine diagnostics, AC service, wheel alignment and complete periodic maintenance.</p>
      </div>

      <div class="journey-item">
        <div class="journey-badge">03</div>
        <h3>Becoming Gas Conversion Specialists</h3>
        <p>We invested in certified LPG &amp; CNG conversion equipment and specialist training, making safe, fuel-saving gas conversion our core specialty.</p>
      </div>

      <div class="journey-item">
        <div class="journey-badge">04</div>
        <h3>Trusted Across Dhaka</h3>
        <p>Today, with 5,000+ vehicles serviced and a 15-member technician team, we're a trusted name for automobile and gas conversion service.</p>
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="stats-inner">
    <div class="stat-card reveal">
      <div class="stat-number" data-target="10" data-suffix="+">10+</div>
      <div class="stat-label">Years of Experience</div>
    </div>
    <div class="stat-card reveal">
      <div class="stat-number" data-target="5000" data-suffix="+">5,000+</div>
      <div class="stat-label">Vehicles Serviced</div>
    </div>
    <div class="stat-card reveal">
      <div class="stat-number" data-target="15" data-suffix="+">15+</div>
      <div class="stat-label">Certified Technicians</div>
    </div>
    <div class="stat-card reveal">
      <div class="stat-number" data-target="100" data-suffix="%">100%</div>
      <div class="stat-label">Genuine Parts</div>
    </div>
  </div>
</section>

<section class="gasconv-highlight-section">
  <div class="gasconv-highlight-inner">
    <div class="gasconv-highlight-panel reveal">
      <div class="gasconv-highlight-text">
        <div class="gasconv-highlight-eyebrow">OUR CORE SPECIALTY</div>
        <h2 class="display" style="text-transform:none; letter-spacing:0.3px;">LPG <span class="accent">&amp;</span> CNG Conversion Experts</h2>
        <p>Automobile servicing is what we do — but gas conversion is what we do best. Every LPG and CNG installation at Taqwa Automobile is handled by our dedicated specialist team, using certified kits and rigorous safety checks, backed by a 2 year service warranty.</p>
      </div>
      <div class="gasconv-highlight-actions">
        <a href="index.html#gas-conversion" class="btn btn-red">See Our Conversion Process</a>
        <a href="tel:+8801854226757" class="btn btn-green">
          <svg class="icon" width="15" height="15"><use href="#icon-phone"/></svg>
          Call For Consultation
        </a>
      </div>
    </div>
  </div>
