---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

// First real article page on the site. The blog index (blog.astro) lists twelve
// posts; this is the one that has an actual page behind it, so its card there
// links here while the remaining eleven stay unlinked until they are written.
const headline = 'LPG vs CNG: Which Conversion Is Right for Your Car?';
const description =
  'LPG or CNG for your car in Dhaka? Compare running cost, boot space, power, refuelling and engine wear to pick the right conversion for how you actually drive.';
const published = '2026-08-15';
const publishedLabel = 'August 15, 2026';
---

<Layout
  title="LPG vs CNG: Which Is Right for Your Car? - Taqwa Automobile"
  description={description}
  path="lpg-vs-cng.html"
  current="blog"
  ogImage="/img/latest-1.jpg"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": headline,
    "description": description,
    "image": "https://taqwa.autos/img/latest-1.jpg",
    "datePublished": published,
    "dateModified": published,
    "inLanguage": "en",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://taqwa.autos/lpg-vs-cng.html"
    },
    "author": {
      "@type": "Organization",
      "name": "Taqwa Automobile Service Center",
      "url": "https://taqwa.autos"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Taqwa Automobile Service Center",
      "logo": {
        "@type": "ImageObject",
        "url": "https://taqwa.autos/img/logo.png"
