          </div>
        </div>

      </div>
    </div>

    <div class="news-nav">
      <button class="news-nav-btn" id="newsPrev" aria-label="Previous news">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="news-nav-btn" id="newsNext" aria-label="Next news">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

  </div>
</section>


<script>
  // ===== FEATURES CARD IMAGE SWAP (+ auto-rotate every 3s) =====
  (function(){
    var cards = Array.prototype.slice.call(document.querySelectorAll('#featCardGrid .feat-card'));
    var img = document.getElementById('featImage');
    var caption = document.getElementById('featCaption');
    if (!cards.length || !img || !caption) return;

    var activeIndex = cards.findIndex(function(c){ return c.classList.contains('active'); });
    if (activeIndex < 0) activeIndex = 0;
    var rotateTimer = null;
    var ROTATE_MS = 3000;

    // Single source of truth for "which card is active" so the card highlight,
    // the right-side image and the caption can never fall out of sync, and only
    // ever one card carries the active/highlighted state at a time.
    function activate(index){
      activeIndex = index;
      var card = cards[activeIndex];

      cards.forEach(function(c){ c.classList.remove('active'); });
      card.classList.add('active');

      var newSrc = card.getAttribute('data-img');
      var newLabel = card.getAttribute('data-label');

      img.style.opacity = '0';
      caption.classList.remove('show');
      setTimeout(function(){
        img.setAttribute('src', newSrc);
        caption.textContent = newLabel;
        img.style.opacity = '1';
        caption.classList.add('show');
      }, 300);
    }

    function startRotation(){
      stopRotation();
      rotateTimer = setInterval(function(){
        activate((activeIndex + 1) % cards.length);
      }, ROTATE_MS);
    }
    function stopRotation(){
      if (rotateTimer){ clearInterval(rotateTimer); rotateTimer = null; }
    }

    cards.forEach(function(card, index){
      card.addEventListener('click', function(){
        if (index === activeIndex) return;
        activate(index);
        startRotation(); // restart the 3s cycle from the manually chosen card
      });
    });

    // Pause on hover/focus so a reader isn't fighting the auto-advance, resume after.
    var grid = document.getElementById('featCardGrid');
    grid.addEventListener('mouseenter', stopRotation);
    grid.addEventListener('mouseleave', startRotation);
    grid.addEventListener('focusin', stopRotation);
    grid.addEventListener('focusout', startRotation);

    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion){
      startRotation();
    }
  })();

  // ===== NEWS CAROUSEL =====
  (function(){
    var carousel = document.getElementById('newsCarousel');
    var track = document.getElementById('newsTrack');
    var prevBtn = document.getElementById('newsPrev');
    var nextBtn = document.getElementById('newsNext');
    if (!carousel || !track || !prevBtn || !nextBtn) return;
    var cards = track.querySelectorAll('.news-card');
    var gap = 28;

    function visibleCount(){
      var w = window.innerWidth;
      if (w >= 1024) return 3;
      if (w >= 640) return 2;
      return 1;
    }

    function sizeCards(){
      var vc = visibleCount();
      gap = window.innerWidth <= 640 ? 18 : 28;
      var cardWidth = (carousel.clientWidth - gap * (vc - 1)) / vc;
      cards.forEach(function(card){
        card.style.flex = '0 0 ' + cardWidth + 'px';
        card.style.width = cardWidth + 'px';
      });
      track.style.gap = gap + 'px';
      updateButtons();
    }

    function updateButtons(){
      var maxScroll = track.scrollWidth - carousel.clientWidth - 2;
      prevBtn.disabled = carousel.scrollLeft <= 2;
      nextBtn.disabled = carousel.scrollLeft >= maxScroll;
    }

    function scrollByOneCard(direction){
      var card = cards[0];
      var step = card.getBoundingClientRect().width + gap;
      carousel.scrollBy({left: direction * step, behavior: 'smooth'});
    }

    prevBtn.addEventListener('click', function(){ scrollByOneCard(-1); });
    nextBtn.addEventListener('click', function(){ scrollByOneCard(1); });
    carousel.addEventListener('scroll', updateButtons);
    window.addEventListener('resize', sizeCards);

    sizeCards();
  })();
</script>
</Layout>
