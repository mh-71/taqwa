        <div class="cf-item">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" stroke="#F97316" stroke-width="1.4" stroke-linejoin="round"/></svg>
          Wax &amp; Polish Protection
        </div>
        <div class="cf-item">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#F97316" stroke-width="1.5"/><line x1="12" y1="12" x2="16.5" y2="7.3" stroke="#F97316" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="1.7" fill="#F97316"/></svg>
          Dashboard Polishing
        </div>
        <div class="cf-item">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M13 2L4.5 13.5H11l-1.3 8L18.5 9.5H12z" stroke="#F97316" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/></svg>
