---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const description = "Taqwa Automobile Service Center in Uttara, Dhaka offers LPG & CNG conversion, engine repair, hybrid vehicle service, car AC service, and car wash & detailing — trusted technicians, genuine parts, quality service.";
---

<Layout
  title="Taqwa Automobile Service Center"
  description={description}
  path=""
  current="home"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "AutoRepair",
    "name": "Taqwa Automobile Service Center",
    "image": "https://taqwa.autos/img/logo.png",
    "@id": "https://taqwa.autos",
    "url": "https://taqwa.autos",
    "telephone": "+8801854226757",
    "email": "mosharrafhossen090@gmail.com",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Sector # 15, Block # C, Road # 3/A, Plot # 40, Diabari",
      "addressLocality": "Uttara",
      "addressRegion": "Dhaka",
      "addressCountry": "BD"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Saturday","Sunday","Monday","Tuesday","Wednesday","Thursday"],
        "opens": "09:00",
        "closes": "20:00"
      }
    ],
    "sameAs": [
      "https://www.facebook.com/",
      "https://www.youtube.com/",
      "https://www.instagram.com/"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "186"
    },
    "makesOffer": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "LPG Conversion" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "CNG Conversion" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Engine Repair" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Car AC Service" } }
    ]
  }}
>

<style define:vars={{ heroBg: `url(${base}img/hero-background.jpg)` }}>
  /* Overrides global.css's .hero background so the hero image URL is
     base-path-aware (global.css is a plain imported stylesheet and can't
     use Astro's define:vars itself). Gradient values match global.css exactly. */
  .hero{
    background:
      linear-gradient(rgba(16,19,24,0.65), rgba(16,19,24,0.75)),
      var(--heroBg) center/cover no-repeat;
  }
</style>

