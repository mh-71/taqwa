---
const base = import.meta.env.BASE_URL;
// `current` selects which top-level nav item gets the .active treatment.
// Matches the `id`s used below: 'home' | 'about' | 'services' | 'hybrid' |
// 'gallery' | 'blog' | 'contact'. Services sub-pages (LPG, CNG, engine
// repair, car AC, car wash) all pass current="services" so the parent
// "Services" nav item highlights, matching the original site's behavior.
interface Props {
  current?: string;
  /** Bilingual blog only: {href, label} for a small "switch language" link
   *  (e.g. English blog pages pass {href: "bn/blog.html", label: "বাংলা"}).
   *  Omitted (undefined) everywhere else, so the header is unchanged on
   *  every non-blog page. */
  langToggle?: { href: string; label: string } | null;
  /** Blog translation: show language toggle instead of CALL NOW on blog pages */
  showBlogLanguageToggle?: boolean;
  currentBlogLanguage?: 'en' | 'bn';
}
const { current = '', langToggle = null, showBlogLanguageToggle = false, currentBlogLanguage = 'en' } = Astro.props;
const isActive = (id: string) => (current === id ? 'active' : '');
---

<header>
  <div class="header-inner">
    <a href={base + "index.html"} class="logo" aria-label="Taqwa Automobile - Home">
      <img class="logo-img" src={base + "img/logo.png"} width="1555" height="593" alt="Taqwa Automobile">
    </a>

    <nav class="main-nav">
      <ul>
        <li class={isActive('home')}>
          <a href={base + "index.html"}>Home</a>
        </li>

        <li class={isActive('about')}>
          <a href={base + "about.html"}>About Us</a>
        </li>

        <li class:list={['has-dropdown', isActive('services')]} id="servicesDropdown">
          <a href={base + "index.html#services"} id="servicesNavTrigger" aria-haspopup="true" aria-expanded="false">Services <svg class="caret" width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <ul class="dropdown-menu" aria-label="Services">
            <li><a href={base + "lpg-conversion.html"}>LPG Conversion</a></li>
            <li><a href={base + "cng-conversion.html"}>CNG Conversion</a></li>
            <li><a href={base + "engine-repair.html"}>Engine Repair</a></li>
            <li><a href={base + "car-ac-service.html"}>Car AC Service</a></li>
            <li><a href={base + "index.html#services"}>Battery &amp; Electrical</a></li>
            <li><a href={base + "index.html#services"}>Wheel Alignment &amp; Balancing</a></li>
            <li><a href={base + "car-wash-detailing.html"}>Car Wash &amp; Detailing</a></li>
            <li><a href={base + "index.html#services"}>Periodic Maintenance</a></li>
          </ul>
        </li>

        <li class={isActive('hybrid')}>
          <a href={base + "hybrid-services.html"}>Hybrid Services</a>
        </li>

        <li class={isActive('gallery')}>
          <a href={base + "gallery.html"}>Gallery</a>
        </li>

        <li class={isActive('blog')}>
          <a href={base + "blog.html"}>Blog</a>
        </li>

        <li class={isActive('contact')}>
          <a href={base + "contact.html"}>Contact Us</a>
        </li>
      </ul>
    </nav>

    {showBlogLanguageToggle ? (
      <button id="blogLangToggle" class="blog-lang-toggle-btn" data-current-lang={currentBlogLanguage}>
        {currentBlogLanguage === 'en' ? '[ বাংলা ]' : '[ English ]'}
      </button>
    ) : langToggle ? (
      <a href={base + langToggle.href} class="lang-toggle-btn">{langToggle.label}</a>
    ) : (
      <a href="tel:+8801854226757" class="call-btn">
        <svg class="icon" width="15" height="15"><use href="#icon-phone"/></svg>
        <span class="txt">Call Now</span>
      </a>
    )}

    <button class="hamburger" id="hamburgerBtn" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobileNav">
    <ul>
      <li class={isActive('home')}>
        <a href={base + "index.html"}>Home</a>
      </li>

      <li class={isActive('about')}>
        <a href={base + "about.html"}>About Us</a>
      </li>

      <li class:list={['mobile-has-sub', isActive('services')]} id="mobileServicesItem">
        <button class="mobile-sub-toggle" id="mobileServicesToggle" aria-expanded="false">
          Services <svg class="caret" width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <ul class="mobile-submenu">
          <li><a href={base + "lpg-conversion.html"}>LPG Conversion</a></li>
          <li><a href={base + "cng-conversion.html"}>CNG Conversion</a></li>
          <li><a href={base + "engine-repair.html"}>Engine Repair</a></li>
          <li><a href={base + "car-ac-service.html"}>Car AC Service</a></li>
          <li><a href={base + "index.html#services"}>Battery &amp; Electrical</a></li>
          <li><a href={base + "index.html#services"}>Wheel Alignment &amp; Balancing</a></li>
          <li><a href={base + "car-wash-detailing.html"}>Car Wash &amp; Detailing</a></li>
          <li><a href={base + "index.html#services"}>Periodic Maintenance</a></li>
        </ul>
      </li>

      <li class={isActive('hybrid')}>
        <a href={base + "hybrid-services.html"}>Hybrid Services</a>
      </li>

      <li class={isActive('gallery')}>
        <a href={base + "gallery.html"}>Gallery</a>
      </li>

      <li class={isActive('blog')}>
        <a href={base + "blog.html"}>Blog</a>
      </li>

      <li class={isActive('contact')}>
        <a href={base + "contact.html"}>Contact Us</a>
      </li>

      {langToggle && (
        <li><a href={base + langToggle.href}>{langToggle.label}</a></li>
      )}
    </ul>
  </div>
</header>

<script>
  // Language switch for the bilingual blog. It lives here, next to the button,
  // so it works on every page that renders one - the blog listing as well as a
  // post - instead of only where a page happened to duplicate the handler.
  //
  // It swaps #page-content in place rather than reloading: a reload threw a
  // reader halfway down an article back to the top, and flashed a blank page on
  // the way. Reloading is still the fallback for anything unexpected, and it
  // carries the reading position across as a fraction of the page - the same
  // article is a different height in each language, so a pixel offset lands in
  // the wrong paragraph and drifts further the longer the post.
  (function () {
    var SCROLL_KEY = 'taqwa:lang-switch-scroll';
    var LABEL = { en: '[ বাংলা ]', bn: '[ English ]' };
    var BUSY_LABEL = { bn: 'অনুবাদ হচ্ছে…', en: 'Translating…' };

    function maxScroll() {
      return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    }

    // Restore after a fallback reload, and only once: the key is cleared as it
    // is read, so an ordinary visit to the same page still starts at the top.
    try {
      var saved = sessionStorage.getItem(SCROLL_KEY);
      if (saved !== null) {
        sessionStorage.removeItem(SCROLL_KEY);
        var ratio = parseFloat(saved);
        if (ratio > 0) {
          // Wait for load, not DOMContentLoaded: images above the reader have
          // no height until then, so the page is not yet as tall as it will be
          // and the fraction would resolve too far down.
          window.addEventListener('load', function () {
            window.scrollTo(0, Math.round(ratio * maxScroll()));
          });
        }
      }
    } catch (e) {
      // sessionStorage throws in private mode - the switch still works, it
      // just starts at the top.
    }

    var btn = document.getElementById('blogLangToggle');
    if (!btn) return;

    function reloadInstead(url) {
      try {
        var max = maxScroll();
        sessionStorage.setItem(SCROLL_KEY, String(max > 0 ? window.scrollY / max : 0));
      } catch (e) {
        /* nothing to do - the page just opens at the top */
      }
      window.location.href = url;
    }

    var busy = false;
    btn.addEventListener('click', function () {
      if (busy) return;
      var next = btn.getAttribute('data-current-lang') === 'en' ? 'bn' : 'en';
      // Rewrite only ?lang= so a search or category filter on the listing
      // survives the switch.
      var url = new URL(window.location.href);
      url.searchParams.set('lang', next);
      var href = url.toString();

      var content = document.getElementById('page-content');
      if (!content || !window.fetch || !window.DOMParser || !window.history.pushState) {
        reloadInstead(href);
        return;
      }

      // A post with no stored translation is translated on this request, which
      // takes a few seconds the first time - say so rather than looking stuck.
      busy = true;
      btn.disabled = true;
      btn.textContent = BUSY_LABEL[next];
      content.classList.add('is-swapping');

      fetch(href, { credentials: 'same-origin' })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.text();
        })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var fresh = doc.getElementById('page-content');
          if (!fresh) throw new Error('no #page-content in response');

          content.innerHTML = fresh.innerHTML;
          // The scroll-reveal observer and the lazy-load fade both run once, at
          // first load, so anything swapped in would sit at opacity 0 forever.
          // It is already on screen, so show it outright.
          content.querySelectorAll('.reveal').forEach(function (el) {
            el.classList.add('is-visible');
          });
          content.querySelectorAll('img.lazy-fade').forEach(function (el) {
            el.classList.add('is-loaded');
          });

          if (doc.title) document.title = doc.title;
          document.documentElement.setAttribute('lang', next);
          window.history.pushState({ lang: next }, '', href);

          btn.setAttribute('data-current-lang', next);
          var freshBtn = doc.getElementById('blogLangToggle');
          btn.textContent = freshBtn ? freshBtn.textContent : LABEL[next];
        })
        .catch(function () {
          // Anything unexpected - offline, a slow Worker, markup we did not
          // expect - falls back to the plain navigation, which always works.
          reloadInstead(href);
        })
        .then(function () {
          busy = false;
          btn.disabled = false;
          content.classList.remove('is-swapping');
        });
    });

    // Back/forward across a switch: the content came from fetch, so the browser
    // has nothing to restore - let it re-render the URL it just moved to.
    window.addEventListener('popstate', function () {
      window.location.reload();
    });
  })();
</script>
