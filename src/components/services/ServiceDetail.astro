---
// Shared page body for the "single service landing page" template used by
// Car AC Service, Car Wash & Detailing, CNG Conversion and Engine Repair.
//
// This component holds the markup AND the <style> block that used to be
// duplicated verbatim (~1,192 lines each, byte-for-byte identical) across
// those four .astro page files. The four page files now just pick a
// ServicePageData object from src/data/servicePages.ts and pass it here as
// `service` — the CSS and markup below are copied unchanged from the
// original pages, just parameterized by that data instead of hardcoded
// per file.
import type { ServicePageData } from '../../data/servicePages';

interface Props {
  service: ServicePageData;
}

const { service } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<style define:vars={{ heroBg: `url(${base}img/hero-background.jpg)` }}>
  /* This component's own :root{...} token block was removed here: Astro
     scopes component <style> blocks to the elements that component's own
     template renders, and :root (<html>) is never one of them (it belongs
     to Layout.astro), so this redeclaration was already inert — global.css's
     :root (loaded on every page) was the only one ever actually applying. */
  body{
    font-family: 'Inter', "Segoe UI", Arial, sans-serif;
    background:var(--charcoal);
    color:var(--off);
    -webkit-font-smoothing:antialiased;
  }
  .display{
    font-family: 'Poppins', "Arial Narrow", Arial, sans-serif;
    font-weight:800;
    letter-spacing:0.5px;
    text-transform:uppercase;
  }

/* ===== HEADER ===== */
  header{
    background:var(--paper);
    border-bottom:1px solid #EAEDF2;
    position:sticky; top:0; z-index:50;
  }

nav.main-nav{display:flex; align-items:center; gap:30px;}
  nav.main-nav > ul{display:flex; align-items:center; gap:26px;}
  nav.main-nav a{
    font-size:16px; font-weight:700; letter-spacing:0.4px;
    color:var(--ink); text-transform:uppercase; position:relative; padding:6px 0;
    display:flex; align-items:center; gap:4px;
  }

/* dropdown */

.dropdown-menu{
    position:absolute; top:100%; left:-18px; margin-top:14px;
    background:#F8FAFC; min-width:220px; border-radius:4px;
    box-shadow:0 18px 40px -12px rgba(0,0,0,0.25); border:1px solid #EAEDF2;
    padding:8px; opacity:0; visibility:hidden; transform:translateY(6px);
    transition:opacity .15s ease, transform .15s ease, visibility .15s;
    z-index:60;
  }
  
  .dropdown-menu::before{
    content:""; position:absolute; top:-6px; left:28px;
    width:12px; height:12px; background:#F8FAFC; border-left:1px solid #EAEDF2; border-top:1px solid #EAEDF2;
    transform:rotate(45deg);
  }
  
  .dropdown-menu a{
    display:block; padding:10px 12px; font-size:16px; font-weight:700;
    text-transform:none; letter-spacing:0.2px; color:var(--ink);
    border-radius:3px; white-space:nowrap;
  }
  .dropdown-menu a:hover{background:#EEF1F6; color:var(--red);}
  .call-btn{
    background:var(--red); color:#fff; font-size:16px; font-weight:700;
    letter-spacing:0.4px; padding:11px 22px; border-radius:3px;
    display:flex; align-items:center; gap:8px; text-transform:uppercase;
    white-space:nowrap;
  }

.hamburger span{
    width:24px; height:2px; background:var(--charcoal); display:block;
    transition:transform .2s ease, opacity .2s ease;
  }

/* ===== MOBILE NAV DRAWER ===== */
  .mobile-nav{
    display:none; background:#F8FAFC; border-top:1px solid #EAEDF2;
  }

.mobile-nav > ul > li > a{
    display:flex; align-items:center; padding:14px 2px;
    font-size:16px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase;
    color:var(--ink);
  }
  
  .mobile-sub-toggle{
    display:flex; align-items:center; justify-content:space-between; width:100%;
    background:none; text-align:left; padding:14px 2px;
    font-size:16px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase;
    color:var(--ink); font-family:inherit;
  }

/* ===== HERO ===== */
  .hero{
  position:relative;
  background:
    linear-gradient(rgba(16,19,24,0.65), rgba(16,19,24,0.75)),
    var(--heroBg) center/cover no-repeat;
  overflow:hidden;
  padding:64px 32px 48px;
}

.hero-copy h1{
    font-size:52px; line-height:1.06; color:#fff; margin-bottom:18px;
  }
  
  .hero-sub{
    font-family:'Poppins', "Arial Narrow", Arial, sans-serif; font-weight:700;
    letter-spacing:1.5px; text-transform:uppercase; color:var(--off);
    font-size:16px; margin-bottom:18px;
  }
  .hero-copy p{
    color:var(--muted); font-size:16px; line-height:1.7; max-width:480px; margin-bottom:28px;
  }
  
  .btn{
    display:flex; align-items:center; gap:9px; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px 26px; border-radius:3px;
  }

/* ===== SPECIALIST INFO CARD ===== */
  .specialist-card{
    background:var(--charcoal);
    border:1.5px solid var(--red);
    border-radius:4px;
    position:relative;
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.7), 0 0 40px -10px rgba(249,115,22,0.15);
    padding:30px 28px 28px;
  }

.get-direction{
    width:100%; background:#F8FAFC; color:var(--ink); font-size:16px; font-weight:800;
    letter-spacing:0.6px; text-transform:uppercase; padding:15px; border-radius:3px;
    display:flex; align-items:center; justify-content:center; gap:8px;
  }

/* ===== RESPONSIVE ===== */
  @media (max-width:980px){

.hero-copy h1{font-size:40px;}
    nav.main-nav > ul{display:none;}
    .hamburger{display:flex;}
    .call-btn{display:none;}
    
  }

/* ===== FOOTER ===== */

.footer-social a{
    width:32px; height:32px; border-radius:50%; background:var(--charcoal-2);
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--line);
  }

.fhead::after{
    content:""; position:absolute; left:0; bottom:0; width:100%; height:3px;
    background:var(--red); border-radius:2px;
  }

.fcallnow{
    display:flex; align-items:center; justify-content:center; gap:9px;
    background:var(--red); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px; border-radius:3px;
    margin-top:22px;
  }
  
  .fwhatsapp{
    display:flex; align-items:center; justify-content:center; gap:9px;
    background:var(--green); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:14px; border-radius:3px;
    margin-top:14px;
  }

/* ===== CAR WASH & DETAILING ===== */
  .carwash-section{
    background:#F1F3F7;
    padding:56px 32px;
  }
  .carwash-inner{
    max-width:1280px; margin:0 auto;
    display:grid; grid-template-columns:1.5fr 1.15fr 0.65fr;
    border-radius:6px; overflow:hidden;
    box-shadow:0 20px 50px -20px rgba(0,0,0,0.25);
  }

/* middle content panel */
  .carwash-content{
    background:#F8FAFC;
    padding:40px 40px;
    display:flex; flex-direction:column; justify-content:center;
  }
  .carwash-content h2{
    font-size:26px; color:var(--ink); margin-bottom:14px; letter-spacing:0.3px;
  }
  
  .carwash-content > p{
    font-size:16px; line-height:1.75; color:#5a5a5e; max-width:420px; margin-bottom:26px;
  }
  
  .carwash-features .cf-item{
    display:flex; align-items:center; gap:10px;
    font-size:16px; font-weight:700; color:var(--ink);
  }

/* right CTA panel */

.carwash-cta .car-icon{margin-bottom:16px;}

.carwash-book-btn{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--red); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.4px; text-transform:uppercase; padding:12px 18px; border-radius:3px;
    white-space:nowrap;
  }

/* ===== OUR SERVICES ===== */
  .services-section{
    background:#F8FAFC;
    padding:64px 32px;
  }

.services-header h2{
    font-size:30px; color:var(--ink); letter-spacing:0.4px;
  }

.section-divider .bar{width:70px; height:3px; background:var(--red); border-radius:2px;}

.service-card{
    background:var(--charcoal); border-radius:4px; overflow:hidden;
    display:flex; flex-direction:column;
    box-shadow:0 14px 34px -18px rgba(0,0,0,0.35);
  }

.service-card .body{
    position:relative; overflow:hidden;
    background:var(--charcoal); padding:24px 22px 26px; text-align:center;
    flex:1 1 auto; display:flex; flex-direction:column; justify-content:center;
  }

.services-toggle-btn{
    display:inline-flex; align-items:center; gap:10px;
    background:var(--charcoal); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.5px; text-transform:uppercase; padding:14px 30px; border-radius:3px;
  }

@media (max-width:1024px){
    
    .services-section{padding:48px 20px;}
    .services-header h2{font-size:24px;}
  }

/* ===== HYBRID SPECIAL SERVICES ===== */
  .hybrid-section{
    background:#F1F3F7;
    padding:56px 32px;
  }

.hybrid-panel{
    background:linear-gradient(150deg, #18263A 0%, #0A0F17 100%);
    border-radius:6px;
    padding:34px 38px 32px;
    position:relative; overflow:hidden;
  }
  .hybrid-panel::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size:40px 40px;
    mask-image:radial-gradient(ellipse 60% 70% at 75% 50%, black, transparent);
    pointer-events:none;
  }
  
  .hybrid-header h2{font-size:21px; color:#fff; letter-spacing:0.4px; text-transform:uppercase;}

.hybrid-content{
    display:grid; grid-template-columns:1.65fr 1fr; gap:24px; align-items:center;
    position:relative;
  }
  .hybrid-grid{
    display:grid; grid-template-columns:repeat(4, 1fr); gap:26px 22px;
  }
  .svc-reason-item{display:flex; gap:11px;}
  .svc-reason-num{
    flex-shrink:0; width:32px; height:32px; border:1.5px solid var(--red); border-radius:4px;
    display:flex; align-items:center; justify-content:center;
    color:var(--red); font-size:16px; font-weight:800;
  }
  .svc-reason-num svg{width:18px; height:18px;}
  .svc-reason-item h4{color:#fff; font-size:16px; letter-spacing:0.2px; margin-bottom:6px; line-height:1.3;}
  .svc-reason-item p{color:var(--muted); font-size:16px; line-height:1.6;}

  .hybrid-illustration{
    position:relative; display:flex; align-items:center; justify-content:center;
    min-height:200px;
  }
  .hybrid-illustration svg{width:100%; height:auto;}

  .hybrid-features-strip{
    background:#EBEEF3; border-radius:6px; margin-top:18px;
    padding:22px 28px;
    display:grid; grid-template-columns:repeat(6, 1fr); gap:18px;
  }
  .hf-item{display:flex; align-items:center; gap:11px;}
  .hf-item svg{flex-shrink:0;}
  .hf-item span{font-size:16px; font-weight:700; color:var(--ink); line-height:1.35;}

  @media (max-width:1100px){
    .hybrid-content{grid-template-columns:1fr;}
  }
  
  @media (max-width:760px){
    .hybrid-section{padding:44px 20px;}
    
  }

/* ===== WHY CHOOSE TAQWA ===== */
  .why-choose-section{
    background:#F8FAFC;
    padding:60px 32px;
  }
  
  .why-choose-content .eyebrow-line{
    font-size:16px; color:var(--ink); font-weight:800; letter-spacing:0.3px;
    text-transform:uppercase; line-height:1.3;
  }
  .why-choose-content h2{
    font-size:24px; letter-spacing:0.3px; margin-bottom:16px; line-height:1.3;
    color:var(--ink);
  }
  
  .why-choose-content p{
    color:#666; font-size:16px; line-height:1.75; margin-bottom:22px; max-width:280px;
  }
  .btn-learn{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--red); color:#fff; font-size:16px; font-weight:800;
    letter-spacing:0.5px; text-transform:uppercase; padding:12px 22px; border-radius:3px;
  }

.wc-card{
    position:relative; border-radius:4px; overflow:hidden;
    aspect-ratio:3/4;
    display:flex; align-items:center; justify-content:center;
  }

@media (max-width:560px){
    .why-choose-section{padding:44px 20px;}
    .why-choose-content h2{font-size:21px;}
  }

  /* ===== FAQ ===== */
  .faq-section{
    background:#F8FAFC;
    padding:64px 32px;
  }
  .faq-inner{max-width:1280px; margin:0 auto;}
  .faq-header{text-align:center; margin-bottom:42px;}
  .faq-header h2{font-size:28px; color:var(--ink); letter-spacing:0.4px;}
  .faq-header h2 .accent{color:var(--red);}

  .faq-grid{
    max-width:820px; margin:0 auto;
  }
  .faq-column{display:flex; flex-direction:column; gap:16px;}
  .faq-column + .faq-column{margin-top:16px;}
  .faq-item{border-radius:2px; overflow:hidden;}
  .faq-question{
    width:100%; display:flex; align-items:center; justify-content:space-between;
    background:#2A3F5C; color:#fff; border:none; text-align:left;
    padding:20px 22px; font-family:inherit;
    font-size:16px; font-weight:800; letter-spacing:0.3px; text-transform:uppercase;
    cursor:pointer;
  }
  .faq-question:hover{background:#354B6A;}
  .faq-question .faq-arrow{position:relative; flex-shrink:0; width:16px; height:16px; margin-left:16px;}
  .faq-question .faq-arrow::before, .faq-question .faq-arrow::after{
    content:""; position:absolute; top:50%; left:50%; background:#fff; border-radius:1px;
    transform:translate(-50%,-50%); transition:transform .25s ease, opacity .25s ease;
  }
  .faq-question .faq-arrow::before{width:14px; height:2px;}
  .faq-question .faq-arrow::after{width:2px; height:14px;}
  .faq-item.open .faq-question .faq-arrow::after{transform:translate(-50%,-50%) rotate(90deg) scale(0); opacity:0;}
  .faq-answer{
    max-height:0; overflow:hidden; background:#EFF2F6;
    transition:max-height .3s ease;
  }
  .faq-item.open .faq-answer{max-height:220px;}
  .faq-answer-inner{padding:22px 24px 26px; color:#5a5a5e; font-size:16px; line-height:1.75;}

  @media (max-width:560px){
    .faq-section{padding:44px 20px;}
    .faq-header h2{font-size:21px;}

}

  /* ===== ABOUT PAGE: PAGE BANNER ===== */
  .page-banner{
    position:relative;
    background:linear-gradient(150deg, #18263A 0%, #0A0F17 100%);
    overflow:hidden;
    padding:68px 32px 58px;
    text-align:center;
  }
  .page-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("img/background-2.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    pointer-events: none;
}
  .page-banner-inner{position:relative; max-width:1280px; margin:0 auto;}
  .page-banner .eyebrow{justify-content:center; display:flex;}
  .page-banner h1{
    font-size:44px; color:#fff; letter-spacing:0.4px; margin-bottom:16px;
  }
  .page-banner h1 .accent{color:var(--red);}
  .breadcrumb{
    display:flex; justify-content:center; align-items:center; gap:10px;
    font-size:16px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px;
    font-weight:700;
  }
  .breadcrumb a{color:var(--off);}
  .breadcrumb a:hover{color:var(--red);}
  .breadcrumb .sep{color:var(--red); font-size:16px;}
  .breadcrumb .current{color:var(--red);}

  @media (max-width:760px){
    .page-banner{padding:44px 20px 40px;}
    .page-banner h1{font-size:30px;}
  }
  @media (max-width:420px){
    .page-banner{padding:36px 16px 32px;}
    .page-banner h1{font-size:25px;}
    .breadcrumb{font-size:16px;}
  }

  /* ===== HYBRID SERVICE PROCESS ===== */
  .hybrid-process-section{background:#F8FAFC; padding:60px 32px;}
  .hybrid-process-inner{max-width:1280px; margin:0 auto;}
  .hybrid-process-header{text-align:center; margin-bottom:42px;}
  .hybrid-process-header h2{font-size:30px; color:var(--ink); letter-spacing:0.4px;}
  .hybrid-process-header h2 .accent{color:var(--red);}
  .hybrid-process-header p{
    color:#666; font-size:16px; max-width:640px; margin:12px auto 0; line-height:1.7;
  }
  .hybrid-process-steps{display:grid; grid-template-columns:repeat(3, 1fr); gap:26px;}
  .hp-item{
    background:#fff; border-radius:6px; padding:28px 24px 24px; position:relative;
    box-shadow:0 14px 34px -20px rgba(0,0,0,0.18);
  }
  .hp-num{
    width:38px; height:38px; border-radius:50%; margin-bottom:16px;
    background:linear-gradient(150deg, var(--red) 0%, var(--red-dark) 100%);
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-weight:800; font-size:16px;
  }
  .hp-item h3{font-size:16px; color:var(--ink); margin-bottom:8px; letter-spacing:0.2px; line-height:1.3;}
  .hp-item p{color:#666; font-size:16px; line-height:1.7;}

  @media (max-width:900px){
    .hybrid-process-steps{grid-template-columns:repeat(2, 1fr);}
  }
  @media (max-width:600px){
    .hybrid-process-section{padding:44px 20px;}
    .hybrid-process-header h2{font-size:24px;}
  }
  @media (max-width:480px){
    .hybrid-process-steps{grid-template-columns:1fr;}
  }

  /* ===== ABOUT PAGE: SERVICES RECAP ===== */
  .services-recap-section{background:#F1F3F7; padding:60px 32px;}
  .services-recap-inner{max-width:1280px; margin:0 auto;}
  .services-recap-header{text-align:center; margin-bottom:42px;}
  .services-recap-header h2{font-size:30px; color:var(--ink); letter-spacing:0.4px;}
  .services-recap-header h2 .accent{color:var(--red);}
  .services-recap-cta{text-align:center; margin-top:40px;}

  @media (max-width:600px){
    .services-recap-section{padding:44px 20px;}
    .services-recap-header h2{font-size:24px;}
  }

  /* ===== ABOUT PAGE: CTA ===== */
  .about-cta-section{
    position:relative; overflow:hidden;
    background:linear-gradient(135deg, #2A3E5A 0%, #121C2A 100%);
    padding:60px 32px; text-align:center;
  }
  .about-cta-section::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:40px 40px;
    mask-image:radial-gradient(ellipse 70% 80% at 50% 40%, black, transparent);
  }
  .about-cta-inner{position:relative; max-width:760px; margin:0 auto;}
  .about-cta-inner h2{color:#fff; font-size:28px; margin-bottom:14px; letter-spacing:0.3px;}
  .about-cta-inner p{color:var(--muted); font-size:16px; margin-bottom:16px; line-height:1.75;}
  .about-cta-address{
    display:flex; align-items:center; justify-content:center; gap:8px;
    color:var(--off); font-size:16px; margin-bottom:28px;
  }
  .about-cta-actions{display:flex; gap:14px; justify-content:center; flex-wrap:wrap;}

  @media (max-width:600px){
    .about-cta-section{padding:44px 20px;}
    .about-cta-inner h2{font-size:22px;}
  }
</style>

<section class="page-banner">
  <div class="page-banner-inner">
    <div class="eyebrow">{service.hero.eyebrow}</div>
    <h1 class="display">{service.hero.heading.pre}<span class="accent">{service.hero.heading.accent}</span></h1>
    <p style="color:var(--off); font-size:16px; line-height:1.75; max-width:620px; margin:0 auto 20px;">{service.hero.intro}</p>
    <div class="breadcrumb">
      <a href="index.html">Home</a>
      <span class="sep">»</span>
      <span class="current">{service.hero.breadcrumbLabel}</span>
    </div>
  </div>
</section>

<section class="hybrid-section" style="padding-top:56px;">
  <div class="hybrid-inner">
    <div class="hybrid-panel">

      <div class="hybrid-header">
        <h2 class="display" style="letter-spacing:0.4px;">{service.overview.heading.pre}<span class="accent">{service.overview.heading.accent}</span></h2>
      </div>

      <div class="hybrid-content">
        <div class="story-content" style="position:relative;">
          {service.overview.paragraphs.map((paragraph, i) => (
            <p style={i === 0 ? "color:var(--muted); margin-bottom:16px;" : "color:var(--muted);"}>{paragraph}</p>
          ))}
        </div>

        <div class="hybrid-illustration">
          <img src={base + service.overview.image} alt={service.overview.imageAlt} style="width:100%; height:auto; border-radius:6px;">
        </div>
      </div>

      <div class="hybrid-grid" style="margin-top:30px; padding-top:28px; border-top:1px solid rgba(255,255,255,0.08); position:relative;">
        {service.overview.reasons.map((reason) => (
          <div class="svc-reason-item">
            <div class="svc-reason-num"><svg viewBox="0 0 24 24" fill="none" set:html={reason.icon} /></div>
            <div>
              <h4>{reason.title}</h4>
              <p>{reason.text}</p>
            </div>
          </div>
        ))}
      </div>

    </div>

    <div class="hybrid-features-strip">
      {service.overview.trustStrip.map((label) => (
        <div class="hf-item">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#F97316"/><path d="M8 12.5l2.5 2.5L16 9" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{label}</span>
        </div>
      ))}
    </div>

