---
// Blog Admin Panel shell. Deliberately isolated from the public site: no
// Header.astro/Footer.astro, and its CSS (src/styles/admin.css) is never
// imported by any public page — so nothing here can collide with or affect
// the public site's design system.
import '../styles/admin.css';

interface Props {
  title: string;
  active?: 'dashboard' | 'new' | 'posts' | 'reviews' | 'categories' | '';
}
const { title, active = '' } = Astro.props;
const isLive = !!Astro.locals.runtime;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{title} · Taqwa Admin</title>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const hamburger = document.getElementById('hamburger');
      const sidebar = document.getElementById('sidebar');
      if (hamburger && sidebar) {
        hamburger.addEventListener('click', function() {
          sidebar.classList.toggle('open');
        });
        document.addEventListener('click', function(e) {
          if (!sidebar.contains(e.target) && !hamburger.contains(e.target)) {
            sidebar.classList.remove('open');
          }
        });
      }
    });
  </script>
</head>
<body>
{isLive ? (
  <div class="shell">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-brand">
          <img src="/img/logo-white.png" alt="Taqwa Automobile" class="brand-logo" />
        </div>
      </div>

      <nav class="sidebar-nav">
        <a href="/admin" class={`nav-link ${active === 'dashboard' ? 'active' : ''}`}>
          <span class="nav-icon">📊</span>
          <span>Dashboard</span>
        </a>
        <a href="/admin/posts/new" class={`nav-link ${active === 'new' ? 'active' : ''}`}>
          <span class="nav-icon">✍️</span>
          <span>New Post</span>
        </a>
      </nav>

      <nav class="sidebar-nav">
        <a href="/admin/posts" class={`nav-link ${active === 'posts' ? 'active' : ''}`}>
          <span class="nav-icon">📝</span>
          <span>Blog Posts</span>
        </a>
        <a href="/admin/reviews" class={`nav-link ${active === 'reviews' ? 'active' : ''}`}>
          <span class="nav-icon">⭐</span>
          <span>Customer Reviews</span>
        </a>
        <a href="/admin/categories" class={`nav-link ${active === 'categories' ? 'active' : ''}`}>
          <span class="nav-icon">🏷️</span>
          <span>Categories</span>
        </a>
      </nav>

      <div class="sidebar-divider"></div>

      <nav class="sidebar-nav">
        <a href="/" target="_blank" rel="noopener" class="nav-link">
          <span class="nav-icon">👁️</span>
          <span>View Website</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <form method="post" action="/api/admin/logout" class="logout-form">
          <button type="submit" class="btn-logout">
            <span class="nav-icon">🚪</span>
            <span>Logout</span>
          </button>
        </form>
      </div>
    </aside>

    <div class="main-wrapper">
      <header class="topbar">
        <div class="topbar-left">
          <button class="hamburger" id="hamburger">
            <span></span>
            <span></span>
            <span></span>
          </button>
          <h1 class="page-title">{title}</h1>
        </div>
        <div class="topbar-right">
          <div class="admin-profile">
            <img src="/img/admin-profile.jpg" alt="Admin" class="admin-avatar" />
            <div class="admin-info">
              <div class="admin-name">Mosharraf Hossen</div>
              <div class="admin-role">Administrator</div>
            </div>
            <form method="post" action="/api/admin/logout" class="logout-btn-topbar">
              <button type="submit" title="Logout">🚪</button>
            </form>
          </div>
        </div>
      </header>

      <main class="content">
        <slot />
      </main>
    </div>
  </div>
) : (
  <div class="notice">
    <h1>Admin panel unavailable here</h1>
    <p>This build has no Cloudflare Worker runtime, so the Blog Admin Panel can't run. It's only available on the live Cloudflare deployment (D1 database + server code aren't reachable from the GitHub Pages or Vercel static builds).</p>
    <p>Open the admin panel at your Cloudflare Workers URL instead, e.g. <code>https://taqwa.&lt;your-account&gt;.workers.dev/admin</code>.</p>
  </div>
)}
</body>
</html>
