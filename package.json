{
  "name": "taqwa-automobile",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build-static.mjs",
    "preview": "astro preview",
    "cf:build": "cross-env CLOUDFLARE_WORKERS=1 astro build",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute taqwa-blog --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute taqwa-blog --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^11.1.0",
    "cross-env": "^7.0.3",
    "wrangler": "^4.0.0"
  }
}
